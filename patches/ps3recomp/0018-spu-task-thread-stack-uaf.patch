From 9c50ed9931d2834caf4b1b08d63b03431b082881 Mon Sep 17 00:00:00 2001
From: soyjxck <soyjxck@users.noreply.github.com>
Date: Sat, 3 Oct 2026 14:25:50 +0100
Subject: [PATCH 1/3] spu: drop a finished POSIX SPU thread's contexts from the
 reserver set

The Win32 SPU thread calls spu_coh_forget_range over its own stack on the
way out; the POSIX one did not. Every SPU context that finished while still
registered as a lock-line reserver then outlived its stack, and the next
coherent store walked into it: spu_coh_notify_write faulted on freed memory
~25 s into Drakengard 3 on macOS, every run. Do the same cleanup, taking the
stack range from pthread_get_stackaddr_np/_stacksize_np (macOS) or
pthread_getattr_np (Linux).
---
 runtime/spu/spu_workload.c | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index 1cdfe48..343d38f 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -803,7 +803,32 @@ static DWORD WINAPI spu_async_thread(LPVOID p) {
     return 0;
 }
 #else
-static void* spu_async_thread(void* p) { spu_async_run((spu_async_job*)p); return NULL; }
+static void* spu_async_thread(void* p)
+{
+    spu_async_run((spu_async_job*)p);
+    /* Nothing on this stack may stay in the lock-line reserver set -- the
+     * same cleanup the Win32 thread does. Without it every SPU context that
+     * finished holding a reservation stayed registered after its stack was
+     * gone, and the next coherent store walked into the freed stack
+     * (spu_coh_notify_write, ~25 s into Drakengard 3 on macOS). */
+    { uintptr_t lo = 0, hi = 0;
+#if defined(__APPLE__)
+      pthread_t self = pthread_self();
+      hi = (uintptr_t)pthread_get_stackaddr_np(self);     /* top of stack */
+      lo = hi - pthread_get_stacksize_np(self);
+#else
+      pthread_attr_t a; void* base; size_t size;
+      if (pthread_getattr_np(pthread_self(), &a) == 0) {
+          if (pthread_attr_getstack(&a, &base, &size) == 0) {
+              lo = (uintptr_t)base; hi = lo + size;
+          }
+          pthread_attr_destroy(&a);
+      }
+#endif
+      extern void spu_coh_forget_range(uintptr_t, uintptr_t);
+      if (hi > lo) spu_coh_forget_range(lo, hi); }
+    return NULL;
+}
 #endif
 
 int spu_workload_dispatch_job(const uint8_t* image, uint32_t image_size,
-- 
2.55.0


From a6cdb1e6978176f87c1bc18665788100c19213cd Mon Sep 17 00:00:00 2001
From: soyjxck <soyjxck@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:31:07 +0100
Subject: [PATCH 2/3] spu_workload: _GNU_SOURCE before the first header (clang
 on Linux)

The SPU lock-line coherence tests compile spu_workload.c standalone, and
clang 16+ makes the implicit declaration of pthread_getattr_np an error
(gcc warned and linked it; both gcc jobs passed in 91445a8's run). glibc
declares it only under _GNU_SOURCE, which the CMake build passes and the
workflow's command lines do not: the file now defines it for itself on
Linux, before any header, as host_posix.c does. macOS takes its own
pthread_get_stackaddr_np path and is unchanged.

With this, 91445a8's run was green on macOS (Debug and Release), Windows
(Debug and Release) and Linux gcc (Debug and Release); Linux (Vulkan)
stays red by the fork's own configure error until upstream's backend is
ported to the fork's shader contract.
---
 runtime/spu/spu_workload.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index 343d38f..c655ad7 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -5,6 +5,12 @@
  * it with the SPURS task ABI. cellSpurs's AddWorkload/CreateTask call
  * spu_workload_dispatch(); the registry is populated by the title's lifted set.
  */
+/* pthread_getattr_np (the stack bounds, below) is a GNU extension that glibc
+ * declares only under _GNU_SOURCE; the CMake build passes it, the standalone
+ * test compiles of the workflows do not. Before any header. */
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE 1
+#endif
 #include "spu_workload.h"
 #include "spu_lifted_job.h"   /* spu_run_lifted_job */
 #include "../ps3_log.h"      /* ps3_log_verbose */
-- 
