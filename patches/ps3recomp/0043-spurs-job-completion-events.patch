From 69ae6d1270bb69daf2cfcdbc67ba66fc38ff8a82 Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Tue, 20 Oct 2026 09:37:59 -0500
Subject: [PATCH] spurs: allow ports to disable synthetic job completion
 broadcasts

Ported from soyjxck/ps3recomp 93dbfddf95b317d2b4aedccc8a0525d2f8c82d86 libs/spurs/cellSpurs.c, MIT. Preserve the legacy default but honor SPURS_JC_DONE_EVENTS=0 for ports whose attached queues implement their own SPU service protocol. A generic fixture proves disabled completions leave bindings intact and enabled/default payloads stay unchanged.
---
 libs/spurs/cellSpurs.c                    |  8 +++
 tools/test_spurs_job_completion_events.py | 70 +++++++++++++++++++++++
 2 files changed, 78 insertions(+)
 create mode 100755 tools/test_spurs_job_completion_events.py

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index d67c594..9487059 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2756,6 +2756,14 @@ static void jc_signal_done(u32 jc_ea, int job_index)
         d3 = g_spurs_job_mbox_intr; (void)d3;
         g_spurs_job_mbox_valid = 0;
     }
+    /* Ported from soyjxck/ps3recomp 93dbfddf, libs/spurs/cellSpurs.c (MIT).
+     * Attached queues can carry a service protocol unrelated to job chains.
+     * A broadcast is a legacy HLE compatibility behavior, not a notification
+     * requested by the application. Allow ports using real SPU events to opt
+     * out without changing the default expected by older integrations.
+     * Read the immutable launch setting here rather than racing a lazy cache. */
+    const char* done_events = getenv("SPURS_JC_DONE_EVENTS");
+    if (done_events && done_events[0] == '0') return;
     for (int i = 0; i < s_spurs_event_queue_n; i++) {
         int rc = sys_event_queue_push_by_id(s_spurs_event_queue[i],
                                             SPURS_EVENT_PORT, jc_ea, d2,
diff --git a/tools/test_spurs_job_completion_events.py b/tools/test_spurs_job_completion_events.py
new file mode 100755
index 0000000..cb06bfc
--- /dev/null
+++ b/tools/test_spurs_job_completion_events.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Ensure compatibility job completions cannot pollute opted-out service queues."""
+import os
+from pathlib import Path
+import platform
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+if os.name == 'nt':
+    print('SKIP: standalone fixture requires a POSIX C toolchain')
+    raise SystemExit(0)
+
+FIXTURE = r'''
+#include "libs/spurs/cellSpurs.c"
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+SPURS_JOB_TLS uint32_t g_spurs_job_mbox, g_spurs_job_mbox_intr, g_spurs_job_cmd;
+SPURS_JOB_TLS int g_spurs_job_mbox_valid;
+static unsigned pushed;
+static uint64_t last_source, last_d1, last_d2, last_d3;
+int sys_event_queue_push_by_id(uint32_t q, uint64_t s, uint64_t d1, uint64_t d2, uint64_t d3) {
+    if (q != 71) abort();
+    pushed++; last_source=s; last_d1=d1; last_d2=d2; last_d3=d3;
+    return 0;
+}
+void sys_event_queue_uncancel_by_id(uint32_t q) { (void)q; }
+static void check(int ok, const char* msg) {
+    if (!ok) { fprintf(stderr,"FAIL: %s\n",msg); exit(1); }
+}
+int main(int argc, char** argv) {
+    check(argc==2,"expected mode");
+    static uint8_t memory[0x1000]; vm_base=memory; ppu_vm_size=sizeof memory;
+    uint8_t* port=(uint8_t*)(uintptr_t)0x100;
+    check(cellSpursAttachLv2EventQueue((CellSpurs*)(uintptr_t)0x1000,71,port,1)==0,"attach service queue");
+    uint32_t p=memory[0x100];
+    check(spurs_port_queue(p)==71,"real SPU event binding exists");
+    g_spurs_job_cmd=0x105; g_spurs_job_mbox=9; g_spurs_job_mbox_valid=1;
+    jc_signal_done(0x2400,2);
+    int enabled=atoi(argv[1]);
+    check(pushed==(unsigned)enabled,"only compatibility-enabled job completions are broadcast");
+    if (enabled) {
+        check(last_source==SPURS_EVENT_PORT && last_d1==0x2400 && last_d2==2 && last_d3==9,
+              "legacy event payload retained");
+    }
+    check(spurs_port_queue(p)==71,"opting out does not detach real SPU notifications");
+    jc_signal_done(0x2400,-1);
+    check(pushed==2u*(unsigned)enabled,"chain-level completion obeys same gate");
+    puts("PASS: job completion compatibility gate and real SPU port binding");
+}
+'''
+
+with tempfile.TemporaryDirectory(prefix='spurs-completion-events-') as name:
+    root = Path(name)
+    src = root / 'fixture.c'
+    src.write_text(FIXTURE)
+    exe = root / 'fixture'
+    linker = ['-Wl,-dead_strip'] if platform.system() == 'Darwin' else ['-Wl,--gc-sections']
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-UNDEBUG',
+                    '-ffunction-sections', '-fdata-sections', '-I' + str(ROOT),
+                    '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'runtime/spu'),
+                    str(src), *linker, '-pthread', '-lm', '-o', str(exe)], check=True)
+    for setting in (None, '0', '1'):
+        env = dict(os.environ)
+        env.pop('SPURS_EVENT_D3', None)
+        env.pop('SPURS_JC_DONE_EVENTS', None)
+        if setting is not None:
+            env['SPURS_JC_DONE_EVENTS'] = setting
+        subprocess.run([str(exe), '0' if setting == '0' else '1'], env=env,
+                       check=True, timeout=10, cwd=root)
-- 
2.55.0

