 }
 
-/* Constants go straight into the shared UBO: vertex at 0, pixel at ps_off.
- * Every operation is waited on, so overwriting per draw is safe. */
+/* Constants are kept here and copied into the batch's constant arena at each
+ * draw (vk_eng_draw), so draws recorded in one batch each keep their own.
+ * Capacities are the shared UBO's: vertex 0..ps_off, pixel the rest. A
+ * draw with none bound reads the first 16 bytes of the last ones bound, as it
+ * did from the shared UBO. */
+static u8* vk_eng_constant_store(u8** p, u32 cap)
+{
+    if (!*p) *p = (u8*)calloc(1, cap > 16u ? cap : 16u);
+    return *p;
+}
 static void vk_eng_bind_vs_constants(void* user, const void* data, u32 bytes)
 {
     (void)user;
-    if (!s_g.on || !data) { s_e2.vs_bytes = 0; return; }
+    if (!s_g.on || !data) { if (s_e2.vs_bytes) s_batch.vs_at = VK_BATCH_NONE; s_e2.vs_bytes = 0; return; }
     const u32 cap = (u32)s_g.ps_off;
     if (bytes > cap) { bytes = cap; if (!(s_e2.warned & 2u)) { VK_LOG("engine: VS constants truncated\n"); s_e2.warned |= 2u; } }
-    memcpy(s_g.ubo.ptr, data, bytes);
+    u8* d = vk_eng_constant_store(&s_e2.vs_data, cap);
+    if (!d) { s_e2.vs_bytes = 0; return; }
+    if (bytes != s_e2.vs_bytes || memcmp(d, data, bytes)) s_batch.vs_at = VK_BATCH_NONE;
+    memcpy(d, data, bytes);
     s_e2.vs_bytes = bytes;
 }
 static void vk_eng_bind_ps_constants(void* user, const void* data, u32 bytes)
 {
     (void)user;
-    if (!s_g.on || !data) { s_e2.ps_bytes = 0; return; }
+    if (!s_g.on || !data) { if (s_e2.ps_bytes) s_batch.ps_at = VK_BATCH_NONE; s_e2.ps_bytes = 0; return; }
     const u32 cap = (u32)(s_g.ubo.size - s_g.ps_off);
     if (bytes > cap) { bytes = cap; if (!(s_e2.warned & 4u)) { VK_LOG("engine: PS constants truncated\n"); s_e2.warned |= 4u; } }
-    memcpy((u8*)s_g.ubo.ptr + s_g.ps_off, data, bytes);
+    u8* d = vk_eng_constant_store(&s_e2.ps_data, cap);
+    if (!d) { s_e2.ps_bytes = 0; return; }
+    if (bytes != s_e2.ps_bytes || memcmp(d, data, bytes)) s_batch.ps_at = VK_BATCH_NONE;
+    memcpy(d, data, bytes);
     s_e2.ps_bytes = bytes;
 }
 static void vk_eng_bind_textures(void* user, const u32* textures,
@@ -2980,16 +3160,6 @@ static VkImageView vk_eng_scratch_depth(u32 w, u32 h)
     return s_e2.scratch_depth.view;
