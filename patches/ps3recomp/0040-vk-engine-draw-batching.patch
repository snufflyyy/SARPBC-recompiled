+    vk_destroy_buffer(&s_batch.ib);
+    vk_destroy_buffer(&s_batch.ubo);
+    vk_geo_release();
+    if (s_batch.pool) pvkDestroyDescriptorPool(s_vk.device, s_batch.pool, NULL);
+    s_batch.pool = VK_NULL_HANDLE;
