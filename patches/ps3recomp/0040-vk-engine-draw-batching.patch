         if (P->variant[t]) pvkDestroyPipeline(s_vk.device, P->variant[t], NULL);
@@ -2858,6 +3016,14 @@ static void vk_eng_bind_pipeline(void* user, u32 pipeline) { (void)user; s_e2.pi
 
 static void vk_eng2_shutdown(void* user)
 {
+    vk_batch_flush();
