     for (u32 i = 1; i <= VK_ENG_MAX_PIPE; i++) vk_eng_pipeline_release(user, i);
     vk_eng_drop_framebuffers();
     for (u32 f = 0; f < VK_ENG_RT_FORMATS; f++)
@@ -2873,24 +3039,38 @@ static void vk_eng2_shutdown(void* user)
