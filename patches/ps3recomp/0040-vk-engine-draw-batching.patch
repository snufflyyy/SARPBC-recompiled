@@ -425,15 +428,135 @@ static int vk_create_image(vk_image* im, VkFormat fmt, u32 w, u32 h,
     return vk_create_image_levels(im, fmt, w, h, 1, usage, aspect);
 }
 
+/* ---------------------------------------------------------------------------
+ * Batched engine draws
+ *
+ * Every engine draw used to end in vk_submit_and_wait: its own command buffer,
+ * submitted and waited on before the next draw could reuse the one vertex
+ * buffer, constant buffer and descriptor set. A UE3 menu frame is hundreds of
+ * draws, so the FIFO thread spent its time in vkWaitForFences, one GPU round
+ * trip per draw (SARPBC 01.09: 15 of 15 stack samples there, ~23 fps on one
+ * core). Now draws record into one open command buffer, each with its own
+ * slice of the vertex, index and constant arenas and its own descriptor set.
+ * The batch is submitted when anything else needs the GPU: vk_begin (uploads,
+ * clears, readbacks, present), a destroy, or the engine's submit_and_wait. So
+ * code outside the batch keeps the old contract: a submission is complete
+ * when it returns. PS3RECOMP_VK_BATCH=0 submits after every draw again.
+ * -------------------------------------------------------------------------*/
+#define VK_BATCH_SETS 512u
+#define VK_BATCH_NONE ((VkDeviceSize)~0ull)
+
+static struct {
+    int              open;      /* s_vk.cmd is recording draws not yet submitted */
+    int              mode;      /* -1 unread, 0 one submit per draw, 1 batch */
+    vk_buffer        vb, ib, ubo;           /* per-batch arenas, filled from 0 */
+    VkDeviceSize     vb_off, ib_off, ubo_off, ubo_align;
+    VkDescriptorPool pool;                  /* per-draw sets, reset per batch */
+    u32              sets;
+    /* Where this batch's last draw put its constants, reused while they are
+     * unchanged (69% of SARPBC's 8 KB vertex-constant binds are). NONE after a
+     * flush or a bind that changed them. */
+    VkDeviceSize     vs_at, ps_at, vs_len_at, ps_len_at;
+    u64              draws, flushes;        /* PS3RECOMP_VK_BATCH_STATS */
+} s_batch = { .mode = -1, .vs_at = VK_BATCH_NONE, .ps_at = VK_BATCH_NONE };
+
+static int vk_submit_and_wait(void);
+static void vk_geo_release(void);
+
+/* PS3RECOMP_VK_DRAW_TIMES=1: GPU time of every batched draw (timestamp pair
+ * around it), summed per pipeline and target size, with the slowest draws,
+ * logged every 1500 batches. It is how the cost of geometry read from host
+ * memory showed up (T040); timestamps serialize nothing, but cost a little. */
+static struct {
+    int on;                         /* -1 unread */
+    VkQueryPool pool;
+    double ns_per_tick;
+    u32 n;                          /* draws stamped in the open batch */
+    struct { u32 pipe, verts, idx, w, h, nrt, topo; } meta[VK_BATCH_SETS];
+    struct { u32 pipe, w, h; u64 ns, n; } agg[256];
+    u64 total_ns, draws, flushes;
+    struct { u64 ns; u32 pipe, verts, idx, w, h; } top[8];
+} s_ts = { .on = -1 };
+
+static void vk_ts_collect(void)
+{
+    if (s_ts.on != 1 || !s_ts.n) { s_ts.n = 0; return; }
+    u64 v[2 * VK_BATCH_SETS];
+    if (pvkGetQueryPoolResults(s_vk.device, s_ts.pool, 0, 2 * s_ts.n, sizeof v, v, sizeof(u64),
+                               VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) == VK_SUCCESS) {
+        for (u32 i = 0; i < s_ts.n; i++) {
+            const u64 ns = (u64)((double)(v[2 * i + 1] - v[2 * i]) * s_ts.ns_per_tick);
+            s_ts.total_ns += ns; s_ts.draws++;
+            int k;
+            for (k = 0; k < 256; k++)
+                if (!s_ts.agg[k].n || (s_ts.agg[k].pipe == s_ts.meta[i].pipe &&
+                                       s_ts.agg[k].w == s_ts.meta[i].w && s_ts.agg[k].h == s_ts.meta[i].h)) break;
+            if (k < 256) { s_ts.agg[k].pipe = s_ts.meta[i].pipe; s_ts.agg[k].w = s_ts.meta[i].w;
+                           s_ts.agg[k].h = s_ts.meta[i].h; s_ts.agg[k].ns += ns; s_ts.agg[k].n++; }
+            int lo = 0;
+            for (int t = 1; t < 8; t++) if (s_ts.top[t].ns < s_ts.top[lo].ns) lo = t;
+            if (ns > s_ts.top[lo].ns) {
+                s_ts.top[lo].ns = ns; s_ts.top[lo].pipe = s_ts.meta[i].pipe; s_ts.top[lo].verts = s_ts.meta[i].verts;
+                s_ts.top[lo].idx = s_ts.meta[i].idx; s_ts.top[lo].w = s_ts.meta[i].w; s_ts.top[lo].h = s_ts.meta[i].h;
+            }
+        }
+    }
+    s_ts.n = 0;
+    if (++s_ts.flushes % 1500u == 0) {
+        VK_LOG("ts: %llu draws, GPU %.1f ms total, %.1f us/draw\n", (unsigned long long)s_ts.draws,
+               (double)s_ts.total_ns / 1e6, s_ts.draws ? (double)s_ts.total_ns / 1e3 / (double)s_ts.draws : 0.0);
+        for (int k = 0; k < 256 && s_ts.agg[k].n; k++)
+            if (s_ts.agg[k].ns > s_ts.total_ns / 50u)
+                VK_LOG("ts:   pipe %u %ux%u: %llu draws, %.1f ms (%.1f us each)\n", s_ts.agg[k].pipe,
+                       s_ts.agg[k].w, s_ts.agg[k].h, (unsigned long long)s_ts.agg[k].n,
+                       (double)s_ts.agg[k].ns / 1e6, (double)s_ts.agg[k].ns / 1e3 / (double)s_ts.agg[k].n);
+        for (int t = 0; t < 8; t++)
+            if (s_ts.top[t].ns)
+                VK_LOG("ts:   slow: %.1f us pipe %u verts %u idx %u %ux%u\n", (double)s_ts.top[t].ns / 1e3,
+                       s_ts.top[t].pipe, s_ts.top[t].verts, s_ts.top[t].idx, s_ts.top[t].w, s_ts.top[t].h);
+        memset(s_ts.agg, 0, sizeof s_ts.agg); memset(s_ts.top, 0, sizeof s_ts.top);
+        s_ts.total_ns = s_ts.draws = 0;
+    }
+}
+
+/* Submit the open batch and wait for it, then recycle its arenas and sets. */
+static int vk_batch_flush(void)
+{
+    if (!s_batch.open) return 0;
+    s_batch.open = 0;
+    const int rc = vk_submit_and_wait();
+    vk_ts_collect();
+    s_batch.vb_off = s_batch.ib_off = s_batch.ubo_off = 0;
+    s_batch.vs_at = s_batch.ps_at = VK_BATCH_NONE;
+    if (s_batch.sets) { pvkResetDescriptorPool(s_vk.device, s_batch.pool, 0); s_batch.sets = 0; }
+    s_batch.flushes++;
+    return rc;
+}
+
 static void vk_destroy_image(vk_image* im)
 {
+    vk_batch_flush();   /* a recorded draw may still use it */
     if (im->view) pvkDestroyImageView(s_vk.device, im->view, NULL);
     if (im->img)  pvkDestroyImage(s_vk.device, im->img, NULL);
     if (im->mem)  pvkFreeMemory(s_vk.device, im->mem, NULL);
     memset(im, 0, sizeof *im);
 }
 
+static int vk_create_host_buffer_ex(vk_buffer* b, VkDeviceSize size, VkBufferUsageFlags usage,
+                                    int prefer_vram);
 static int vk_create_host_buffer(vk_buffer* b, VkDeviceSize size, VkBufferUsageFlags usage)
+{
+    return vk_create_host_buffer_ex(b, size, usage, 0);
+}
+
+/* prefer_vram: a buffer the CPU only writes and the GPU reads every draw.
+ * Take device-local memory the host can map (the 256 MB BAR window most
+ * discrete GPUs expose) when there is one, so the GPU reads it from VRAM
+ * instead of across PCIe on every fetch. Draws reading their vertices,
+ * indices and constants from system memory cost 30-70 us each, and a 7.8k
+ * vertex draw 1.2 ms, on an RTX 2070 SUPER in an x4 slot (SARPBC 01.09). */
+static int vk_create_host_buffer_ex(vk_buffer* b, VkDeviceSize size, VkBufferUsageFlags usage,
+                                    int prefer_vram)
 {
     VkBufferCreateInfo bci = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
                                .size = size, .usage = usage,
@@ -451,7 +574,9 @@ static int vk_create_host_buffer(vk_buffer* b, VkDeviceSize size, VkBufferUsageF
      * invalidate, so a non-coherent one is fine. */
     const VkMemoryPropertyFlags cached = vis | VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
     const int readback = usage == VK_BUFFER_USAGE_TRANSFER_DST_BIT;
-    if (readback && vk_find_memory_type(req.memoryTypeBits, cached | coh, &type) == 0) b->coherent = 1;
+    if (prefer_vram && vk_find_memory_type(req.memoryTypeBits,
+                                           coh | VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &type) == 0) b->coherent = 1;
+    else if (readback && vk_find_memory_type(req.memoryTypeBits, cached | coh, &type) == 0) b->coherent = 1;
     else if (readback && vk_find_memory_type(req.memoryTypeBits, cached, &type) == 0) b->coherent = 0;
     else if (vk_find_memory_type(req.memoryTypeBits, coh, &type) == 0) b->coherent = 1;
     else if (vk_find_memory_type(req.memoryTypeBits, vis, &type) == 0) b->coherent = 0;
@@ -467,6 +592,7 @@ static int vk_create_host_buffer(vk_buffer* b, VkDeviceSize size, VkBufferUsageF
 
 static void vk_destroy_buffer(vk_buffer* b)
 {
+    vk_batch_flush();
     if (b->ptr) pvkUnmapMemory(s_vk.device, b->mem);
     if (b->buf) pvkDestroyBuffer(s_vk.device, b->buf, NULL);
     if (b->mem) pvkFreeMemory(s_vk.device, b->mem, NULL);
@@ -489,6 +615,8 @@ static void vk_invalidate(vk_buffer* b)
  * -------------------------------------------------------------------------*/
 static int vk_begin(void)
 {
+    /* Anything that records its own work runs after the batched draws. */
+    if (s_batch.open && vk_batch_flush()) return -1;
     VK_CHECK(pvkResetCommandBuffer(s_vk.cmd, 0), "vkResetCommandBuffer");
     VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
                                     .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
@@ -496,14 +624,28 @@ static int vk_begin(void)
     return 0;
 }
 
+/* Time spent waiting on the GPU, for PS3RECOMP_VK_BATCH_STATS. */
+static u64 s_vk_wait_ns, s_vk_submits;
+
+static u64 vk_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
+}
+
 static int vk_submit_and_wait(void)
 {
     VK_CHECK(pvkEndCommandBuffer(s_vk.cmd), "vkEndCommandBuffer");
     VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
                         .commandBufferCount = 1, .pCommandBuffers = &s_vk.cmd };
     VK_CHECK(pvkResetFences(s_vk.device, 1, &s_vk.fence), "vkResetFences");
+    const u64 t0 = vk_now_ns();
     VK_CHECK(pvkQueueSubmit(s_vk.queue, 1, &si, s_vk.fence), "vkQueueSubmit");
     VK_CHECK(pvkWaitForFences(s_vk.device, 1, &s_vk.fence, VK_TRUE, UINT64_MAX), "vkWaitForFences");
+    const u64 dt = vk_now_ns() - t0;
+    s_vk_wait_ns += dt;
+    s_vk_submits++;
     return 0;
 }
 
@@ -1855,6 +1997,17 @@ static void vk_cb_present(void* ud, u32 buffer_id)
      * blits the GPU image; the public probe needs just its center texel.
      * Keep the same waits and refresh the probe on every successful present. */
     const int dump = s_vk.dump_path && ((s_vk.presented + 1u) % s_vk.dump_every) == 0;
+    /* The draw engine answers readback_center itself (rsx_draw_engine_readback_center),
+     * so on its path a frame with no dump due reads nothing back and costs no
+     * GPU round trip here (one per frame, ~5 ms through SARPBC's PCIe 2.0 x4). */
+    if (s_vk.eng_active && !dump) {
+        s_vk.presented++;
+        s_g.last_draws = s_g.draws;
+        s_g.draws = 0;
+        vk_present_window();
+        return;
+    }
+
     if (vk_begin()) return;
     vk_barrier_image(s_vk.color.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
     VkBufferImageCopy region = {
@@ -1895,9 +2048,10 @@ static void vk_cb_present(void* ud, u32 buffer_id)
  * PS3RECOMP_RSX_ENGINE=dispatch; only one of the two paths is registered at a
  * time, since the FIFO walker feeds both and would record every draw twice.
  *
- * Every operation is still one synchronous submission, so submit_and_wait has
- * nothing left to do by the time the engine calls it -- which is exactly the
- * contract it asks for (staging is free to reuse on return).
+ * Draws are batched into one command buffer (see "Batched engine draws");
+ * every other operation submits and waits, after the batch, so it is
+ * complete when it returns. submit_and_wait flushes the batch, which is the
+ * contract the engine asks for (staging is free to reuse on return).
  *
  * Stage E1: colour and depth targets, clears, present and readback.
  * Pipelines, draws and textures are the next stages; until then
@@ -2091,7 +2245,8 @@ static void vk_eng_shutdown(void* user)
 
 static void vk_eng_submit_and_wait(void* user, u32 reason)
 {
-    (void)user; (void)reason;      /* every submission has already completed */
+    (void)user; (void)reason;
+    vk_batch_flush();              /* everything else completed as it was submitted */
 }
 
 static u32 vk_eng_color_target_create(void* user, rsx_be_format fmt, u32 w, u32 h,
@@ -2507,6 +2662,7 @@ static struct {
     u32          scratch_w, scratch_h;
     u32          pipeline;
     u32          vs_bytes, ps_bytes;
+    u8          *vs_data, *ps_data;   /* last bound constants; each draw copies its own */
     u32          tex[RSX_BE_MAX_TEXTURES];
     rsx_be_sampler_desc samp[RSX_BE_MAX_TEXTURES];
     u32          tex_mask;
@@ -2533,6 +2689,7 @@ static u32 s_esamp_count;
 
 static void vk_eng_drop_framebuffers(void)
 {
+    vk_batch_flush();
     for (u32 i = 0; i < s_e2.fb_count; i++)
         if (s_e2.fb[i].fb) pvkDestroyFramebuffer(s_vk.device, s_e2.fb[i].fb, NULL);
     s_e2.fb_count = 0;
@@ -2737,6 +2894,7 @@ static void vk_eng_pipeline_release(void* user, u32 pipeline)
 {
     (void)user;
     if (!pipeline || pipeline > VK_ENG_MAX_PIPE || !s_epipe[pipeline - 1].used) return;
+    vk_batch_flush();
