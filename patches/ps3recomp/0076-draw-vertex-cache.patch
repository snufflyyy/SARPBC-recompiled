+/* ---- decoded-vertex cache ------------------------------------------------
+ * The same geometry drawn again must reach the backend byte for byte as the
+ * first time (with the same non-zero geometry ids, so it can skip hashing),
+ * and a change to the guest's vertex bytes must never be served stale. */
+static void test_vertex_cache(void)
+{
+    printf("-- decoded-vertex cache\n");
+    engine_up();
+    u8* v = vm_base + VTX_OFFSET;
+    for (u32 i = 0; i < 12u * 4u; i++) {                    /* 12 distinct float4 vertices */
+        const float f = 1.0f + (float)i;
+        u32 w; memcpy(&w, &f, 4);
+        v[i * 4 + 0] = (u8)(w >> 24); v[i * 4 + 1] = (u8)(w >> 16);
+        v[i * 4 + 2] = (u8)(w >> 8);  v[i * 4 + 3] = (u8)w;
+    }
+    #define STRIP12() do { m(M_BEGIN_END, RSX_PRIMITIVE_TRIANGLE_STRIP); \
+                           m(M_DRAW_ARRAYS, 0u | ((12u - 1u) << 24)); m(M_BEGIN_END, 0u); } while (0)
+    STRIP12();
+    const u32 nd = stub.n_draw;
+    float first_v[16][64]; u32 first_i[24];
+    memcpy(first_v, stub.captured_vertices, sizeof first_v);
+    memcpy(first_i, stub.captured_indices, sizeof first_i);
+    const u32 first_nverts = stub.draw_vertices, first_nidx = stub.draw_indices;
+    CHECK(nd > 0 && first_nverts == 12 && first_nidx == 30, "first draw: %u verts, %u indices", first_nverts, first_nidx);
+    CHECK(stub.hint_vid == 0, "a first sighting carries no geometry id");
+
+    STRIP12();
+    CHECK(stub.n_draw == nd + 1 && stub.draw_vertices == first_nverts && stub.draw_indices == first_nidx,
+          "the repeat draws the same counts");
+    CHECK(!memcmp(first_v, stub.captured_vertices, sizeof first_v) &&
+          !memcmp(first_i, stub.captured_indices, sizeof first_i),
+          "the repeat hands the backend the same vertex and index bytes");
+    CHECK(stub.hint_vid != 0 && stub.hint_iid != 0, "the repeat carries geometry ids (%llu, %llu)",
+          (unsigned long long)stub.hint_vid, (unsigned long long)stub.hint_iid);
+    const u64 vid = stub.hint_vid;
+
+    STRIP12();
+    CHECK(stub.hint_vid == vid, "the same entry keeps its id");
+
+    /* One vertex rewritten in guest memory: the next draw must see it. */
+    v[11 * 16 + 3] ^= 0x40;                                  /* changes vertex 11's x */
+    STRIP12();
+    CHECK(memcmp(first_v[11], stub.captured_vertices[11], sizeof first_v[11]) != 0,
+          "a changed guest vertex is not served from the cache");
+    CHECK(stub.hint_vid != vid, "a changed draw gets a different geometry id");
+    float changed[64]; memcpy(changed, stub.captured_vertices[11], sizeof changed);
+    STRIP12();
+    CHECK(!memcmp(changed, stub.captured_vertices[11], sizeof changed) && stub.hint_vid != 0,
+          "and the new bytes are cached in turn");
+    #undef STRIP12
+    engine_down();
+}
