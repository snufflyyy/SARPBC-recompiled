diff --git a/libs/misc/tests/test_video_export_upload_rec.c b/libs/misc/tests/test_video_export_upload_rec.c
new file mode 100644
index 0000000..29d76b5
--- /dev/null
+++ b/libs/misc/tests/test_video_export_upload_rec.c
@@ -0,0 +1,101 @@
+/* clang -std=gnu17 -I include libs/misc/tests/test_video_export_upload_rec.c
+ *   libs/system/cellSysutil.c -Wl,-dead_strip -pthread -o /tmp/test_video_export_upload_rec
+ * Linux: replace -Wl,-dead_strip with -ffunction-sections -fdata-sections -Wl,--gc-sections
+ *
+ * cellRec, cellVideoExport and cellVideoUpload under their SDK names: each
+ * NID matches the import a shipping title makes (computed below from the
+ * name), and every step answers through the title's callback on the next
+ * sysutil poll. Call shapes follow NPUB30035 01.09 (0x000A07C8..0x000A33E0). */
+#include "../cellGameRecording.c"
+#include "../cellVideoExport.c"
+#include "../cellVideoUpload.c"
+#include "ps3emu/guest_call.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void np_psnr_pump(void) {}
+void cellMsgDialog_tick(void) {}
+
+static struct { u32 opd; u64 a0, a1, a2; } got[16];
+static unsigned n;
+static void callback(u32 opd, u64 a0, u64 a1, u64 a2, u64 a3,
+                     u64 a4, u64 a5, u64 a6, u64 a7)
+{
+    assert(!a3 && !a4 && !a5 && !a6 && !a7 && n < 16);
+    got[n].opd = opd; got[n].a0 = a0; got[n].a1 = a1; got[n].a2 = a2; n++;
+}
+
+/* Poll once; expect exactly `count` new callbacks. */
+static unsigned poll(unsigned count)
+{
+    unsigned before = n;
+    cellSysutilCheckCallback();
+    assert(n == before + count);
+    return before;
+}
+
+int main(void)
+{
+    vm_base = calloc(1, 65536); assert(vm_base);
+    g_ps3_guest_caller = callback;
+    const u32 REC_CB = 0x12013E0, UP_CB = 0x12013E8, EX_CB = 0x12013F0;
+
+    /* ---- cellRec: OPEN, START, STOP, CLOSE; nothing after CLOSE. */
+    const u32 param = 0x100;
+    vm_write32(param + 0, 0x4660); vm_write32(param + 4, 1);
+    vm_write32(param + 8, 1);      vm_write32(param + 12, 0x180);
+    memcpy(vm_base + 0x200, "/dev_hdd0/game/X/USRDIR", 24);
+    assert(cellRecQueryMemSize(0) == (s32)CELL_REC_ERROR_INVALID_VALUE);
+    assert(cellRecQueryMemSize(param) > 0);
+    assert(cellRecStart() == (s32)CELL_REC_ERROR_INVALID_STATE);
+    assert(cellRecOpen(0x200, 0, param, 7, REC_CB, 0) == CELL_OK);
+    assert(cellRecOpen(0x200, 0, param, 7, REC_CB, 0) == (s32)CELL_REC_ERROR_INVALID_STATE);
+    unsigned i = poll(1);
+    assert(got[i].opd == REC_CB && got[i].a0 == CELL_REC_STATUS_OPEN && got[i].a1 == 0);
+    assert(cellRecStart() == CELL_OK);
+    i = poll(1); assert(got[i].a0 == CELL_REC_STATUS_START && got[i].a1 == 0);
+    assert(cellRecStop() == CELL_OK);
+    assert(cellRecStop() == (s32)CELL_REC_ERROR_INVALID_STATE);
+    i = poll(1); assert(got[i].a0 == CELL_REC_STATUS_STOP);
+    assert(cellRecClose(0) == CELL_OK);
+    i = poll(1); assert(got[i].a0 == CELL_REC_STATUS_CLOSE && got[i].a1 == 0);
+    poll(0);
+    assert(cellRecClose(0) == (s32)CELL_REC_ERROR_INVALID_STATE);
+
+    /* ---- cellVideoExport: init OK (userdata 1), export cancelled (2),
+     * finalize OK (3); each through the finish callback. */
+    memcpy(vm_base + 0x300, "VIDEO.MP4", 10);
+    assert(cellVideoExportInitialize2(0, EX_CB, 1) == CELL_OK);
+    i = poll(1); assert(got[i].opd == EX_CB && got[i].a0 == 0 && got[i].a1 == 1);
+    assert(cellVideoExportFromFile(0x200, 0x300, 0x400, EX_CB, 2) == CELL_OK);
+    i = poll(1); assert(got[i].a0 == CELL_VIDEO_EXPORT_UTIL_RET_CANCEL && got[i].a1 == 2);
+    assert(cellVideoExportFromFile(0x200, 0, 0x400, EX_CB, 2) == (s32)CELL_VIDEO_EXPORT_UTIL_ERROR_PARAM);
+    assert(cellVideoExportFinalize(EX_CB, 3) == CELL_OK);
+    i = poll(1); assert(got[i].a0 == 0 && got[i].a1 == 3);
+    /* Re-initializing without a Finalize is allowed. */
+    assert(cellVideoExportInitialize(0, EX_CB, 1) == CELL_OK);
+    assert(cellVideoExportInitialize2(0, EX_CB, 1) == CELL_OK);
+    poll(2);
+
+    /* ---- cellVideoUpload: INITIALIZED/OK, then FINALIZED/CANCEL. */
+    assert(cellVideoUploadInitialize(0, UP_CB, 0) == (s32)CELL_VIDEO_UPLOAD_ERROR_INVALID_VALUE);
+    assert(cellVideoUploadInitialize(0x500, UP_CB, 0x77) == CELL_OK);
+    i = poll(2);
+    assert(got[i].opd == UP_CB && got[i].a0 == CELL_VIDEO_UPLOAD_STATUS_INITIALIZED &&
+           got[i].a1 == 0 && got[i].a2 == 0x77);
+    assert(got[i + 1].a0 == CELL_VIDEO_UPLOAD_STATUS_FINALIZED &&
+           (u32)got[i + 1].a1 == CELL_VIDEO_UPLOAD_ERROR_CANCEL && got[i + 1].a2 == 0x77);
+
+    free(vm_base);
+    puts("cellRec/cellVideoExport/cellVideoUpload: SDK names, every step answered");
+}
