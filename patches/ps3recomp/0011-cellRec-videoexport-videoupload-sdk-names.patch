-#define CELL_VIDEO_EXPORT_ERROR_ALREADY_INITIALIZED 0x80610502
-#define CELL_VIDEO_EXPORT_ERROR_INVALID_ARGUMENT    0x80610503
-#define CELL_VIDEO_EXPORT_ERROR_OUT_OF_MEMORY       0x80610504
