From 2510b1c2b6fdf379236b933c4addd7cbcf32a8a8 Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Mon, 19 Oct 2026 00:05:56 -0500
Subject: [PATCH] cellRec/cellVideoExport/cellVideoUpload: use the SDK function
 names

cellGameRecording.c, cellVideoExport.c and cellVideoUpload.c defined
invented names (cellGameRecordingInit, cellVideoExportInit/Start,
cellVideoUploadInit/Start, ...) whose NIDs match no import, so real
calls fell to the unresolved path (CELL_OK, no callback). They now
define the SDK entry points, NIDs computed from the names and matching
NPUB30035's imports: cellRecOpen/Close/Start/Stop/QueryMemSize,
cellVideoExportInitialize(2)/FromFile(WithCopy)/Finalize,
cellVideoUploadInitialize. Nothing is recorded, exported or uploaded,
but every step answers through the title's callback on the next sysutil
poll: rec OPEN/START/STOP/CLOSE, export init OK / export CANCEL /
finalize OK, upload INITIALIZED then FINALIZED+CANCEL.

Test: libs/misc/tests/test_video_export_upload_rec.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/misc/cellGameRecording.c                 | 114 +++++++++---------
 libs/misc/cellGameRecording.h                 |  73 +++++------
 libs/misc/cellVideoExport.c                   |  91 ++++++++------
 libs/misc/cellVideoExport.h                   |  69 ++++++-----
 libs/misc/cellVideoUpload.c                   |  61 +++-------
 libs/misc/cellVideoUpload.h                   |  56 ++++-----
 .../misc/tests/test_video_export_upload_rec.c | 101 ++++++++++++++++
 7 files changed, 332 insertions(+), 233 deletions(-)
 create mode 100644 libs/misc/tests/test_video_export_upload_rec.c

diff --git a/libs/misc/cellGameRecording.c b/libs/misc/cellGameRecording.c
index d17a74b..c65ed3a 100644
--- a/libs/misc/cellGameRecording.c
+++ b/libs/misc/cellGameRecording.c
@@ -1,85 +1,91 @@
 /*
- * ps3recomp - cellGameRecording HLE implementation
+ * ps3recomp - in-game video recording HLE (cellRec) implementation
  *
- * Stub. Init/end lifecycle works, recording is a silent no-op.
+ * The recorder's state machine runs and answers every step -- OPEN, START,
+ * STOP, CLOSE, each through the title's callback on its next sysutil poll --
+ * but nothing is captured and Close writes no file. Recording is a silent
+ * no-op, as before; what changed is that the calls now resolve under their
+ * SDK names, so a title waiting for START or CLOSE gets it.
+ *
+ * A title that goes on to export or upload the "recorded" file finds nothing
+ * there; cellVideoExport and cellVideoUpload answer those as cancelled.
  */
 
 #include "cellGameRecording.h"
+#include "../system/cellSysutil.h"   /* cellSysutilQueueGuestCallbackArgs */
 #include <stdio.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
-
-/* Internal state */
+#include "../../runtime/ppu/ppu_memory.h"   /* vm_base, vm_read32: guest EA -> host */
 
-static int s_initialized = 0;
+static int s_open = 0;
 static int s_recording = 0;
+static u32 s_cb = 0;        /* guest OPD */
+static u32 s_userdata = 0;
 
-/* API */
-
-s32 cellGameRecordingInit(const CellGameRecordingParam* param)
-{
-    (void)param;
-    printf("[cellGameRecording] Init()\n");
-    if (s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_ALREADY_INITIALIZED;
-    s_initialized = 1;
-    s_recording = 0;
-    return CELL_OK;
-}
-
-s32 cellGameRecordingEnd(void)
+static s32 rec_status(s32 status, s32 error)
 {
-    printf("[cellGameRecording] End()\n");
-    s_initialized = 0;
-    s_recording = 0;
-    return CELL_OK;
+    const u64 args[8] = { (u64)(u32)status, (u64)(u32)error, s_userdata, 0, 0, 0, 0, 0 };
+    return cellSysutilQueueGuestCallbackArgs(s_cb, args);
 }
 
-s32 cellGameRecordingStart(void)
+static const char* rec_str(u32 ea)
 {
-    printf("[cellGameRecording] Start()\n");
-    if (!s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_NOT_INITIALIZED;
-    s_recording = 1;
-    return CELL_OK;
+    return (ea && vm_base) ? (const char*)(vm_base + ea) : "<null>";
 }
 
-s32 cellGameRecordingStop(void)
+/* The memory the title must put in the container it passes to Open. Nothing
+ * is allocated from it here, so this asks for little: 1 MB. */
+s32 cellRecQueryMemSize(u32 param_ea)
 {
-    printf("[cellGameRecording] Stop()\n");
-    if (!s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_NOT_INITIALIZED;
-    s_recording = 0;
-    return CELL_OK;
+    if (!param_ea)
+        return (s32)CELL_REC_ERROR_INVALID_VALUE;
+    printf("[cellRec] QueryMemSize(videoFmt=0x%X audioFmt=0x%X) -> 1 MB\n",
+           vm_read32(param_ea), vm_read32(param_ea + 4));
+    return 0x100000;
 }
 
-s32 cellGameRecordingPause(void)
+s32 cellRecOpen(u32 dirName_ea, u32 fileName_ea, u32 param_ea, u32 container,
+                u32 cb_opd, u32 userdata)
 {
-    if (!s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_NOT_INITIALIZED;
+    printf("[cellRec] Open('%s' / '%s', container=0x%X) -- nothing will be captured\n",
+           rec_str(dirName_ea), rec_str(fileName_ea), container);
+    if (!dirName_ea || !param_ea || !cb_opd)
+        return (s32)CELL_REC_ERROR_INVALID_VALUE;
+    if (s_open)
+        return (s32)CELL_REC_ERROR_INVALID_STATE;
+    s_open = 1;
     s_recording = 0;
-    return CELL_OK;
+    s_cb = cb_opd;
+    s_userdata = userdata;
+    return rec_status(CELL_REC_STATUS_OPEN, CELL_OK);
 }
 
-s32 cellGameRecordingResume(void)
+s32 cellRecStart(void)
 {
-    if (!s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_NOT_INITIALIZED;
+    printf("[cellRec] Start()\n");
+    if (!s_open || s_recording)
+        return (s32)CELL_REC_ERROR_INVALID_STATE;
     s_recording = 1;
-    return CELL_OK;
+    return rec_status(CELL_REC_STATUS_START, CELL_OK);
 }
 
-s32 cellGameRecordingIsRecording(void)
+s32 cellRecStop(void)
 {
-    if (!s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_NOT_INITIALIZED;
-    return s_recording;
+    printf("[cellRec] Stop()\n");
+    if (!s_open || !s_recording)
+        return (s32)CELL_REC_ERROR_INVALID_STATE;
+    s_recording = 0;
+    return rec_status(CELL_REC_STATUS_STOP, CELL_OK);
 }
 
-s32 cellGameRecordingGetDuration(float* duration)
+/* Close ends the session whether or not it was stopped. CLOSE is the last
+ * status: NPUB30035 treats a following UNLOAD as an error, so none is sent. */
+s32 cellRecClose(s32 isDiscard)
 {
-    if (!s_initialized)
-        return (s32)CELL_GAME_REC_ERROR_NOT_INITIALIZED;
-    if (!duration) return (s32)CELL_GAME_REC_ERROR_INVALID_ARGUMENT;
-    vm_write_f32((u32)(uintptr_t)duration, 0.0f); /* No actual recording */
-    return CELL_OK;
+    printf("[cellRec] Close(isDiscard=%d) -- no file written\n", isDiscard);
+    if (!s_open)
+        return (s32)CELL_REC_ERROR_INVALID_STATE;
+    s32 rc = rec_status(CELL_REC_STATUS_CLOSE, CELL_OK);
+    s_open = 0;
+    s_recording = 0;
+    return rc;
 }
diff --git a/libs/misc/cellGameRecording.h b/libs/misc/cellGameRecording.h
index 82b9af2..144e654 100644
--- a/libs/misc/cellGameRecording.h
+++ b/libs/misc/cellGameRecording.h
@@ -1,8 +1,13 @@
 /*
- * ps3recomp - cellGameRecording HLE
+ * ps3recomp - in-game video recording HLE (the SDK's cellRec, libsysutil_rec)
  *
- * In-game video recording. Captures framebuffer output for replay/sharing.
- * Stub — init/end lifecycle, recording is a no-op (no framebuffer capture).
+ * The title opens a recorder (cellRecOpen) for an output file, starts and
+ * stops it around the play it wants captured, and closes it, which writes the
+ * file. Each step answers asynchronously through the callback given to Open.
+ *
+ * The file keeps its old name, but it used to define cellGameRecordingInit/
+ * End/Start/Stop/...: names that exist in no SDK, so their NIDs matched no
+ * import and the real cellRec calls fell through to the unresolved path.
  */
 
 #ifndef PS3RECOMP_CELL_GAME_RECORDING_H
@@ -15,39 +20,35 @@
 extern "C" {
 #endif
 
-/* Error codes */
-#define CELL_GAME_REC_ERROR_NOT_INITIALIZED     0x80610701
-#define CELL_GAME_REC_ERROR_ALREADY_INITIALIZED 0x80610702
-#define CELL_GAME_REC_ERROR_INVALID_ARGUMENT    0x80610703
-#define CELL_GAME_REC_ERROR_OUT_OF_MEMORY       0x80610704
-#define CELL_GAME_REC_ERROR_NOT_SUPPORTED       0x80610705
-#define CELL_GAME_REC_ERROR_BUSY                0x80610706
-
-/* Recording quality */
-#define CELL_GAME_REC_QUALITY_LOW     0
-#define CELL_GAME_REC_QUALITY_MEDIUM  1
-#define CELL_GAME_REC_QUALITY_HIGH    2
-
-/* Recording parameters */
-typedef struct CellGameRecordingParam {
-    u32 quality;
-    u32 maxDuration; /* seconds */
-    u32 width;
-    u32 height;
-    u32 fps;
-    u32 flags;
-    u32 reserved[4];
-} CellGameRecordingParam;
-
-/* Functions */
-s32 cellGameRecordingInit(const CellGameRecordingParam* param);
-s32 cellGameRecordingEnd(void);
-s32 cellGameRecordingStart(void);
-s32 cellGameRecordingStop(void);
-s32 cellGameRecordingPause(void);
-s32 cellGameRecordingResume(void);
-s32 cellGameRecordingIsRecording(void);
-s32 cellGameRecordingGetDuration(float* duration);
+/* Callback status. NPUB30035 01.09's callback (0x000A38DC) maps 2/3/4 to its
+ * own started/stopped/closed states and everything else except 1 to "error". */
+#define CELL_REC_STATUS_UNLOAD 0
+#define CELL_REC_STATUS_OPEN   1
+#define CELL_REC_STATUS_START  2
+#define CELL_REC_STATUS_STOP   3
+#define CELL_REC_STATUS_CLOSE  4
+#define CELL_REC_STATUS_ERR    10
+
+/* Errors (error base 0x8002C500) */
+#define CELL_REC_ERROR_OUT_OF_MEMORY 0x8002C501
+#define CELL_REC_ERROR_FATAL         0x8002C502
+#define CELL_REC_ERROR_INVALID_VALUE 0x8002C503
+#define CELL_REC_ERROR_FILE_OPEN     0x8002C504
+#define CELL_REC_ERROR_FILE_WRITE    0x8002C505
+#define CELL_REC_ERROR_INVALID_STATE 0x8002C506
+#define CELL_REC_ERROR_FILE_NO_DATA  0x8002C507
+
+/* Pointer parameters are GUEST addresses, cb_opd a guest OPD:
+ *
+ *   void cb(int recStatus, int recError, void* userdata);
+ *
+ * CellRecParam: videoFmt @0, audioFmt @4, numOfOpt @8, pOpt @0xC. */
+s32 cellRecQueryMemSize(u32 param_ea);
+s32 cellRecOpen(u32 dirName_ea, u32 fileName_ea, u32 param_ea, u32 container,
+                u32 cb_opd, u32 userdata);
+s32 cellRecStart(void);
+s32 cellRecStop(void);
+s32 cellRecClose(s32 isDiscard);
 
 #ifdef __cplusplus
 }
diff --git a/libs/misc/cellVideoExport.c b/libs/misc/cellVideoExport.c
index d8c5cc5..872caf1 100644
--- a/libs/misc/cellVideoExport.c
+++ b/libs/misc/cellVideoExport.c
@@ -1,62 +1,79 @@
 /*
- * ps3recomp - cellVideoExport HLE implementation
+ * ps3recomp - cellVideoExport (cellVideoExportUtility) HLE implementation
  *
- * Stub. Init/term work, export returns NOT_SUPPORTED.
+ * There is no system video library to export into, so an export comes back
+ * the way it does when the user backs out of the system's export screen:
+ * RET_CANCEL. Initialize and Finalize succeed. Every answer goes through the
+ * title's finish callback on its next sysutil poll -- a title waits for it
+ * (NPUB30035 01.09: Initialize2 / FromFile / Finalize each set a phase number
+ * as userdata and its callback, 0x000A3974, records "phase done" on 0 and
+ * "failed" on anything else).
  */
 
 #include "cellVideoExport.h"
+#include "../system/cellSysutil.h"   /* cellSysutilQueueGuestCallback */
 #include <stdio.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
+#include "../../runtime/ppu/ppu_memory.h"   /* vm_base: guest EA -> host */
 
-/* Internal state */
-
-static int s_initialized = 0;
+static const char* export_str(u32 ea)
+{
+    return (ea && vm_base) ? (const char*)(vm_base + ea) : "<null>";
+}
 
-/* API */
+static s32 finish(u32 opd, s32 result, u32 userdata)
+{
+    return cellSysutilQueueGuestCallback(opd, (u64)(u32)result, userdata);
+}
 
-s32 cellVideoExportInit(void)
+static s32 export_init(int v2, u32 container, u32 funcFinish_opd, u32 userdata)
 {
-    printf("[cellVideoExport] Init()\n");
-    if (s_initialized)
-        return (s32)CELL_VIDEO_EXPORT_ERROR_ALREADY_INITIALIZED;
-    s_initialized = 1;
-    return CELL_OK;
+    printf("[cellVideoExport] Initialize%s(container=0x%X)\n", v2 ? "2" : "", container);
+    if (!funcFinish_opd)
+        return (s32)CELL_VIDEO_EXPORT_UTIL_ERROR_PARAM;
+    /* No "already initialized" refusal: a title that skipped Finalize after a
+     * failed export (NPUB30035 only finalizes after a successful one) must be
+     * able to start again. */
+    return finish(funcFinish_opd, CELL_VIDEO_EXPORT_UTIL_RET_OK, userdata);
 }
 
-s32 cellVideoExportEnd(void)
+s32 cellVideoExportInitialize(u32 container, u32 funcFinish_opd, u32 userdata)
 {
-    printf("[cellVideoExport] End()\n");
-    s_initialized = 0;
-    return CELL_OK;
+    return export_init(0, container, funcFinish_opd, userdata);
 }
 
-s32 cellVideoExportStart(const CellVideoExportParam* param,
-                          CellVideoExportCallback callback, void* userdata)
+s32 cellVideoExportInitialize2(u32 container, u32 funcFinish_opd, u32 userdata)
 {
-    (void)param;
-    printf("[cellVideoExport] Start() - not supported\n");
-    if (!s_initialized)
-        return (s32)CELL_VIDEO_EXPORT_ERROR_NOT_INITIALIZED;
+    return export_init(1, container, funcFinish_opd, userdata);
+}
 
-    /* Immediately call back with NOT_SUPPORTED */
-    if (callback)
-        callback((s32)CELL_VIDEO_EXPORT_ERROR_NOT_SUPPORTED, userdata);
+static s32 export_file(const char* fn, u32 dir_ea, u32 file_ea, u32 param_ea,
+                       u32 funcFinish_opd, u32 userdata)
+{
+    printf("[cellVideoExport] %s('%s' / '%s') -> CANCEL (no video library)\n",
+           fn, export_str(dir_ea), export_str(file_ea));
+    if (!dir_ea || !file_ea || !param_ea || !funcFinish_opd)
+        return (s32)CELL_VIDEO_EXPORT_UTIL_ERROR_PARAM;
+    return finish(funcFinish_opd, CELL_VIDEO_EXPORT_UTIL_RET_CANCEL, userdata);
+}
 
-    return (s32)CELL_VIDEO_EXPORT_ERROR_NOT_SUPPORTED;
+s32 cellVideoExportFromFile(u32 srcHddDir_ea, u32 srcHddFile_ea, u32 param_ea,
+                            u32 funcFinish_opd, u32 userdata)
+{
+    return export_file("FromFile", srcHddDir_ea, srcHddFile_ea, param_ea,
+                       funcFinish_opd, userdata);
 }
 
-s32 cellVideoExportAbort(void)
+s32 cellVideoExportFromFileWithCopy(u32 srcHddDir_ea, u32 srcHddFile_ea, u32 param_ea,
+                                    u32 funcFinish_opd, u32 userdata)
 {
-    if (!s_initialized)
-        return (s32)CELL_VIDEO_EXPORT_ERROR_NOT_INITIALIZED;
-    return CELL_OK;
+    return export_file("FromFileWithCopy", srcHddDir_ea, srcHddFile_ea, param_ea,
+                       funcFinish_opd, userdata);
 }
 
-s32 cellVideoExportGetProgress(float* progress)
+s32 cellVideoExportFinalize(u32 funcFinish_opd, u32 userdata)
 {
-    if (!s_initialized)
-        return (s32)CELL_VIDEO_EXPORT_ERROR_NOT_INITIALIZED;
-    if (!progress) return (s32)CELL_VIDEO_EXPORT_ERROR_INVALID_ARGUMENT;
-    vm_write_f32((u32)(uintptr_t)progress, 0.0f);
-    return CELL_OK;
+    printf("[cellVideoExport] Finalize()\n");
+    if (!funcFinish_opd)
+        return (s32)CELL_VIDEO_EXPORT_UTIL_ERROR_PARAM;
+    return finish(funcFinish_opd, CELL_VIDEO_EXPORT_UTIL_RET_OK, userdata);
 }
