@@ -1,54 +1,27 @@
 /*
  * ps3recomp - cellVideoUpload HLE implementation
  *
- * Stub. Init/term work, upload returns NOT_SUPPORTED.
+ * Offline: the upload dialog opens and the user backs out. The callback gets
+ * INITIALIZED / CELL_OK and then FINALIZED / CELL_VIDEO_UPLOAD_ERROR_CANCEL,
+ * both on the title's next sysutil poll. NPUB30035 01.09's callback
+ * (0x000A3940) marks success only on FINALIZED with error 0 and failure on
+ * any non-zero error, so it sees a clean "not uploaded" either way.
  */
 
 #include "cellVideoUpload.h"
+#include "../system/cellSysutil.h"   /* cellSysutilQueueGuestCallbackArgs */
 #include <stdio.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
 
-/* Internal state */
-
-static int s_initialized = 0;
-
-/* API */
-
-s32 cellVideoUploadInit(void)
-{
-    printf("[cellVideoUpload] Init()\n");
-    if (s_initialized)
-        return (s32)CELL_VIDEO_UPLOAD_ERROR_ALREADY_INITIALIZED;
-    s_initialized = 1;
-    return CELL_OK;
-}
-
-s32 cellVideoUploadTerm(void)
-{
-    printf("[cellVideoUpload] Term()\n");
-    s_initialized = 0;
-    return CELL_OK;
-}
-
-s32 cellVideoUploadStart(const CellVideoUploadParam* param,
-                           CellVideoUploadCallback callback, void* arg)
-{
-    (void)param; (void)callback; (void)arg;
-    printf("[cellVideoUpload] Start() - not supported\n");
-    if (!s_initialized) return (s32)CELL_VIDEO_UPLOAD_ERROR_NOT_INITIALIZED;
-    return (s32)CELL_VIDEO_UPLOAD_ERROR_NOT_SUPPORTED;
-}
-
-s32 cellVideoUploadCancel(void)
-{
-    if (!s_initialized) return (s32)CELL_VIDEO_UPLOAD_ERROR_NOT_INITIALIZED;
-    return CELL_OK;
-}
-
-s32 cellVideoUploadGetStatus(s32* status)
+s32 cellVideoUploadInitialize(u32 param_ea, u32 cb_opd, u32 userdata)
 {
-    if (!s_initialized) return (s32)CELL_VIDEO_UPLOAD_ERROR_NOT_INITIALIZED;
-    if (!status) return (s32)CELL_VIDEO_UPLOAD_ERROR_INVALID_ARGUMENT;
-    vm_write32((u32)(uintptr_t)status, (u32)0); /* idle */
-    return CELL_OK;
+    printf("[cellVideoUpload] Initialize(param=0x%08X) -> CANCEL (offline)\n", param_ea);
+    if (!param_ea || !cb_opd)
+        return (s32)CELL_VIDEO_UPLOAD_ERROR_INVALID_VALUE;
+
+    const u64 init[8] = { CELL_VIDEO_UPLOAD_STATUS_INITIALIZED, CELL_OK, userdata, 0, 0, 0, 0, 0 };
+    const u64 fini[8] = { CELL_VIDEO_UPLOAD_STATUS_FINALIZED,
+                          (u64)(u32)CELL_VIDEO_UPLOAD_ERROR_CANCEL, userdata, 0, 0, 0, 0, 0 };
+    s32 rc = cellSysutilQueueGuestCallbackArgs(cb_opd, init);
+    if (rc != CELL_OK) return rc;
+    return cellSysutilQueueGuestCallbackArgs(cb_opd, fini);
 }
