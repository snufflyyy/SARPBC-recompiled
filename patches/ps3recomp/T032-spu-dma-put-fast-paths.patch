+++ b/tools/test_spu_dma_hotpath.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""MFC DMA hot path: the real spu_dma.h + spu_coherency.c against a byte model.
+
+Builds runtime/spu/tests/bench_spu_dma.c and runs its `check` mode: a seeded
+script of GET/PUT at every size class, GETL/PUTL lists, malformed transfers,
+reservation loss on PUT (first, last and outside lines of the span) and the
+per-context wedged-job detector. The digest pins the exact bytes, so a fast
+path that changes any result fails here. `bench` mode (not run here) prints
+ns per command for before/after comparisons.
+"""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+DIGEST = "a1c01d73f9a48d1e"
+
+
+class SpuDmaHotPathTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cc = shutil.which(os.environ.get("CC", "clang")) or shutil.which("cc")
+        if not cc:
+            raise unittest.SkipTest("C compiler required")
+        if os.name == "nt":
+            raise unittest.SkipTest("POSIX threads and clock_gettime required")
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.tmp.cleanup)
+        cls.exe = Path(cls.tmp.name) / "bench-spu-dma"
+        cmd = [cc, "-pthread", "-std=gnu17", "-O2",
+               "-I", str(ROOT / "include"), "-I", str(ROOT / "runtime/spu"),
+               "-I", str(ROOT / "runtime/platform"),
+               str(ROOT / "runtime/spu/tests/bench_spu_dma.c"),
+               str(ROOT / "runtime/platform/win32_compat.c"), "-o", str(cls.exe)]
+        subprocess.run(cmd, check=True, capture_output=True, text=True)
+
+    def test_matches_model_and_digest(self):
+        env = {k: v for k, v in os.environ.items()
+               if not k.startswith(("SPU_", "YDKJ_", "LBP_"))}
+        p = subprocess.run([str(self.exe), "check"], capture_output=True,
+                           text=True, env=env, timeout=60)
+        self.assertEqual(p.returncode, 0, p.stdout + p.stderr)
+        self.assertIn("OK: dma hot path matches model, digest=" + DIGEST, p.stdout)
+        # Exactly one halt from the detector, after 256 repeats on one context.
+        self.assertEqual(p.stderr.count("identical transfers"), 1, p.stderr)
+        self.assertEqual(p.stderr.count("[mfc] REJECTED malformed transfer"), 3, p.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
