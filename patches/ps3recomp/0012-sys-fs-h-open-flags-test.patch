From 4c1f25414797f7722e3e231dfa7c81a5c91c9096 Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Mon, 19 Oct 2026 00:06:11 -0500
Subject: [PATCH] sys_fs.h: the SDK's octal open flags; test cellFsOpen's flag
 handling

runtime/syscalls/sys_fs.h wrote the SDK's octal open flags as hex (CREAT
0x100, TRUNC 0x200, EXCL 0x400, APPEND 0x2000), so the lv2 sys_fs_open
path saw O_CREAT (0x40) as nothing and O_APPEND (0x400) as O_EXCL. Use the
octal values libs/filesystem/cellFs.h already has.

tools/test_ppu_fs_open_flags.py builds runtime/ppu/tests/test_fs_open_flags.cpp
against ppu_fs.cpp and checks WRONLY|CREAT on a missing file, CREAT|TRUNC
over a longer file, APPEND, a plain WRONLY overwrite, CREAT|EXCL and RDONLY
ENOENT (11 checks; the CREAT, TRUNC and APPEND ones fail before the previous
commit).

SARPBC-recomp (T021), following soyjxck/ps3recomp 6371138.

Rebased onto v0.16.0 (T043): upstream #349 took ppu_fs.cpp's open flag
values but not its O_EXCL mapping, so that line (from the dropped
ppu-fs-open-flags patch, soyjxck's 6371138) now lives here.
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/ppu/ppu_fs.cpp                   |   1 +
 runtime/ppu/tests/test_fs_open_flags.cpp | 151 +++++++++++++++++++++++
 runtime/syscalls/sys_fs.h                |  23 ++--
 tools/test_ppu_fs_open_flags.py          |  79 ++++++++++++
 4 files changed, 245 insertions(+), 9 deletions(-)
 create mode 100644 runtime/ppu/tests/test_fs_open_flags.cpp
 create mode 100755 tools/test_ppu_fs_open_flags.py

diff --git a/runtime/ppu/ppu_fs.cpp b/runtime/ppu/ppu_fs.cpp
index 44cd4ee..5f42b8d 100644
--- a/runtime/ppu/ppu_fs.cpp
+++ b/runtime/ppu/ppu_fs.cpp
@@ -244,6 +244,7 @@ static void cellFsOpen(ppu_context* ctx)
     int oflags = (acc == CELL_FS_O_RDWR)   ? O_RDWR
                : (acc == CELL_FS_O_WRONLY) ? O_WRONLY : O_RDONLY;
     if (flags & CELL_FS_O_CREAT)  oflags |= O_CREAT;
+    if (flags & CELL_FS_O_EXCL)   oflags |= O_EXCL;
     if (flags & CELL_FS_O_TRUNC)  oflags |= O_TRUNC;
     if (flags & CELL_FS_O_APPEND) oflags |= O_APPEND;
 
diff --git a/runtime/ppu/tests/test_fs_open_flags.cpp b/runtime/ppu/tests/test_fs_open_flags.cpp
new file mode 100644
index 0000000..0bad118
--- /dev/null
+++ b/runtime/ppu/tests/test_fs_open_flags.cpp
@@ -0,0 +1,151 @@
+/*
+ * ps3recomp - cellFsOpen's open flags (ppu_fs.cpp) and the lv2 header's.
+ *
+ * The Cell SDK's values are octal: O_CREAT 000100 (0x40), O_EXCL 000200
+ * (0x80), O_TRUNC 001000 (0x200), O_APPEND 002000 (0x400). ppu_fs.cpp had
+ * CREAT 0x200 / TRUNC 0x400 / APPEND 0x100 and runtime/syscalls/sys_fs.h the
+ * octal digits read as hex, so WRONLY|CREAT failed with ENOENT, WRONLY|CREAT|
+ * TRUNC left the old tail of a longer file, and O_APPEND truncated.
+ *
+ * This drives cellFsOpen/Write/Close/Fstat through ppu_fs.cpp on a host
+ * temp directory and checks what each flag combination does to the file, and
+ * that the two headers' constants are the SDK's.
+ *
+ *   tools/test_ppu_fs_open_flags.py
+ *   test_fs_open_flags [DIR]   (DIR: scratch directory; default the temp dir)
+ */
+#include "ppu_fs.cpp"
+
+/* ---- link stubs: nothing on the paths this test drives calls them ---- */
+extern "C" {
+uint8_t* vm_base = nullptr;
+uint32_t ppu_vm_size = 0;
+void vm_write32(uint64_t a, uint32_t v) { uint32_t be = __builtin_bswap32(v); memcpy(vm_base + a, &be, 4); }
+void vm_write64(uint64_t a, uint64_t v) { uint64_t be = __builtin_bswap64(v); memcpy(vm_base + a, &be, 8); }
+void ppu_guest_caller(char* out, size_t n) { if (n) out[0] = 0; }
+void ps3_vfs_ps3game_fallback(char* path, size_t cap) { (void)path; (void)cap; }
+void ydkj_host_bt(const char* tag) { (void)tag; }
+void ps3_hle_register_ctx(uint32_t, const char*, void (*)(ppu_context*)) {}
+}
+ps3_guest_caller_fn g_ps3_guest_caller = nullptr;
+const char* edat_resolve(const char* host_path, char* buf, size_t cap) { (void)buf; (void)cap; return host_path; }
+
+/* The SDK's numbers, spelled in octal as cell/cell_fs.h spells them. */
+static_assert(CELL_FS_O_CREAT  == 000100, "sys_fs.h O_CREAT is the SDK's");
+static_assert(CELL_FS_O_EXCL   == 000200, "sys_fs.h O_EXCL is the SDK's");
+static_assert(CELL_FS_O_TRUNC  == 001000, "sys_fs.h O_TRUNC is the SDK's");
+static_assert(CELL_FS_O_APPEND == 002000, "sys_fs.h O_APPEND is the SDK's");
+
+enum { SDK_WRONLY = 1, SDK_RDWR = 2, SDK_CREAT = 0x40, SDK_EXCL = 0x80,
+       SDK_TRUNC = 0x200, SDK_APPEND = 0x400 };
+
+static uint32_t rd32(uint32_t a) { uint32_t v; memcpy(&v, vm_base + a, 4); return __builtin_bswap32(v); }
+static uint64_t rd64(uint32_t a) { uint64_t v; memcpy(&v, vm_base + a, 8); return __builtin_bswap64(v); }
+
+static int fails = 0;
+#define CHECK(c, ...) do { printf((c) ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); printf("\n"); \
+                           if (!(c)) fails++; } while (0)
+
+static const uint32_t PATH_EA = 0x100, FD_EA = 0x500, DATA_EA = 0x600, NW_EA = 0x700, ST_EA = 0x800;
+
+/* cellFsOpen(path, flags, &fd): returns the CELL error, *fd on success. */
+static uint32_t fs_open(uint32_t flags, uint32_t* fd)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = PATH_EA; ctx.gpr[4] = flags; ctx.gpr[5] = FD_EA;
+    cellFsOpen(&ctx);
+    *fd = rd32(FD_EA);
+    return (uint32_t)ctx.gpr[3];
+}
+static void fs_write(uint32_t fd, const char* s)
+{
+    size_t n = strlen(s);
+    memcpy(vm_base + DATA_EA, s, n);
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = fd; ctx.gpr[4] = DATA_EA; ctx.gpr[5] = n; ctx.gpr[6] = NW_EA;
+    cellFsWrite(&ctx);
+}
+static void fs_close(uint32_t fd)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx); ctx.gpr[3] = fd;
+    cellFsClose(&ctx);
+}
+static uint64_t fs_size(void)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx); ctx.gpr[3] = PATH_EA; ctx.gpr[4] = ST_EA;
+    cellFsStat(&ctx);
+    return (uint32_t)ctx.gpr[3] == 0 ? rd64(ST_EA + 0x24) : ~0ull;
+}
+static void host_put(const char* path, const char* s)
+{
+    FILE* f = fopen(path, "wb"); if (f) { fputs(s, f); fclose(f); }
+}
+static int host_is(const char* path, const char* want)
+{
+    char buf[256] = {0};
+    FILE* f = fopen(path, "rb"); if (!f) return 0;
+    size_t n = fread(buf, 1, sizeof buf - 1, f); fclose(f);
+    return n == strlen(want) && memcmp(buf, want, n) == 0;
+}
+
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    static uint8_t mem[1 << 16];
+    vm_base = mem; ppu_vm_size = sizeof mem;
+
+    const char* dir = argc > 1 ? argv[1] : NULL;
+    if (!dir) dir = getenv("TMPDIR");
+    if (!dir) dir = "/tmp";
+    char host[1100];
+    snprintf(host, sizeof host, "%s/ps3recomp_fs_open_flags.bin", dir);
+    remove(host);
+    ppu_vfs_root = dir;
+    strcpy((char*)mem + PATH_EA, "/dev_hdd1/ps3recomp_fs_open_flags.bin");
+    uint32_t fd, rc;
+
+    /* WRONLY|CREAT on a missing file creates it (was ENOENT). */
+    rc = fs_open(SDK_WRONLY | SDK_CREAT, &fd);
+    CHECK(rc == 0, "WRONLY|CREAT on a missing file opens (0x%08X)", rc);
+    if (rc == 0) { fs_write(fd, "hello"); fs_close(fd); }
+    CHECK(host_is(host, "hello"), "... and the file holds what was written");
+
+    /* WRONLY|CREAT|TRUNC over a longer file truncates it (kept the tail). */
+    host_put(host, "0123456789");
+    rc = fs_open(SDK_WRONLY | SDK_CREAT | SDK_TRUNC, &fd);
+    CHECK(rc == 0, "WRONLY|CREAT|TRUNC opens (0x%08X)", rc);
+    if (rc == 0) { fs_write(fd, "abc"); fs_close(fd); }
+    CHECK(host_is(host, "abc"), "... and the old tail is gone (size %llu)", (unsigned long long)fs_size());
+
+    /* WRONLY|APPEND appends (was a truncate). */
+    host_put(host, "head");
+    rc = fs_open(SDK_WRONLY | SDK_APPEND, &fd);
+    CHECK(rc == 0, "WRONLY|APPEND opens (0x%08X)", rc);
+    if (rc == 0) { fs_write(fd, "+tail"); fs_close(fd); }
+    CHECK(host_is(host, "head+tail"), "... and appends to what was there");
+
+    /* WRONLY without CREAT/TRUNC keeps the file and overwrites in place. */
+    host_put(host, "0123456789");
+    rc = fs_open(SDK_WRONLY, &fd);
+    CHECK(rc == 0, "WRONLY opens an existing file (0x%08X)", rc);
+    if (rc == 0) { fs_write(fd, "ab"); fs_close(fd); }
+    CHECK(host_is(host, "ab23456789"), "... and overwrites in place without truncating");
+
+    /* CREAT|EXCL on an existing file fails; on a missing one it creates. */
+    rc = fs_open(SDK_RDWR | SDK_CREAT | SDK_EXCL, &fd);
+    CHECK(rc != 0, "RDWR|CREAT|EXCL on an existing file fails (0x%08X)", rc);
+    if (rc == 0) fs_close(fd);
+    remove(host);
+    rc = fs_open(SDK_RDWR | SDK_CREAT | SDK_EXCL, &fd);
+    CHECK(rc == 0, "RDWR|CREAT|EXCL on a missing file creates it (0x%08X)", rc);
+    if (rc == 0) fs_close(fd);
+
+    /* Plain RDONLY on a missing file is still ENOENT. */
+    remove(host);
+    rc = fs_open(0, &fd);
+    CHECK(rc == 0x80010006u, "RDONLY on a missing file is CELL_FS_ENOENT (0x%08X)", rc);
+
+    remove(host);
+    printf("%s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
diff --git a/runtime/syscalls/sys_fs.h b/runtime/syscalls/sys_fs.h
index dbe84c4..233d77e 100644
--- a/runtime/syscalls/sys_fs.h
+++ b/runtime/syscalls/sys_fs.h
@@ -65,15 +65,20 @@ extern "C" {
 #define CELL_FS_S_IRGRP   0000040
 #define CELL_FS_S_IROTH   0000004
 
-/* Open flags */
-#define CELL_FS_O_RDONLY   0x000000
-#define CELL_FS_O_WRONLY   0x000001
-#define CELL_FS_O_RDWR     0x000002
-#define CELL_FS_O_ACCMODE  0x000003
-#define CELL_FS_O_CREAT    0x000100
-#define CELL_FS_O_TRUNC    0x000200
-#define CELL_FS_O_EXCL     0x000400
-#define CELL_FS_O_APPEND   0x002000
+/* Open flags. The SDK writes these in octal (cell/cell_fs.h: CREAT 000100,
+ * EXCL 000200, TRUNC 001000, APPEND 002000), as libs/filesystem/cellFs.h
+ * does. They were the octal digits read as hex (CREAT 0x100, TRUNC 0x200,
+ * EXCL 0x400, APPEND 0x2000), so the lv2 sys_fs_open path saw a title's
+ * O_CREAT (0x40) as nothing, its O_TRUNC (0x200) as O_TRUNC by luck, and its
+ * O_APPEND (0x400) as O_EXCL. */
+#define CELL_FS_O_RDONLY   000000
+#define CELL_FS_O_WRONLY   000001
+#define CELL_FS_O_RDWR     000002
+#define CELL_FS_O_ACCMODE  000003
+#define CELL_FS_O_CREAT    000100
+#define CELL_FS_O_EXCL     000200
+#define CELL_FS_O_TRUNC    001000
+#define CELL_FS_O_APPEND   002000
 
 /* Seek modes */
 #define CELL_FS_SEEK_SET   0
diff --git a/tools/test_ppu_fs_open_flags.py b/tools/test_ppu_fs_open_flags.py
new file mode 100755
index 0000000..9118072
--- /dev/null
+++ b/tools/test_ppu_fs_open_flags.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""cellFsOpen's open flags in runtime/ppu/ppu_fs.cpp (and runtime/syscalls/sys_fs.h).
+
+The Cell SDK's O_CREAT/O_EXCL/O_TRUNC/O_APPEND are octal 000100/000200/
+001000/002000 (0x40/0x80/0x200/0x400). ppu_fs.cpp had CREAT 0x200, TRUNC 0x400
+and APPEND 0x100, so WRONLY|CREAT failed with ENOENT, WRONLY|CREAT|TRUNC left
+a longer file's tail in place and O_APPEND truncated; sys_fs.h had the octal
+digits read as hex. This builds runtime/ppu/tests/test_fs_open_flags.cpp
+(which includes ppu_fs.cpp and sys_fs.h) against a ppu_recomp.h made from the
+lifter's own HEADER_PREAMBLE and runs it on a scratch directory.
+
+It needs a host C++ compiler (under CI=1 a missing one fails instead of
+skipping).
+
+Usage:
+    python3 tools/test_ppu_fs_open_flags.py [--exe-out PATH]
+"""
+
+import argparse
+import importlib.util
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+FIXTURE = os.path.join(ROOT, "runtime", "ppu", "tests", "test_fs_open_flags.cpp")
+INCLUDE_DIRS = ["include", "runtime/ppu", "runtime/memory", "runtime", "libs", "."]
+
+
+def _cxx():
+    return (shutil.which(os.environ.get("CXX", "c++")) or shutil.which("g++")
+            or shutil.which("clang++"))
+
+
+def _stub_header():
+    spec = importlib.util.spec_from_file_location(
+        "ppu_lifter", os.path.join(TOOLS, "ppu_lifter.py"))
+    lifter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(lifter)
+    return lifter.HEADER_PREAMBLE
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--exe-out", help="keep the built test program at this path")
+    args = ap.parse_args()
+
+    cxx = _cxx()
+    if cxx is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C++ compiler found")
+            return 1
+        print("skip test_ppu_fs_open_flags: no C++ compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
+        with open(os.path.join(td, "ppu_recomp.h"), "w") as fh:
+            fh.write(_stub_header())
+        exe = args.exe_out or os.path.join(td, "test_fs_open_flags")
+        cmd = [cxx, "-std=gnu++17", "-w", "-I" + td]
+        cmd += ["-I" + os.path.join(ROOT, d) for d in INCLUDE_DIRS]
+        cmd += ["-o", exe, FIXTURE]
+        if "mingw" in os.path.basename(cxx):
+            cmd += ["-static"]
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            print("FAIL: fixture did not build")
+            print((r.stdout + r.stderr)[-4000:])
+            return 1
+        r = subprocess.run([exe, td], capture_output=True, text=True)
+        sys.stdout.write(r.stdout)
+        sys.stderr.write(r.stderr)
+        return r.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
-- 
2.47.3

