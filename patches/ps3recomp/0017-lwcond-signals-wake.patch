From c53c1fac7a6122c1d0fc3eca98e0c0b481b07c6f Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Mon, 19 Oct 2026 09:18:40 -0500
Subject: [PATCH 2/2] tests: sys_lwcond signals wake their waiters

tools/test_ppu_lwcond_wake.py builds runtime/ppu/tests/test_lwcond_wake.cpp
(which includes ppu_sysprx.cpp) with the POSIX win32_compat semaphores and
runs it with PS3_LWCOND_POLL_MS=2000: for signal, signal_all and
signal_to, a waiter must come back from sys_lwcond_wait at most three
times while another thread takes 60 ms to signal, and soon after the
signal; a 5 ms guest timeout still bounds an unsignalled wait; an lwcond
with a foreign id still returns.

On the code before f2cd69a the three hand-offs fail (57 returns from the
wait each: the old 1 ms sleep); after it, 14/14 pass.

Rebased onto v0.16.0 (T043): stubs avconf_register_ctx, which
ppu_sysprx.cpp now calls.
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/ppu/tests/test_lwcond_wake.cpp | 159 +++++++++++++++++++++++++
 tools/test_ppu_lwcond_wake.py          |  90 ++++++++++++++
 2 files changed, 249 insertions(+)
 create mode 100644 runtime/ppu/tests/test_lwcond_wake.cpp
 create mode 100644 tools/test_ppu_lwcond_wake.py

diff --git a/runtime/ppu/tests/test_lwcond_wake.cpp b/runtime/ppu/tests/test_lwcond_wake.cpp
new file mode 100644
index 0000000..76b5255
--- /dev/null
+++ b/runtime/ppu/tests/test_lwcond_wake.cpp
@@ -0,0 +1,159 @@
+/*
+ * ps3recomp - sys_lwcond signals wake their waiters (ppu_sysprx.cpp).
+ *
+ * sys_lwcond_signal/_all/_to used to be no-ops and sys_lwcond_wait a fixed
+ * 1 ms sleep with the lwmutex released, so a waiter came back every
+ * millisecond whether anyone had signalled or not, and a hand-off always cost
+ * at least that. Now a signal wakes the waiter and a wait sleeps until one
+ * arrives, capped by PS3_LWCOND_POLL_MS and the guest's own timeout.
+ *
+ * With the cap raised to 2 s, this checks that:
+ *   - a waiter sleeps until the signal (one or two returns from the wait,
+ *     not one per millisecond) and wakes soon after it;
+ *   - signal_all and signal_to wake it too;
+ *   - the guest's timeout still bounds a wait nobody signals;
+ *   - an lwcond create did not make waits the old way and still returns.
+ *
+ *   tools/test_ppu_lwcond_wake.py
+ */
+#include "ppu_sysprx.cpp"
+
+#include <thread>
+
+/* ---- the guest memory and the link stubs (nothing here calls them) ---- */
+static uint8_t s_mem[0x10000];
+extern "C" {
+uint8_t* vm_base = s_mem;
+uint32_t vm_read32(uint64_t a) { uint32_t v; memcpy(&v, s_mem + a, 4); return __builtin_bswap32(v); }
+uint64_t vm_read64(uint64_t a) { uint64_t v; memcpy(&v, s_mem + a, 8); return __builtin_bswap64(v); }
+void vm_write32(uint64_t a, uint32_t v) { v = __builtin_bswap32(v); memcpy(s_mem + a, &v, 4); }
+void vm_write64(uint64_t a, uint64_t v) { v = __builtin_bswap64(v); memcpy(s_mem + a, &v, 8); }
+volatile long long g_gcm_ref_pub_count = 0;
+uint32_t ppu_hle_inject_base = 0;
+void ps3_hle_register_ctx(uint32_t, const char*, void (*)(ppu_context*)) {}
+unsigned long long ppu_thread_cpu_us(unsigned) { return 0; }
+unsigned ppu_thread_prof_pc(unsigned) { return 0; }
+int64_t sys_ppu_thread_create(ppu_context*) { return 0; }
+int64_t sys_ppu_thread_exit(ppu_context*) { return 0; }
+unsigned int cellGcmSetupContext(unsigned int, unsigned int, unsigned int, unsigned int,
+                                 CellGcmGuestAlloc, CellGcmGuestWrite32) { return 0; }
+void cellGcm_fifo_recycle(unsigned int) {}
+void ppu_register_function(uint64_t, void (*)(ppu_context*)) {}
+void ps3_net_host_register(unsigned int (*)(unsigned int, unsigned int)) {}
+void np_score_register_ctx(void) {}
+void avconf_register_ctx(void) {}
+void cellSaveData_register_ctx_handlers(void) {}
+void spu_raw_note_image(uint32_t, uint32_t) {}
+int ppu_function_registered(uint32_t) { return 0; }
+void prx_export_publish(uint32_t, uint32_t) {}
+uint64_t ppu_guest_call(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t,
+                        uint64_t, uint64_t) { return 0; }
+int32_t prx_runtime_load(const char*) { return -1; }
+prx_rt_module* prx_runtime_get(uint32_t) { return nullptr; }
+int32_t prx_runtime_unload(uint32_t) { return -1; }
+int prx_runtime_eval_leaf(uint32_t, uint32_t, uint64_t, uint64_t, uint64_t*) { return 0; }
+}
+
+static int g_fail;
+#define CHECK(c, ...) do { printf((c) ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); printf("\n"); \
+                           if (!(c)) g_fail++; } while (0)
+
+enum : uint32_t { LWM = 0x100, LWC = 0x200, LWC_FOREIGN = 0x300 };
+
+static double now_ms(void)
+{
+    using namespace std::chrono;
+    return duration<double, std::milli>(steady_clock::now().time_since_epoch()).count();
+}
+
+static void call(void (*fn)(ppu_context*), uint64_t tid, uint64_t r3, uint64_t r4 = 0)
+{
+    ppu_context c;
+    memset(&c, 0, sizeof c);
+    c.thread_id = tid;
+    c.gpr[3] = r3;
+    c.gpr[4] = r4;
+    fn(&c);
+}
+
+/* The waiter holds the lwmutex and waits until `flag` is set; a second thread
+ * sets it under the lwmutex `delay_ms` later and signals with `signal`.
+ * Returns how many times the wait came back. */
+static int handoff(void (*signal)(ppu_context*), int delay_ms, double* waited_ms, double* late_ms)
+{
+    static std::atomic<int> flag;
+    static double t_signal;
+    flag = 0;
+    call(sys_lwmutex_lock, 1, LWM);
+    std::thread t([&] {
+        std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
+        call(sys_lwmutex_lock, 2, LWM);
+        flag = 1;
+        t_signal = now_ms();
+        call(signal, 2, LWC, 2 /* signal_to: the waiter's id; ignored otherwise */);
+        call(sys_lwmutex_unlock, 2, LWM);
+    });
+    const double t0 = now_ms();
+    int returns = 0;
+    while (!flag && returns < 100000) { call(sys_lwcond_wait, 1, LWC, 0); returns++; }
+    const double t1 = now_ms();
+    call(sys_lwmutex_unlock, 1, LWM);
+    t.join();
+    *waited_ms = t1 - t0;
+    *late_ms = t1 - t_signal;
+    return returns;
+}
+
+int main()
+{
+    setenv("PS3_LWCOND_POLL_MS", "2000", 1);   /* read at the first wait */
+    unsetenv("PS3_LWCOND_SLEEP");
+
+    call(sys_lwmutex_create, 1, LWM, 0);
+    call(sys_lwcond_create, 1, LWC, LWM);
+    CHECK(vm_read32(LWC + 0) == LWM, "lwcond +0x00 is its lwmutex");
+    CHECK((vm_read32(LWC + 4) & 0xFF000000u) == 0x4C000000u, "lwcond +0x04 is a created id (0x%08X)", vm_read32(LWC + 4));
+
+    struct { const char* name; void (*fn)(ppu_context*); } sig[] = {
+        { "sys_lwcond_signal",     sys_lwcond_signal },
+        { "sys_lwcond_signal_all", sys_lwcond_signal_all },
+        { "sys_lwcond_signal_to",  sys_lwcond_signal_to },
+    };
+    for (auto& s : sig) {
+        double waited, late;
+        const int n = handoff(s.fn, 60, &waited, &late);
+        /* The old 1 ms sleep came back ~60 times before the flag was set. */
+        CHECK(n <= 3, "%s: the waiter slept until the signal (%d returns from the wait)", s.name, n);
+        CHECK(waited >= 50.0, "%s: ... and not before it (%.1f ms)", s.name, waited);
+        CHECK(late < 500.0, "%s: ... and woke soon after it (%.1f ms after, the poll cap is 2000)", s.name, late);
+    }
+
+    /* Nobody signals: the guest's own timeout (5 ms) bounds the wait. */
+    call(sys_lwmutex_lock, 1, LWM);
+    double t0 = now_ms();
+    call(sys_lwcond_wait, 1, LWC, 5000);
+    double dt = now_ms() - t0;
+    call(sys_lwmutex_unlock, 1, LWM);
+    CHECK(dt < 500.0, "an unsignalled wait with a 5 ms guest timeout returns (%.1f ms)", dt);
+
+    /* The lwmutex is free again after a wait: another thread can take it. */
+    {
+        std::atomic<int> got{0};
+        std::thread t([&] { call(sys_lwmutex_lock, 3, LWM); got = 1; call(sys_lwmutex_unlock, 3, LWM); });
+        t.join();
+        CHECK(got == 1, "the lwmutex is free after the waits");
+    }
+
+    /* An lwcond this module did not create (no 0x4C id) waits the old way. */
+    vm_write32(LWC_FOREIGN + 0, LWM);
+    vm_write32(LWC_FOREIGN + 4, 0x12345678u);
+    call(sys_lwmutex_lock, 1, LWM);
+    t0 = now_ms();
+    call(sys_lwcond_wait, 1, LWC_FOREIGN, 0);
+    dt = now_ms() - t0;
+    call(sys_lwmutex_unlock, 1, LWM);
+    CHECK(dt < 500.0, "a wait on an lwcond with a foreign id still returns (%.1f ms)", dt);
+
+    printf("%s: %d failure(s)\n", g_fail ? "FAIL" : "OK", g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/tools/test_ppu_lwcond_wake.py b/tools/test_ppu_lwcond_wake.py
new file mode 100644
index 0000000..c7e79f8
--- /dev/null
+++ b/tools/test_ppu_lwcond_wake.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""sys_lwcond signals wake their waiters (runtime/ppu/ppu_sysprx.cpp).
+
+sys_lwcond_signal/_all/_to were no-ops and sys_lwcond_wait a fixed 1 ms sleep,
+so every hand-off through an lwcond cost a millisecond and more. This builds
+runtime/ppu/tests/test_lwcond_wake.cpp (which includes ppu_sysprx.cpp) with
+runtime/platform/win32_compat.c (the semaphores behind the lwmutex, off
+Windows) against a ppu_recomp.h made from the lifter's own HEADER_PREAMBLE, and
+runs it: a waiter must sleep until the signal, and wake soon after it.
+
+POSIX only (the fixture links the POSIX win32_compat shims). It needs a host
+C and C++ compiler (under CI=1 a missing one fails instead of skipping).
+
+Usage:
+    python3 tools/test_ppu_lwcond_wake.py [--exe-out PATH]
+"""
+
+import argparse
+import importlib.util
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+FIXTURE = os.path.join(ROOT, "runtime", "ppu", "tests", "test_lwcond_wake.cpp")
+COMPAT = os.path.join(ROOT, "runtime", "platform", "win32_compat.c")
+INCLUDE_DIRS = ["include", "runtime/ppu", "runtime/memory", "runtime", "libs", "."]
+
+
+def _which(*names):
+    for n in names:
+        if n and shutil.which(n):
+            return shutil.which(n)
+    return None
+
+
+def _stub_header():
+    spec = importlib.util.spec_from_file_location(
+        "ppu_lifter", os.path.join(TOOLS, "ppu_lifter.py"))
+    lifter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(lifter)
+    return lifter.HEADER_PREAMBLE
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--exe-out", help="keep the built test program at this path")
+    args = ap.parse_args()
+
+    if os.name == "nt":
+        print("skip test_ppu_lwcond_wake: POSIX only")
+        return 0
+    cxx = _which(os.environ.get("CXX"), "c++", "g++", "clang++")
+    cc = _which(os.environ.get("CC"), "cc", "gcc", "clang")
+    if cxx is None or cc is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C/C++ compiler found")
+            return 1
+        print("skip test_ppu_lwcond_wake: no C/C++ compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
