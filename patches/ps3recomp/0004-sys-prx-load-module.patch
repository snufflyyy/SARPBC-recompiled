From b66f2d8e05b811dd83293e51a513a2b8c47088ee Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Sun, 18 Oct 2026 23:34:55 -0500
Subject: [PATCH] prx: load a title's own PRX modules with sys_prx_load_module

sys_prx_load_module and sys_prx_start_module had no handler, so a title
that ships its own .sprx (SARPBC's SPUJOBS.SPRX, which carries its Edge
Geometry SPURS job binaries) got an unresolved NID and never saw the
module.

runtime/prx/prx_runtime.c loads the module from its file: it finds a
decrypted copy (retail .sprx files are NPDRM SELFs; the copy is looked up
beside the booted ELF or in $PS3_PRX_DIR), places every PT_LOAD in a
main-memory window (0x0C000000 by default, below the runtime's SPU and
TLS scratch, and below 0x10000000 so job binaries inside the module stay
acceptable to the job-chain walker), applies the PT_SCE_PPURELA
relocations, and reads sys_module_info and the export/import tables.

ppu_sysprx.cpp registers load / load_on_memcontainer / start / stop /
unload. module_start and module_stop run as lifted code when the module
was lifted at its load address. Otherwise prx_runtime_eval_leaf evaluates
a straight-line leaf made only of loads, stores and immediates -- the
whole of a data-only module's module_start, which hands back pointers
into its image -- and refuses anything else with a message naming the
instruction. Named-library exports are published to the existing
prx_resolve_export registry only when their code is lifted.

ppu_loader.cpp remembers the booted ELF path and exposes
ppu_function_registered() so the start path can pick lifted code or the
fallback without ppu_guest_call's "not registered" error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/ppu/ppu_loader.cpp                    |  12 +
 runtime/ppu/ppu_sysprx.cpp                    | 146 ++++++
 .../ppu/tests/test_ppu_entry_arguments.cpp    |   2 +
 runtime/prx/prx_loader.c                      |   7 +
 runtime/prx/prx_loader.h                      |   5 +
 runtime/prx/prx_runtime.c                     | 425 ++++++++++++++++++
 runtime/prx/prx_runtime.h                     | 129 ++++++
 7 files changed, 726 insertions(+)
 create mode 100644 runtime/prx/prx_runtime.c
 create mode 100644 runtime/prx/prx_runtime.h

diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 1baea72..b1b08fb 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -2054,6 +2054,11 @@ static ppu_fn ppu_lookup(uint32_t a)
 
 extern "C" uint32_t ppu_function_count(void) { return g_fn_count; }
 
+/* Is there lifted host code at this guest address? Lets a caller choose
+ * between calling guest code and a fallback without ppu_guest_call's "not
+ * registered" error (sys_prx_start_module on a module that was never lifted). */
+extern "C" int ppu_function_registered(uint32_t addr) { return ppu_lookup(addr) != nullptr; }
+
 /* Correct native memmove override for the game's hand-optimized memmove at
  * guest 0x0036FA74. The lifted 1306-instruction version is mis-lifted (flagged
  * elsewhere as writing OPDs byte-swapped); it corrupts bulk copies -- notably a
@@ -3354,8 +3359,15 @@ static uint64_t be64(const uint8_t* p) { return ((uint64_t)be32(p) << 32) | be32
 struct ppu_image_range { uint64_t begin, end; };
 static std::vector<ppu_image_range> g_ppu_image_ranges;
 
+/* runtime/prx/prx_runtime.c: decrypted copies of the title's own PRX files
+ * are looked up beside the executable ELF, so remember where it came from. */
+extern "C" const char* ppu_loaded_elf_path;
+
 extern "C" uint32_t ppu_load_elf(const char* path)
 {
+    { static char s_elf_path[1024];
+      snprintf(s_elf_path, sizeof s_elf_path, "%s", path);
+      ppu_loaded_elf_path = s_elf_path; }
     FILE* f = fopen(path, "rb");
     if (!f) { fprintf(stderr, "[ppu] cannot open %s\n", path); return 0; }
     fseek(f, 0, SEEK_END);
diff --git a/runtime/ppu/ppu_sysprx.cpp b/runtime/ppu/ppu_sysprx.cpp
index 738399e..2bcba4b 100644
--- a/runtime/ppu/ppu_sysprx.cpp
+++ b/runtime/ppu/ppu_sysprx.cpp
@@ -904,6 +904,144 @@ static void sys_spinlock_unlock(ppu_context* ctx)
     _InterlockedExchange(spin_word(ea), 0);
 }
 
+/* ---------------------------------------------------------------------------
+ * sys_prx_* -- the title loading its OWN PRX files at run time.
+ *
+ * runtime/prx/prx_runtime.c places and relocates the module from its file;
+ * this half runs its entry points and publishes its exports. module_start /
+ * module_stop run as lifted code when the module was lifted at the address it
+ * loaded at; otherwise a short leaf entry (the usual shape for a data-only
+ * module whose module_start hands back pointers into its image) is evaluated
+ * by prx_runtime_eval_leaf. Anything else fails loudly instead of pretending
+ * the module started.
+ * -----------------------------------------------------------------------*/
+#include "../prx/prx_runtime.h"
+extern "C" int      ppu_function_registered(uint32_t addr);
+extern "C" void     prx_export_publish(uint32_t nid, uint32_t guest_addr);
+extern "C" uint64_t ppu_guest_call(uint32_t opd, uint64_t a0, uint64_t a1, uint64_t a2,
+                                   uint64_t a3, uint64_t a4, uint64_t a5, uint64_t a6,
+                                   uint64_t a7);
+
+#define PRX_RET(ctx, v) ((ctx)->gpr[3] = (uint64_t)(int64_t)(int32_t)(v))
+
+static void prx_guest_str(uint32_t ea, char* out, size_t cap)
+{
+    size_t i = 0;
+    if (ea) for (; i + 1 < cap && vm_base[ea + i]; i++) out[i] = (char)vm_base[ea + i];
+    out[i] = 0;
+}
+
+/* Run module_start/module_stop(args, argp). Returns 1 and the entry's r3 in
+ * *res, or 0 if there is no way to run it. */
+static int prx_run_entry(const prx_rt_module* m, uint32_t opd, const char* what,
+                         uint64_t args, uint32_t argp, uint64_t* res)
+{
+    uint32_t code = vm_read32(opd), toc = vm_read32(opd + 4);
+    if (ppu_function_registered(code)) {
+        *res = ppu_guest_call(opd, args, argp, 0, 0, 0, 0, 0, 0);
+        fprintf(stderr, "[prx] %s %s: lifted code 0x%08X returned %d\n",
+                m->name, what, code, (int)(int32_t)*res);
+        return 1;
+    }
+    if (prx_runtime_eval_leaf(code, toc, args, argp, res)) {
+        fprintf(stderr, "[prx] %s %s: leaf at 0x%08X evaluated (args=%llu argp=0x%08X) -> %d\n",
+                m->name, what, code, (unsigned long long)args, argp, (int)(int32_t)*res);
+        return 1;
+    }
+    fprintf(stderr, "[prx] %s %s at 0x%08X has no lifted code and is not a simple leaf; "
+                    "lift the module at base 0x%08X (tools/lift_prx.py) to run it\n",
+            m->name, what, code, m->base);
+    return 0;
+}
+
+/* sys_prx_load_module(path, flags, pOpt) -> id */
+static void hle_sys_prx_load_module(ppu_context* ctx)
+{
+    char path[512];
+    prx_guest_str((uint32_t)ctx->gpr[3], path, sizeof path);
+    if (!path[0]) { PRX_RET(ctx, PRX_RT_EFAULT); return; }
+    int32_t id = prx_runtime_load(path);
+    if (id > 0) {
+        /* Named-library exports become resolvable by NID (ppu_hle.cpp asks
+         * prx_resolve_export first). Only functions with host code: an export
+         * pointing at unlifted code would turn an HLE call into a crash. */
+        prx_rt_module* m = prx_runtime_get((uint32_t)id);
+        for (uint32_t i = 0; m && i < m->nexports; i++) {
+            const prx_rt_export* x = &m->exports[i];
+            if (!x->lib_name) continue;               /* module_start/stop/info */
+            if (x->is_func && !ppu_function_registered(vm_read32(x->addr))) {
+                fprintf(stderr, "[prx] %s: export NID 0x%08X has no lifted code -- not published\n",
+                        m->name, x->nid);
+                continue;
+            }
+            prx_export_publish(x->nid, x->addr);
+        }
+    }
+    fprintf(stderr, "[prx] sys_prx_load_module('%s') -> 0x%08X\n", path, (uint32_t)id);
+    PRX_RET(ctx, id);
+}
+
+/* sys_prx_load_module_on_memcontainer(path, mem_ct, flags, pOpt): the
+ * container only decides which budget the memory is charged to. */
+static void hle_sys_prx_load_module_on_memcontainer(ppu_context* ctx)
+{
+    ctx->gpr[4] = ctx->gpr[5];
+    ctx->gpr[5] = ctx->gpr[6];
+    hle_sys_prx_load_module(ctx);
+}
+
+/* sys_prx_start_module(id, args, argp, modres*, flags, pOpt) */
+static void hle_sys_prx_start_module(ppu_context* ctx)
+{
+    uint32_t id = (uint32_t)ctx->gpr[3], argp = (uint32_t)ctx->gpr[5];
+    uint32_t modres = (uint32_t)ctx->gpr[6];
+    prx_rt_module* m = prx_runtime_get(id);
+    if (!m) { PRX_RET(ctx, PRX_RT_ERROR_UNKNOWN_MODULE); return; }
+    if (m->state == PRX_RT_STARTED) { PRX_RET(ctx, PRX_RT_ERROR_ALREADY_STARTED); return; }
+    uint64_t res = 0;
+    if (m->start_opd && !prx_run_entry(m, m->start_opd, "module_start", ctx->gpr[4], argp, &res)) {
+        PRX_RET(ctx, PRX_RT_ERROR_ERROR); return;
+    }
+    if (modres) vm_write32(modres, (uint32_t)res);
+    m->state = PRX_RT_STARTED;
+    /* What module_start handed back is usually the whole point of starting a
+     * data-only module, so show the start of argp. */
+    fprintf(stderr, "[prx] sys_prx_start_module(0x%08X '%s') -> CELL_OK, modres=%d",
+            id, m->name, (int)(int32_t)res);
+    if (argp)
+        fprintf(stderr, ", argp 0x%08X: %08X %08X %08X %08X", argp, vm_read32(argp),
+                vm_read32(argp + 4), vm_read32(argp + 8), vm_read32(argp + 12));
+    fprintf(stderr, "\n");
+    PRX_RET(ctx, 0);
+}
+
+/* sys_prx_stop_module(id, args, argp, modres*, flags, pOpt) */
+static void hle_sys_prx_stop_module(ppu_context* ctx)
+{
+    uint32_t id = (uint32_t)ctx->gpr[3], argp = (uint32_t)ctx->gpr[5];
+    uint32_t modres = (uint32_t)ctx->gpr[6];
+    prx_rt_module* m = prx_runtime_get(id);
+    if (!m) { PRX_RET(ctx, PRX_RT_ERROR_UNKNOWN_MODULE); return; }
+    if (m->state != PRX_RT_STARTED) { PRX_RET(ctx, PRX_RT_ERROR_NOT_STARTED); return; }
+    uint64_t res = 0;
+    if (m->stop_opd && !prx_run_entry(m, m->stop_opd, "module_stop", ctx->gpr[4], argp, &res)) {
+        PRX_RET(ctx, PRX_RT_ERROR_ERROR); return;
+    }
+    if (modres) vm_write32(modres, (uint32_t)res);
+    m->state = PRX_RT_STOPPED;
+    PRX_RET(ctx, 0);
+}
+
+/* sys_prx_unload_module(id, flags, pOpt): only a stopped (or never started)
+ * module may go. */
+static void hle_sys_prx_unload_module(ppu_context* ctx)
+{
+    uint32_t id = (uint32_t)ctx->gpr[3];
+    prx_rt_module* m = prx_runtime_get(id);
+    if (m && m->state == PRX_RT_STARTED) { PRX_RET(ctx, PRX_RT_ERROR_ALREADY_STARTED); return; }
+    PRX_RET(ctx, prx_runtime_unload(id));
+}
+
 extern "C" void ppu_sysprx_register(void)
 {
     ps3_hle_register_ctx(0x15BAE46Bu, "_cellGcmInitBody", hle_cellGcmInitBody);
@@ -987,4 +1125,12 @@ extern "C" void ppu_sysprx_register(void)
     ps3_hle_register_ctx(ps3_compute_nid("sys_mmapper_map_memory"),     "sys_mmapper_map_memory",     crt_ok);
     ps3_hle_register_ctx(ps3_compute_nid("sys_mmapper_unmap_memory"),   "sys_mmapper_unmap_memory",   crt_ok);
     ps3_hle_register_ctx(ps3_compute_nid("sys_mmapper_free_memory"),    "sys_mmapper_free_memory",    crt_ok);
+
+    /* The title's own PRX modules (see the sys_prx_* block above). */
+    ps3_hle_register_ctx(ps3_compute_nid("sys_prx_load_module"),   "sys_prx_load_module",   hle_sys_prx_load_module);
+    ps3_hle_register_ctx(ps3_compute_nid("sys_prx_load_module_on_memcontainer"),
+                         "sys_prx_load_module_on_memcontainer", hle_sys_prx_load_module_on_memcontainer);
+    ps3_hle_register_ctx(ps3_compute_nid("sys_prx_start_module"),  "sys_prx_start_module",  hle_sys_prx_start_module);
+    ps3_hle_register_ctx(ps3_compute_nid("sys_prx_stop_module"),   "sys_prx_stop_module",   hle_sys_prx_stop_module);
+    ps3_hle_register_ctx(ps3_compute_nid("sys_prx_unload_module"), "sys_prx_unload_module", hle_sys_prx_unload_module);
 }
