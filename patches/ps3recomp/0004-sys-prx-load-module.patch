index 2cd75e0..011bc26 100644
--- a/runtime/ppu/tests/test_ppu_entry_arguments.cpp
+++ b/runtime/ppu/tests/test_ppu_entry_arguments.cpp
@@ -10,6 +10,8 @@ uint8_t* vm_base;
 // This loader fixture has no guest threads, SPUs, RSX, or diagnostic watchers.
 // Any attempt to use those subsystems is a test failure, not a success stub.
 uint32_t ppu_hle_inject_base=0x20000000;
+// ppu_load_elf records the booted ELF's path for the PRX loader (prx_runtime.c).
+const char* ppu_loaded_elf_path;
 int spu_coh_is_reserved(uint32_t) { return 0; }
 void spu_coh_notify_write(uint32_t) { std::abort(); }
 void spu_lockline_lock(void) { std::abort(); }
diff --git a/runtime/prx/prx_loader.c b/runtime/prx/prx_loader.c
index 9cc3670..d5947ce 100644
--- a/runtime/prx/prx_loader.c
+++ b/runtime/prx/prx_loader.c
@@ -40,6 +40,13 @@ static void prx_export_register(uint32_t nid, uint32_t guest_addr)
         fprintf(stderr, "[prx] export registry full, dropping NID 0x%08X\n", nid);
 }
 
+/* The same registry for modules the title loads itself at run time
