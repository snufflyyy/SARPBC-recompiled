+}
+
 uint32_t prx_resolve_export(uint32_t nid)
 {
     for (uint32_t i = 0; i < s_export_reg_n; i++)
diff --git a/runtime/prx/prx_loader.h b/runtime/prx/prx_loader.h
index 0c19daa..6d2f488 100644
--- a/runtime/prx/prx_loader.h
+++ b/runtime/prx/prx_loader.h
@@ -111,6 +111,11 @@ uint8_t* prx_image_load_file(const char* path, uint32_t* out_size);
  */
 uint32_t prx_resolve_export(uint32_t nid);
 
+/* Publish one export (NID -> guest address) directly. Used for modules that
+ * the title loads at run time (prx_runtime.h), where the address is only
+ * known once the module has been placed. Last writer wins. */
+void prx_export_publish(uint32_t nid, uint32_t guest_addr);
+
 /* Number of exports currently registered (diagnostics/tests). */
 uint32_t prx_export_registry_count(void);
 
diff --git a/runtime/prx/prx_runtime.c b/runtime/prx/prx_runtime.c
new file mode 100644
index 0000000..8612cc0
--- /dev/null
+++ b/runtime/prx/prx_runtime.c
@@ -0,0 +1,425 @@
+/*
+ * prx_runtime.c -- see prx_runtime.h for the design.
+ *
+ * PRX format notes (SCE PPU PRX, ELF64 big-endian, e_type 0xFFA4):
+ *   - PT_LOAD segments carry base-0 vaddrs; the module may load anywhere.
+ *   - PT_SCE_PPURELA (0x700000A4) holds 24-byte relocations:
+ *       u64 offset; u16 pad; u8 index_value; u8 index_addr; u32 type; u64 addend
+ *     target = seg[index_addr] + offset,
+ *     value  = (index_value == 0xFF ? 0 : seg[index_value]) + addend.
+ *   - The first PT_LOAD's p_paddr is the FILE offset of sys_module_info.
+ * Field layouts are the public SDK's (sys/prx.h); relocation semantics are
+ * the PowerPC64 ELF ABI's.
+ */
+#include "prx_runtime.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+#ifdef _WIN32
+#include <windows.h>
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static void rt_lock(void)   { AcquireSRWLockExclusive(&s_lock); }
+static void rt_unlock(void) { ReleaseSRWLockExclusive(&s_lock); }
+#else
+#include <pthread.h>
+static pthread_mutex_t s_mtx = PTHREAD_MUTEX_INITIALIZER;
+static void rt_lock(void)   { pthread_mutex_lock(&s_mtx); }
+static void rt_unlock(void) { pthread_mutex_unlock(&s_mtx); }
+#endif
+
+extern uint8_t* vm_base;
+extern void sys_fs_translate_path(const char* ps3_path, char* host_path, int host_path_size);
+
+uint32_t    prx_runtime_window_base = 0x0C000000u;
+uint32_t    prx_runtime_window_end  = 0x0D000000u;
+const char* ppu_loaded_elf_path     = NULL;
+
+#define PRX_RT_MAX_MODULES 16
+static prx_rt_module s_mod[PRX_RT_MAX_MODULES];
+static uint32_t      s_bump = 0;
+
+/* ---- big-endian helpers: host buffer and guest memory ------------------- */
+static uint16_t b16(const uint8_t* p) { return (uint16_t)((p[0] << 8) | p[1]); }
+static uint32_t b32(const uint8_t* p)
+{ return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+static uint64_t b64(const uint8_t* p) { return ((uint64_t)b32(p) << 32) | b32(p + 4); }
+
+static uint8_t  g8(uint32_t a)  { return vm_base[a]; }
+static uint16_t g16(uint32_t a) { return b16(vm_base + a); }
+static uint32_t g32(uint32_t a) { return b32(vm_base + a); }
+static uint64_t g64(uint32_t a) { return b64(vm_base + a); }
+static void w16(uint32_t a, uint16_t v) { vm_base[a] = (uint8_t)(v >> 8); vm_base[a + 1] = (uint8_t)v; }
+static void w32(uint32_t a, uint32_t v)
+{ vm_base[a] = (uint8_t)(v >> 24); vm_base[a + 1] = (uint8_t)(v >> 16);
+  vm_base[a + 2] = (uint8_t)(v >> 8); vm_base[a + 3] = (uint8_t)v; }
+static void w64(uint32_t a, uint64_t v) { w32(a, (uint32_t)(v >> 32)); w32(a + 4, (uint32_t)v); }
+
+/* ---- locating a decrypted module ---------------------------------------- */
+static uint8_t* read_file(const char* path, size_t* out_n)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
+    long n = ftell(f);
+    if (n <= 0 || fseek(f, 0, SEEK_SET) != 0) { fclose(f); return NULL; }
+    uint8_t* buf = (uint8_t*)malloc((size_t)n);
+    if (buf && fread(buf, 1, (size_t)n, f) != (size_t)n) { free(buf); buf = NULL; }
+    fclose(f);
+    if (buf && out_n) *out_n = (size_t)n;
+    return buf;
+}
+
+/* A PPU PRX: ELF64, big-endian, PPC64, type 0xFFA4. */
+static int is_prx_elf(const uint8_t* d, size_t n)
+{
+    return n >= 64 && memcmp(d, "\x7F" "ELF", 4) == 0 && d[4] == 2 && d[5] == 2 &&
+           b16(d + 0x10) == 0xFFA4u && b16(d + 0x12) == 21;
+}
+
+static int file_is_prx(const char* path)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    uint8_t h[64];
+    size_t n = fread(h, 1, sizeof h, f);
+    fclose(f);
+    return is_prx_elf(h, n);
+}
+
+static int try_dir(const char* dir, const char* base, char* out, size_t cap)
+{
+    if (!dir || !*dir) return 0;
+    char stem[256], lower[256];
+    snprintf(stem, sizeof stem, "%s", base);
+    char* dot = strrchr(stem, '.');
+    if (dot) *dot = 0;
+    size_t i = 0;
+    for (; stem[i] && i + 1 < sizeof lower; i++) lower[i] = (char)tolower((unsigned char)stem[i]);
+    lower[i] = 0;
+    const char* cand[6][2] = {
+        { stem, ".prx" }, { lower, ".prx" }, { stem, ".PRX" },
+        { stem, ".elf" }, { base, ".elf" }, { base, "" },
+    };
+    for (int k = 0; k < 6; k++) {
+        snprintf(out, cap, "%s/%s%s", dir, cand[k][0], cand[k][1]);
+        if (file_is_prx(out)) return 1;
+    }
+    return 0;
+}
+
+int prx_runtime_find_file(const char* guest_path, char* out, size_t cap)
+{
+    char host[1024];
+    sys_fs_translate_path(guest_path, host, (int)sizeof host);
+    if (file_is_prx(host)) { snprintf(out, cap, "%s", host); return 1; }
+
+    const char* base = strrchr(guest_path, '/');
+    base = base ? base + 1 : guest_path;
+
+    if (try_dir(getenv("PS3_PRX_DIR"), base, out, cap)) return 1;
+    if (ppu_loaded_elf_path) {
+        char dir[1024];
+        snprintf(dir, sizeof dir, "%s", ppu_loaded_elf_path);
+        char* s = strrchr(dir, '/');
+#ifdef _WIN32
+        char* s2 = strrchr(dir, '\\');
+        if (s2 > s) s = s2;
+#endif
+        if (s) { *s = 0; if (try_dir(dir, base, out, cap)) return 1; }
+        else if (try_dir(".", base, out, cap)) return 1;
+    }
+    return 0;
+}
+
+/* ---- relocation --------------------------------------------------------- */
+static int apply_reloc(uint32_t type, uint32_t target, uint64_t value)
+{
+    switch (type) {
+    case 1:  w32(target, (uint32_t)value); return 1;                          /* ADDR32 */
+    case 4:  w16(target, (uint16_t)value); return 1;                          /* ADDR16_LO */
+    case 5:  w16(target, (uint16_t)(value >> 16)); return 1;                  /* ADDR16_HI */
+    case 6:  w16(target, (uint16_t)((value + 0x8000u) >> 16)); return 1;      /* ADDR16_HA */
+    case 10: { uint32_t d = (uint32_t)(value - target);                       /* REL24 */
+               w32(target, (g32(target) & ~0x03FFFFFCu) | (d & 0x03FFFFFCu)); return 1; }
+    case 11: { uint32_t d = (uint32_t)(value - target);                       /* REL14 */
+               w32(target, (g32(target) & ~0x0000FFFCu) | (d & 0x0000FFFCu)); return 1; }
+    case 26: w32(target, (uint32_t)(value - target)); return 1;               /* REL32 */
+    case 38: w64(target, value); return 1;                                    /* ADDR64 */
+    case 44: w64(target, value - target); return 1;                           /* REL64 */
+    case 57: w16(target, (uint16_t)((g16(target) & 3u) | ((uint16_t)value & ~3u))); return 1; /* ADDR16_LO_DS */
+    default: return 0;
+    }
+}
+
+/* ---- module table ------------------------------------------------------- */
+prx_rt_module* prx_runtime_get(uint32_t id)
+{
+    for (int i = 0; i < PRX_RT_MAX_MODULES; i++)
+        if (s_mod[i].in_use && s_mod[i].id == id) return &s_mod[i];
+    return NULL;
+}
+
+prx_rt_module* prx_runtime_find_by_name(const char* name)
+{
+    for (int i = 0; i < PRX_RT_MAX_MODULES; i++)
+        if (s_mod[i].in_use && strcmp(s_mod[i].name, name) == 0) return &s_mod[i];
+    return NULL;
+}
+
+int32_t prx_runtime_unload(uint32_t id)
+{
+    rt_lock();
+    prx_rt_module* m = prx_runtime_get(id);
+    if (m) m->in_use = 0;
+    rt_unlock();
+    return m ? 0 : (int32_t)PRX_RT_ERROR_UNKNOWN_MODULE;
+}
+
+static uint32_t alloc_block(uint32_t size)
+{
+    if (!s_bump) {
+        const char* e = getenv("PS3_PRX_LOAD_BASE");
+        s_bump = (e && *e) ? (uint32_t)strtoul(e, NULL, 16) : prx_runtime_window_base;
+    }
+    uint32_t a = (s_bump + 0xFFFFu) & ~0xFFFFu;   /* 64 KB, the PRX segment granule */
+    if (a + size > prx_runtime_window_end || a + size < a) return 0;
+    s_bump = a + size;
+    return a;
+}
+
+static void guest_cstr(uint32_t a, char* out, size_t cap)
+{
+    size_t i = 0;
+    if (a) for (; i + 1 < cap && vm_base[a + i]; i++) out[i] = (char)vm_base[a + i];
+    out[i] = 0;
+}
+
+/* Walk sys_module_info's export and import tables (already relocated). */
+static void parse_tables(prx_rt_module* m, uint32_t modinfo)
+{
+    guest_cstr(modinfo + 4, m->name, 29);   /* char name[28], maybe unterminated */
+    m->toc = g32(modinfo + 0x20);
+    uint32_t ent = g32(modinfo + 0x24), ent_end = g32(modinfo + 0x28);
+    uint32_t stub = g32(modinfo + 0x2C), stub_end = g32(modinfo + 0x30);
+
+    /* sys_libent: u8 size, u8 -, u16 version, u16 attr, u16 nfunc, u16 nvar,
+     * u16 ntls, u8 hash, u8 hash_tls, u16 -, u32 name, u32 nids, u32 addrs */
+    while (ent && ent < ent_end) {
+        uint8_t sz = g8(ent);
+        if (sz < 0x1C) break;
+        uint32_t nfunc = g16(ent + 6), nvar = g16(ent + 8), ntls = g16(ent + 10);
+        uint32_t lib = g32(ent + 0x10), nids = g32(ent + 0x14), addrs = g32(ent + 0x18);
+        for (uint32_t k = 0; k < nfunc + nvar + ntls; k++) {
+            uint32_t nid = g32(nids + 4 * k), addr = g32(addrs + 4 * k);
+            if (!lib && k < nfunc) {
+                if (nid == 0xBC9A0086u) m->start_opd = addr;   /* module_start */
+                if (nid == 0xAB779874u) m->stop_opd  = addr;   /* module_stop  */
+            }
+            if (m->nexports < PRX_RT_MAX_EXPORTS) {
+                prx_rt_export* x = &m->exports[m->nexports++];
+                x->nid = nid; x->addr = addr; x->is_func = k < nfunc; x->lib_name = lib;
+            }
+        }
+        ent += sz;
+    }
+    /* sys_libstub: u8 size, u8 -, u16 version, u16 attr, u16 nfunc, u16 nvar,
+     * u16 ntls, u32 -, u32 name, ... -- only counted: binding a dynamically
+     * loaded module's imports to HLE is not implemented yet. */
+    while (stub && stub < stub_end) {
+        uint8_t sz = g8(stub);
+        if (sz < 0x1C) break;
+        uint32_t nfunc = g16(stub + 6);
+        char lib[64];
+        guest_cstr(g32(stub + 0x10), lib, sizeof lib);
+        fprintf(stderr, "[prx] %s imports %u function(s) from %s -- NOT bound\n",
+                m->name, nfunc, lib);
+        m->nimport_funcs += nfunc;
+        stub += sz;
+    }
+}
+
+int32_t prx_runtime_load(const char* guest_path)
+{
+    if (!vm_base) return (int32_t)PRX_RT_ERROR_ERROR;
+
+    char host[1024];
+    if (!prx_runtime_find_file(guest_path, host, sizeof host)) {
+        char t[1024];
+        sys_fs_translate_path(guest_path, t, (int)sizeof t);
+        FILE* f = fopen(t, "rb");
+        if (!f) {
+            fprintf(stderr, "[prx] load '%s': no such file (%s)\n", guest_path, t);
+            return (int32_t)PRX_RT_ENOENT;
+        }
+        fclose(f);
+        fprintf(stderr, "[prx] load '%s': %s is not a plain PRX ELF (an encrypted SELF?) and no "
+                        "decrypted copy was found beside the executable ELF or in $PS3_PRX_DIR\n",
+                guest_path, t);
+        return (int32_t)PRX_RT_ERROR_UNSUPPORTED_PRX_TYPE;
+    }
+
+    size_t n = 0;
+    uint8_t* d = read_file(host, &n);
+    if (!d || !is_prx_elf(d, n)) { free(d); return (int32_t)PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE; }
+
+    uint64_t phoff = b64(d + 0x20);
+    uint16_t phentsz = b16(d + 0x36), phnum = b16(d + 0x38);
+    if (phentsz < 0x38 || phoff + (uint64_t)phnum * phentsz > n) {
+        free(d); return (int32_t)PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE;
+    }
+
+    /* Collect PT_LOADs (in order: relocation indices refer to them) and the
+     * relocation segment. */
+    uint64_t lo_off[PRX_RT_MAX_SEGS], lo_va[PRX_RT_MAX_SEGS], lo_fsz[PRX_RT_MAX_SEGS], lo_msz[PRX_RT_MAX_SEGS];
+    uint32_t nseg = 0;
+    uint64_t rela_off = 0, rela_sz = 0, modinfo_foff = 0;
+    for (uint16_t i = 0; i < phnum; i++) {
+        const uint8_t* p = d + phoff + (uint64_t)i * phentsz;
+        uint32_t type = b32(p);
+        if (type == 1) {
+            if (nseg >= PRX_RT_MAX_SEGS) { free(d); return (int32_t)PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE; }
+            if (nseg == 0) modinfo_foff = b64(p + 0x18) - b64(p + 0x08);  /* p_paddr - p_offset */
+            lo_off[nseg] = b64(p + 0x08); lo_va[nseg] = b64(p + 0x10);
+            lo_fsz[nseg] = b64(p + 0x20); lo_msz[nseg] = b64(p + 0x28);
+            if (lo_off[nseg] + lo_fsz[nseg] > n || lo_fsz[nseg] > lo_msz[nseg]) {
+                free(d); return (int32_t)PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE;
+            }
+            nseg++;
+        } else if (type == 0x700000A4u) {
+            rela_off = b64(p + 0x08); rela_sz = b64(p + 0x20);
+        }
+    }
+    if (!nseg || rela_off + rela_sz > n) { free(d); return (int32_t)PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE; }
+
+    /* One block, segments at their base-0 vaddrs: keeps the linked layout. */
+    uint64_t top = 0;
+    for (uint32_t s = 0; s < nseg; s++)
+        if (lo_va[s] + lo_msz[s] > top) top = lo_va[s] + lo_msz[s];
+    if (top > 0x01000000u) { free(d); return (int32_t)PRX_RT_ENOMEM; }
+
+    rt_lock();
+    int slot = -1;
+    for (int i = 0; i < PRX_RT_MAX_MODULES; i++) if (!s_mod[i].in_use) { slot = i; break; }
+    uint32_t base = slot >= 0 ? alloc_block((uint32_t)top) : 0;
+    if (!base) {
+        rt_unlock(); free(d);
+        fprintf(stderr, "[prx] load '%s': out of module slots or window space\n", guest_path);
+        return (int32_t)PRX_RT_ENOMEM;
+    }
+    prx_rt_module* m = &s_mod[slot];
+    memset(m, 0, sizeof *m);
+    m->in_use = 1;
+    m->state  = PRX_RT_LOADED;
+    m->id     = 0x23001000u + (uint32_t)slot * 0x100u + 1u;
+    m->base   = base;
+    m->size   = (uint32_t)top;
+    m->nseg   = nseg;
+    snprintf(m->guest_path, sizeof m->guest_path, "%s", guest_path);
+    snprintf(m->host_path, sizeof m->host_path, "%s", host);
+    rt_unlock();
+
+    memset(vm_base + base, 0, (size_t)top);
+    for (uint32_t s = 0; s < nseg; s++) {
+        m->seg_addr[s] = base + (uint32_t)lo_va[s];
+        m->seg_size[s] = (uint32_t)lo_msz[s];
+        memcpy(vm_base + m->seg_addr[s], d + lo_off[s], (size_t)lo_fsz[s]);
+    }
+
+    uint32_t nrel = 0;
+    for (uint64_t o = rela_off; o + 24 <= rela_off + rela_sz; o += 24) {
+        const uint8_t* r = d + o;
+        uint64_t off = b64(r);
+        uint8_t  iv = r[10], ia = r[11];
+        uint32_t type = b32(r + 12);
+        uint64_t add = b64(r + 16);
+        if (ia >= nseg || (iv != 0xFF && iv >= nseg) || off >= m->seg_size[ia]) {
+            fprintf(stderr, "[prx] %s: relocation #%u out of range (seg %u/%u off 0x%llX)\n",
+                    host, nrel, ia, iv, (unsigned long long)off);
+            prx_runtime_unload(m->id); free(d);
+            return (int32_t)PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE;
+        }
+        uint32_t target = m->seg_addr[ia] + (uint32_t)off;
+        uint64_t value  = (iv == 0xFF ? 0 : m->seg_addr[iv]) + add;
+        if (!apply_reloc(type, target, value)) {
+            fprintf(stderr, "[prx] %s: unsupported relocation type %u at 0x%08X\n", host, type, target);
+            prx_runtime_unload(m->id); free(d);
+            return (int32_t)PRX_RT_ERROR_UNSUPPORTED_RELOCATION;
+        }
+        nrel++;
+    }
+    free(d);
+
+    parse_tables(m, m->seg_addr[0] + (uint32_t)modinfo_foff);
+
+    fprintf(stderr, "[prx] loaded '%s' (%s) id=0x%08X at 0x%08X size 0x%X: %u segment(s), "
+                    "%u relocation(s), toc 0x%08X, %u export(s), start OPD 0x%08X, stop OPD 0x%08X\n",
+            m->name, host, m->id, base, m->size, nseg, nrel, m->toc, m->nexports,
+            m->start_opd, m->stop_opd);
+    for (uint32_t s = 0; s < nseg; s++)
+        fprintf(stderr, "[prx]   segment %u: 0x%08X..0x%08X\n", s, m->seg_addr[s],
+                m->seg_addr[s] + m->seg_size[s]);
+    return (int32_t)m->id;
+}
+
+/* ---- leaf evaluator ----------------------------------------------------- */
+#define LEAF_MAX 64
+
+static int leaf_ok(uint32_t w)
+{
+    uint32_t op = w >> 26, ra = (w >> 16) & 31;
+    switch (op) {
+    case 14: case 15: case 24: case 25: return 1;              /* addi addis ori oris */
+    case 32: case 36: return ra != 0 && ra != 1;               /* lwz stw */
+    case 58: case 62: return (w & 3) == 0 && ra != 0 && ra != 1; /* ld std */
+    case 31: return ((w >> 1) & 0x3FF) == 444 && !(w & 1);     /* or (mr) */
+    default: return 0;
+    }
+}
+
+int prx_runtime_eval_leaf(uint32_t code, uint32_t toc, uint64_t a0, uint64_t a1,
+                          uint64_t* ret)
+{
+    if (!code || !vm_base) return 0;
+    /* Pass 1: the whole body must be supported and end in blr, so a refused
+     * function has written nothing. */
+    int len = -1;
+    for (int i = 0; i < LEAF_MAX; i++) {
+        uint32_t w = g32(code + 4u * (uint32_t)i);
+        if (w == 0x4E800020u) { len = i; break; }
+        if (!leaf_ok(w)) {
+            fprintf(stderr, "[prx] leaf eval: 0x%08X: instruction 0x%08X is not a plain "
+                            "load/store/immediate -- refusing\n", code + 4u * (uint32_t)i, w);
+            return 0;
+        }
+    }
+    if (len < 0) {
+        fprintf(stderr, "[prx] leaf eval: no blr within %d instructions of 0x%08X\n", LEAF_MAX, code);
+        return 0;
+    }
+
+    uint64_t r[32] = { 0 };
+    r[2] = toc; r[3] = a0; r[4] = a1;
+    for (int i = 0; i < len; i++) {
+        uint32_t w = g32(code + 4u * (uint32_t)i);
+        uint32_t op = w >> 26, rt = (w >> 21) & 31, ra = (w >> 16) & 31, rb = (w >> 11) & 31;
+        int64_t  si = (int16_t)(w & 0xFFFF);
+        uint32_t ui = w & 0xFFFF;
+        uint32_t ea = (uint32_t)(r[ra] + (uint64_t)si);
+        switch (op) {
+        case 14: r[rt] = (ra ? r[ra] : 0) + (uint64_t)si; break;
+        case 15: r[rt] = (ra ? r[ra] : 0) + (uint64_t)(si << 16); break;
+        case 24: r[ra] = r[rt] | ui; break;
+        case 25: r[ra] = r[rt] | ((uint64_t)ui << 16); break;
+        case 32: r[rt] = g32(ea); break;
+        case 36: w32(ea, (uint32_t)r[rt]); break;
+        case 58: r[rt] = g64((uint32_t)(r[ra] + (uint64_t)(si & ~3))); break;
+        case 62: w64((uint32_t)(r[ra] + (uint64_t)(si & ~3)), r[rt]); break;
+        case 31: r[ra] = r[rt] | r[rb]; break;
+        }
+    }
+    if (ret) *ret = r[3];
+    return 1;
+}
diff --git a/runtime/prx/prx_runtime.h b/runtime/prx/prx_runtime.h
new file mode 100644
index 0000000..4489866
--- /dev/null
+++ b/runtime/prx/prx_runtime.h
@@ -0,0 +1,129 @@
+/*
+ * prx_runtime.h -- load a title's own PRX at run time (sys_prx_load_module).
+ *
+ * prx_loader.h covers system PRXs that are relocated and lifted OFFLINE and
+ * linked into the executable. This is the other case: the title itself calls
+ * sys_prx_load_module on a module file shipped with the game (a .sprx under
+ * USRDIR), and expects the kernel to place it in its address space, relocate
+ * it, and later run its module_start.
+ *
+ * What this layer does, from the module file alone (no per-title tables):
+ *   - finds a loadable ELF for the guest path. Retail .sprx files are NPDRM
+ *     SELFs that the runtime cannot decrypt, so a decrypted copy is looked up
+ *     (see prx_runtime_find_file);
+ *   - places every PT_LOAD segment in guest main memory, keeping their
+ *     relative layout, and zero-fills bss;
+ *   - applies the PT_SCE_PPURELA relocations;
+ *   - reads sys_module_info and the export/import tables, and records the
+ *     module_start / module_stop descriptors.
+ *
+ * Running module_start/module_stop needs host code for guest PPU code. The
+ * scaffold (ppu_sysprx.cpp) calls a lifted function when one is registered at
+ * the entry address; otherwise prx_runtime_eval_leaf can evaluate a short,
+ * straight-line leaf function made only of loads, stores and immediates --
+ * which is all a data-only module's module_start is (it hands back pointers
+ * into its own image). Anything else is refused, never guessed.
+ */
+#ifndef PS3RECOMP_PRX_RUNTIME_H
+#define PS3RECOMP_PRX_RUNTIME_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Error codes the sys_prx_* calls return (SDK sys/prx.h values). */
+#define PRX_RT_ERROR_ERROR                    0x80011001u
+#define PRX_RT_ERROR_UNKNOWN_MODULE           0x8001112Eu
+#define PRX_RT_ERROR_ALREADY_STARTED          0x80011133u
+#define PRX_RT_ERROR_NOT_STARTED              0x80011134u
+#define PRX_RT_ERROR_ALREADY_STOPPED          0x80011135u
+#define PRX_RT_ERROR_UNSUPPORTED_PRX_TYPE     0x80011148u
+#define PRX_RT_ERROR_UNSUPPORTED_ELF_TYPE     0x80011901u
+#define PRX_RT_ERROR_UNSUPPORTED_RELOCATION   0x80011905u
+#define PRX_RT_ERROR_NO_EXIT_ENTRY            0x80011911u
+#define PRX_RT_ENOENT                         0x80010006u
+#define PRX_RT_ENOMEM                         0x80010004u
+#define PRX_RT_EFAULT                         0x8001000Du
+
+#define PRX_RT_MAX_SEGS     8
+#define PRX_RT_MAX_EXPORTS  64
+
+enum { PRX_RT_LOADED = 1, PRX_RT_STARTED = 2, PRX_RT_STOPPED = 3 };
+
+typedef struct {
+    uint32_t nid;
+    uint32_t addr;      /* relocated guest address: an OPD for a function */
+    uint32_t is_func;
+    uint32_t lib_name;  /* guest address of the library name, 0 = module-level */
+} prx_rt_export;
+
+typedef struct {
+    int      in_use;
+    int      state;            /* PRX_RT_* */
+    uint32_t id;               /* sys_prx_id_t handed to the guest */
+    char     name[32];         /* sys_module_info name */
+    char     guest_path[256];
+    char     host_path[1024];
+    uint32_t base;             /* guest address of the block holding all segments */
+    uint32_t size;             /* size of that block */
+    uint32_t nseg;
+    uint32_t seg_addr[PRX_RT_MAX_SEGS];
+    uint32_t seg_size[PRX_RT_MAX_SEGS];   /* memsz */
+    uint32_t toc;              /* sys_module_info toc */
+    uint32_t start_opd;        /* module_start descriptor, 0 if none */
+    uint32_t stop_opd;         /* module_stop descriptor, 0 if none */
+    uint32_t nexports;
+    prx_rt_export exports[PRX_RT_MAX_EXPORTS];
+    uint32_t nimport_funcs;    /* functions the module imports (not bound) */
+} prx_rt_module;
+
+/* Guest window that loaded modules are placed in. Main memory, because guest
+ * code and the SPURS job walker treat addresses >= 0x10000000 as non-main
+ * (a job binary inside a PRX must stay reachable there). The default
+ * 0x0C000000..0x0D000000 sits below the runtime's own SPU scratch
+ * (0x0D000000) and TLS (0x0E000000) regions. A port whose title owns that
+ * range sets these before the first load; PS3_PRX_LOAD_BASE (hex) also works. */
+extern uint32_t prx_runtime_window_base;
+extern uint32_t prx_runtime_window_end;
+
+/* Host path of the executable ELF the runtime booted (set by ppu_load_elf).
+ * Decrypted module copies are looked for beside it. May be NULL. */
+extern const char* ppu_loaded_elf_path;
+
+/* Find a host file holding a decrypted ELF for `guest_path`, writing it to
+ * `out`. Order: the translated guest path itself if it is already an ELF;
+ * then $PS3_PRX_DIR and the directory of ppu_loaded_elf_path, trying for
+ * "FOO.SPRX": FOO.prx, foo.prx, FOO.PRX, FOO.elf, FOO.SPRX.elf, FOO.SPRX.
+ * Returns 1 when found. */
+int prx_runtime_find_file(const char* guest_path, char* out, size_t cap);
+
+/* Load (place + relocate + parse) the module at guest_path. Returns the new
+ * module id (> 0) or a negative error code as int32. */
+int32_t prx_runtime_load(const char* guest_path);
+
+/* Module by id / by sys_module_info name; NULL if unknown. */
+prx_rt_module* prx_runtime_get(uint32_t id);
+prx_rt_module* prx_runtime_find_by_name(const char* name);
+
+/* Forget a module. Its guest memory is not reused (the window is a bump
+ * allocator), which matches how rarely titles unload. */
+int32_t prx_runtime_unload(uint32_t id);
+
+/* Evaluate a guest leaf function without host code for it. Supported: loads
+ * (lwz, ld), stores (stw, std), addi/li, addis/lis, ori, oris, or (mr), and
+ * the final blr; at most 64 instructions, no branches, and no
+ * access through r1. Registers start as r2 = toc, r3 = a0, r4 = a1, the rest
+ * 0. On success writes r3 to *ret and returns 1; returns 0 (and logs the
+ * offending instruction) if the function is anything else -- nothing is
+ * written to guest memory in that case. */
+int prx_runtime_eval_leaf(uint32_t code, uint32_t toc, uint64_t a0, uint64_t a1,
+                          uint64_t* ret);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_PRX_RUNTIME_H */
-- 
