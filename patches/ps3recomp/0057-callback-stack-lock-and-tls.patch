From e41e424f5cef19bf4e3e3cc31e45fe49ecb09aae Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Wed, 21 Oct 2026 01:48:03 +0000
Subject: [PATCH] ppu: callback stacks carve under the thread-table lock;
 callbacks run with the caller's r13

ppu_stack_carve() in sys_ppu_thread.c takes the lock the thread-stack allocator runs
under, so a carve and a sys_ppu_thread_create cannot hand out the same bytes (it relied
on a 16 MB headroom). A callback inherits the calling guest thread's r13 (its TLS block,
as on the console), and the shared block only on a host thread with no guest context.
test_ppu_guest_call_stacks: r13 inheritance and a carve/allocate race.
---
 runtime/ppu/ppu_loader.cpp                    |  33 +++---
 .../ppu/tests/test_ppu_guest_call_stacks.cpp  | 107 +++++++++++++++++-
 runtime/syscalls/sys_ppu_thread.c             |  26 +++++
 3 files changed, 144 insertions(+), 22 deletions(-)

diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index f39cf23..c785083 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -3699,18 +3699,17 @@ extern "C" void ppu_install_thread_trampoline(void)
  * PPU_CB_STACK_SIZE (bytes, decimal or 0x hex, default 256 KB) sets the size of
  * every callback stack. It is read once, so pooled stacks are interchangeable.
  *
- * Carving stores region_end while sys_ppu_thread_create may read it under its
- * own lock (sys_ppu_thread.c's table lock, not visible here). The store is a
- * single aligned 32-bit word that only ever moves down, and a carve refuses to
- * come within PPU_CB_HEADROOM of next_addr, so a thread stack allocated at the
- * same moment still ends well below the new region_end. */
+ * Carving goes through ppu_stack_carve() (sys_ppu_thread.c), under the same table lock
+ * that sys_ppu_thread_create's allocator holds, and keeps PPU_CB_HEADROOM free above the
+ * thread stacks. */
 #define PPU_CB_STACK_DEFAULT  0x40000u          /* 256 KB */
 #define PPU_CB_MAX_DEPTH      32
 #define PPU_CB_POOL_MAX       512
 #define PPU_CB_HEADROOM       0x01000000u       /* 16 MB kept for thread stacks */
 #define PPU_CB_TOP_PAD        0x100u            /* the callee stores LR/CR/params above r1 */
 
-extern "C" vm_stack_alloc g_vm_stack_alloc;     /* syscalls/sys_ppu_thread.c */
+extern "C" uint32_t ppu_stack_carve(uint32_t total, uint32_t headroom, uint32_t ceiling,
+                                    uint32_t* thread_end, uint32_t* region_end);   /* syscalls/sys_ppu_thread.c */
 
 static std::mutex s_cb_mu;
 static uint32_t   s_cb_pool[PPU_CB_POOL_MAX];   /* stack bases (lowest usable byte) */
@@ -3739,20 +3738,17 @@ static uint32_t ppu_cb_stack_take(void)
     if (s_cb_pool_n) return s_cb_pool[--s_cb_pool_n];
 
     const uint32_t size = ppu_cb_stack_size(), pg = vm_host_page_size();
-    vm_stack_alloc* sa = &g_vm_stack_alloc;
-    if (!sa->region_end) vm_stack_alloc_init(sa);   /* a host that never ran sys_ppu_thread_init */
-    uint32_t end = sa->region_end;
-    /* A second vm_stack_alloc_init() (a host test harness does one) puts
-     * region_end back at the top, over stacks already handed out: carve below. */
-    if (s_cb_floor && end > s_cb_floor) end = s_cb_floor;
     const uint32_t total = size + pg;
-    if (end < sa->next_addr || end - sa->next_addr < total + PPU_CB_HEADROOM) {
+    uint32_t thread_end = 0, region_end = 0;
+    /* Under sys_ppu_thread.c's table lock (T034); s_cb_floor is the lowest byte carved here,
+     * because a second vm_stack_alloc_init() (a host test harness does one) puts region_end
+     * back at the top, over stacks already handed out. */
+    const uint32_t base = ppu_stack_carve(total, PPU_CB_HEADROOM, s_cb_floor, &thread_end, &region_end);
+    if (!base) {
         fprintf(stderr, "[ppu] guest_call: no room for a %u KB callback stack (thread stacks "
-                        "end 0x%08X, region end 0x%08X)\n", size >> 10, sa->next_addr, end);
+                        "end 0x%08X, region end 0x%08X)\n", size >> 10, thread_end, region_end);
         return 0;
     }
-    const uint32_t base = end - total;
-    *(volatile uint32_t*)&sa->region_end = base;
     s_cb_floor = base;
     vm_protect(base, pg, 0, 0, 0);                   /* guard page at the bottom */
     return base + pg;
@@ -3800,13 +3796,16 @@ static uint64_t ppu_guest_call_run(ppu_fn fn, uint32_t code, uint32_t toc, const
     ctx.gpr[1]  = (st.base[d] + ppu_cb_stack_size() - PPU_CB_TOP_PAD) & ~0xFu;
     ctx.gpr[2]  = toc;
     for (int i = 0; i < 8; i++) ctx.gpr[3 + i] = a[i];
-    ctx.gpr[13] = PPU_TLS_TP;
     ctx.cia     = code;
     /* Save/restore g_active_ctx: this scratch ctx lives on the stack, so leaving
      * g_active_ctx pointing at it after we return leaves a DANGLING pointer once the
      * frame is reused -- corrupting the crash handler / any diagnostic that reads the
      * current-thread ctx. Restore the caller's. */
     ppu_context* saved_active = g_active_ctx;
+    /* TLS: on the console a sysutil or GCM callback runs with the calling thread's r13, so
+     * its thread-locals are that thread's. A host-only thread (the ticker) has no guest
+     * context and uses the shared block (T034). */
+    ctx.gpr[13] = (saved_active && saved_active->gpr[13]) ? saved_active->gpr[13] : PPU_TLS_TP;
     /* Thread identity: a zeroed scratch ctx used to run callbacks as thread_id 0
      * -- aliasing the main thread in every owner-tracking primitive. Inherit the
      * calling guest thread's id; host-only threads (ticker) get a per-host-thread
diff --git a/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp b/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp
index 41be8f2..beaa388 100644
--- a/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp
+++ b/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp
@@ -17,7 +17,11 @@
 //   2. a callback that calls ppu_guest_call again from inside itself;
 //   3. the stacks come from the PPU stack region, above what the thread-stack
 //      allocator may still hand out, and not from RSX local memory;
-//   4. host threads that end give their stacks back (no growth over 64 threads).
+//   4. host threads that end give their stacks back (no growth over 64 threads);
+//   5. a callback runs with the calling guest thread's r13 (its own TLS block), and
+//      with the shared block on a host thread that has no guest context (T034);
+//   6. carves racing thread-stack allocations never hand out the same bytes (the
+//      fixture's ppu_stack_carve mirrors sys_ppu_thread.c's: one lock for both).
 //
 // Built by tools/test_ppu_guest_call_stacks.py against the real ppu_loader.cpp.
 #include "ppu_recomp.h"
@@ -27,7 +31,9 @@
 #include <cstdlib>
 #include <cstring>
 #include <cstdint>
+#include <mutex>
 #include <thread>
+#include <vector>
 #include "win32_compat.h"
 #include "../../memory/vm.h"
 
@@ -48,6 +54,32 @@ DWORD GetFileAttributesA(const char*) { return INVALID_FILE_ATTRIBUTES; }
 uint64_t ppu_thread_register_main(void) { return 1; }
 void (*g_ppu_thread_entry_trampoline)(uint32_t, uint64_t, uint32_t, uint64_t);
 vm_stack_alloc g_vm_stack_alloc;   // sys_ppu_thread.c's, the PPU stack region allocator
+// sys_ppu_thread.c's carve, with its table lock reduced to this mutex: the thread-stack
+// allocator (stack_alloc below) takes the same one.
+static std::mutex s_table_lock;
+uint32_t ppu_stack_carve(uint32_t total, uint32_t headroom, uint32_t ceiling,
+                         uint32_t* thread_end, uint32_t* region_end)
+{
+    uint32_t base = 0;
+    std::lock_guard<std::mutex> lk(s_table_lock);
+    vm_stack_alloc* sa = &g_vm_stack_alloc;
+    if (!sa->region_end) vm_stack_alloc_init(sa);
+    uint32_t end = sa->region_end;
+    if (ceiling && end > ceiling) end = ceiling;
+    if (end >= sa->next_addr && end - sa->next_addr >= total + headroom) {
+        base = end - total;
+        sa->region_end = base;
+    }
+    if (thread_end) *thread_end = sa->next_addr;
+    if (region_end) *region_end = end;
+    return base;
+}
+static uint32_t stack_alloc(uint32_t size)
+{
+    std::lock_guard<std::mutex> lk(s_table_lock);
+    return vm_stack_allocate(&g_vm_stack_alloc, size);
+}
+extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
 void ppu_register_function(uint64_t addr, void (*fn)(ppu_context*));
 uint64_t ppu_guest_call(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t,
                         uint64_t, uint64_t, uint64_t, uint64_t);
@@ -55,8 +87,8 @@ uint64_t ppu_guest_call(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t,
 
 enum : uint32_t {
     FRAME = 0x400,                       // bytes each fake guest frame fills
-    CODE_PAIR = 0x10000, CODE_OUTER = 0x10100, CODE_INNER = 0x10200, CODE_SP = 0x10300,
-    OPD_PAIR = 0x20000, OPD_OUTER = 0x20010, OPD_INNER = 0x20020, OPD_SP = 0x20030,
+    CODE_PAIR = 0x10000, CODE_OUTER = 0x10100, CODE_INNER = 0x10200, CODE_SP = 0x10300, CODE_R13 = 0x10400,
+    OPD_PAIR = 0x20000, OPD_OUTER = 0x20010, OPD_INNER = 0x20020, OPD_SP = 0x20030, OPD_R13 = 0x20040,
     TOC = 0x80000,
 };
 
@@ -130,6 +162,7 @@ static void cb_outer(ppu_context* ctx)
 
 // ---- helpers ---------------------------------------------------------------
 static void cb_sp(ppu_context* ctx) { ctx->gpr[3] = ctx->gpr[1]; }
+static void cb_r13(ppu_context* ctx) { ctx->gpr[3] = ctx->gpr[13]; }
 
 extern "C" const func_entry function_table[1] = {{0, nullptr, nullptr}};   // registered by hand below
 extern "C" const uint64_t function_table_count = 0;
@@ -144,9 +177,9 @@ int main()
     vm_commit(0xC0000000u, 0x10000000u);
     vm_stack_alloc_init(&g_vm_stack_alloc);
     ppu_register_function(CODE_PAIR, cb_pair);  ppu_register_function(CODE_OUTER, cb_outer);
-    ppu_register_function(CODE_INNER, cb_inner); ppu_register_function(CODE_SP, cb_sp);
+    ppu_register_function(CODE_INNER, cb_inner); ppu_register_function(CODE_SP, cb_sp); ppu_register_function(CODE_R13, cb_r13);
     opd(OPD_PAIR, CODE_PAIR); opd(OPD_OUTER, CODE_OUTER);
-    opd(OPD_INNER, CODE_INNER); opd(OPD_SP, CODE_SP);
+    opd(OPD_INNER, CODE_INNER); opd(OPD_SP, CODE_SP); opd(OPD_R13, CODE_R13);
 
     std::printf("[1] two host threads inside a callback at the same time\n");
     {
@@ -201,6 +234,70 @@ int main()
         check(used <= 0x100000u, "64 short-lived threads reuse a stack instead of carving 64");
     }
 
+    std::printf("[5] callbacks run with the caller's r13\n");
+    {
+        const uint64_t shared = ppu_guest_call(OPD_R13, 0, 0, 0, 0, 0, 0, 0, 0);
+        check(shared != 0, "a host thread with no guest context gets the shared TLS block");
+        uint64_t seen = 0, seen_nested = 0;
+        std::thread th([&] {
+            ppu_context caller;
+            memset(&caller, 0, sizeof caller);
+            caller.gpr[13] = 0x12345678u;
+            g_active_ctx = &caller;
+            seen = ppu_guest_call(OPD_R13, 0, 0, 0, 0, 0, 0, 0, 0);
+            seen_nested = ppu_guest_call(OPD_R13, 0, 0, 0, 0, 0, 0, 0, 0);
+            g_active_ctx = nullptr;
+        });
+        th.join();
+        check(seen == 0x12345678u, "the callback's r13 is the calling guest thread's");
+        check(seen_nested == 0x12345678u, "and the same for the next callback");
+        check(ppu_guest_call(OPD_R13, 0, 0, 0, 0, 0, 0, 0, 0) == shared,
+              "g_active_ctx is restored, so the shared block is back");
+    }
+
+    std::printf("[6] carves racing thread-stack allocations\n");
+    {
+        // Callback stacks come from the top, thread stacks from the bottom, both under one
+        // lock. 8 host threads carve fresh stacks (each holds its stack while the next starts,
+        // so the pool cannot hide it) while 2 more allocate thread stacks; no two ranges overlap.
+        struct Range { uint32_t lo, hi; };
+        std::mutex mu;
+        std::vector<Range> ranges;
+        std::atomic<int> go{0};
+        std::vector<std::thread> ts;
+        for (int i = 0; i < 8; i++)
+            ts.emplace_back([&] {
+                while (!go.load()) std::this_thread::yield();
+                for (int k = 0; k < 20; k++) {
+                    uint32_t te, re;
+                    const uint32_t b = ppu_stack_carve(0x5000, 0x01000000u, 0, &te, &re);
+                    if (!b) continue;
+                    std::lock_guard<std::mutex> lk(mu);
+                    ranges.push_back({b, b + 0x5000});
+                }
+            });
+        for (int i = 0; i < 2; i++)
+            ts.emplace_back([&] {
+                while (!go.load()) std::this_thread::yield();
+                for (int k = 0; k < 20; k++) {
+                    const uint32_t b = stack_alloc(0x10000);
+                    if (!b) continue;
+                    std::lock_guard<std::mutex> lk(mu);
+                    ranges.push_back({b, b + 0x10000});
+                }
+            });
+        go = 1;
+        for (auto& t : ts) t.join();
+        bool overlap = false;
+        for (size_t i = 0; i < ranges.size(); i++)
+            for (size_t j = i + 1; j < ranges.size(); j++)
+                if (ranges[i].lo < ranges[j].hi && ranges[j].lo < ranges[i].hi) overlap = true;
+        std::printf("    %zu ranges handed out\n", ranges.size());
+        check(ranges.size() >= 100, "most of the carves and allocations succeeded");
+        check(!overlap, "no carve overlaps another carve or a thread stack");
+        check(g_vm_stack_alloc.next_addr <= g_vm_stack_alloc.region_end, "the two ends never crossed");
+    }
+
     const unsigned f = s_fail.load();
     std::printf("%s: %u check(s) failed\n", f ? "FAIL" : "PASS", f);
     return f ? 1 : 0;
diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index 580caf0..6efa2d2 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -117,6 +117,32 @@ static uint32_t stack_take(uint32_t size)
     return vm_stack_allocate(&g_vm_stack_alloc, size);
 }
 
+/* Carve `total` bytes from the TOP of the stack region (region_end moves down) for a
+ * guest-callback stack, under the table lock that sys_ppu_thread_create's allocator
+ * runs under, so the two can never both take the same bytes. `ceiling`, when not 0, is
+ * the lowest address the caller has carved so far (a second vm_stack_alloc_init puts
+ * region_end back at the top over stacks already handed out). The carve keeps `headroom`
+ * bytes free above the thread stacks' next_addr. Returns the carved base, 0 if the
+ * region is full; *thread_end and *region_end report why. */
+uint32_t ppu_stack_carve(uint32_t total, uint32_t headroom, uint32_t ceiling,
+                         uint32_t* thread_end, uint32_t* region_end)
+{
+    uint32_t base = 0;
+    table_lock();
+    vm_stack_alloc* sa = &g_vm_stack_alloc;
+    if (!sa->region_end) vm_stack_alloc_init(sa);   /* a host that never ran sys_ppu_thread_init */
+    uint32_t end = sa->region_end;
+    if (ceiling && end > ceiling) end = ceiling;
+    if (end >= sa->next_addr && end - sa->next_addr >= total + headroom) {
+        base = end - total;
+        sa->region_end = base;
+    }
+    if (thread_end) *thread_end = sa->next_addr;
+    if (region_end) *region_end = end;
+    table_unlock();
+    return base;
+}
+
 /* Once the thread is out of its guest code for good. */
 static void stack_give(ppu_thread_info* t)
 {
-- 
