diff --git a/libs/video/tests/test_vulkan_surface_formats.c b/libs/video/tests/test_vulkan_surface_formats.c
new file mode 100644
index 0000000..4e47dde
--- /dev/null
+++ b/libs/video/tests/test_vulkan_surface_formats.c
@@ -0,0 +1,127 @@
+/* Exercise production selection with a scripted Vulkan enumeration. The runner
+ * extracts the real helper; only the driver, allocator and minimal state are fake. */
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint32_t u32;
+static struct { VkPhysicalDevice phys; VkSurfaceKHR surface; } s_vk;
+#define VK_LOG(...) fprintf(stderr, __VA_ARGS__)
+#define VK_CHECK(call, what) do { \
+    VkResult checked = (call); \
+    if (checked != VK_SUCCESS) { VK_LOG("%s failed (%d)\n", what, checked); return -1; } \
+} while (0)
+
+static VkSurfaceFormatKHR formats[256];
+static u32 advertised, available, query_calls, fill_calls, allocations, live;
+static int grow_once, grow_always, fail_allocation;
+static VkResult query_result, fill_result;
+static VKAPI_ATTR VkResult VKAPI_CALL fake_formats(VkPhysicalDevice device, VkSurfaceKHR surface,
+                                                  u32* count, VkSurfaceFormatKHR* out)
+{
+    assert(device == s_vk.phys && surface == s_vk.surface);
+    if (!out) {
+        query_calls++;
+        *count = advertised;
+        return query_result;
+    }
+    fill_calls++;
+    u32 n = *count < available ? *count : available;
+    assert(n <= 256);
+    memcpy(out, formats, n * sizeof *out);
+    *count = n;
+    if (fill_result != VK_SUCCESS) return fill_result;
+    if (grow_always || (grow_once && fill_calls == 1)) {
+        advertised = available;
+        return VK_INCOMPLETE;
+    }
+    return n < available ? VK_INCOMPLETE : VK_SUCCESS;
+}
+static PFN_vkGetPhysicalDeviceSurfaceFormatsKHR pvkGetPhysicalDeviceSurfaceFormatsKHR = fake_formats;
+static void* tracked_calloc(size_t count, size_t size)
+{
+    allocations++;
+    if (fail_allocation) return NULL;
+    void* p = calloc(count, size);
+    assert(p);
+    live++;
+    return p;
+}
+static void tracked_free(void* p)
+{
+    if (p) { assert(live); live--; free(p); }
+}
+#define calloc tracked_calloc
+#define free tracked_free
+#include "formats_under_test.inc"
+#undef calloc
+#undef free
+
+static void reset(u32 count)
+{
+    assert(live == 0);
+    advertised = available = count;
+    query_calls = fill_calls = allocations = 0;
+    grow_once = grow_always = fail_allocation = 0;
+    query_result = fill_result = VK_SUCCESS;
+    for (u32 i = 0; i < 256; i++)
+        formats[i] = (VkSurfaceFormatKHR){ VK_FORMAT_R8G8B8A8_SRGB, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR };
+}
+static void expect_choice(VkFormat expected)
+{
+    VkSurfaceFormatKHR chosen = {0};
+    assert(vk_choose_surface_format(&chosen) == 0);
+    assert(chosen.format == expected && chosen.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR);
+    assert(live == 0);
+}
+static void expect_failure(void)
+{
+    VkSurfaceFormatKHR chosen = { VK_FORMAT_R16G16B16A16_SFLOAT, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR };
+    assert(vk_choose_surface_format(&chosen) == -1);
+    assert(chosen.format == VK_FORMAT_R16G16B16A16_SFLOAT); /* output untouched */
+    assert(live == 0);
+}
+int main(void)
+{
+    (void)tracked_calloc; (void)tracked_free; /* also compile the pre-fix baseline */
+    reset(99);                              /* real Wayland regression */
+    formats[80].format = VK_FORMAT_B8G8R8A8_UNORM;
+    expect_choice(VK_FORMAT_B8G8R8A8_UNORM);
+    assert(fill_calls == 1);
+
+    reset(4);                               /* retain BGRA before RGBA preference */
+    formats[0].format = VK_FORMAT_R8G8B8A8_UNORM;
+    formats[3].format = VK_FORMAT_B8G8R8A8_UNORM;
+    expect_choice(VK_FORMAT_B8G8R8A8_UNORM);
+    reset(4);
+    formats[3].format = VK_FORMAT_R8G8B8A8_UNORM;
+    expect_choice(VK_FORMAT_R8G8B8A8_UNORM);
+    reset(1);                               /* legacy undefined-format policy */
+    formats[0].format = VK_FORMAT_UNDEFINED;
+    expect_choice(VK_FORMAT_B8G8R8A8_UNORM);
+    reset(3);                               /* no preferred UNORM: first format */
+    expect_choice(VK_FORMAT_R8G8B8A8_SRGB);
+
+    reset(2); available = 99; grow_once = 1;
+    formats[98].format = VK_FORMAT_B8G8R8A8_UNORM;
+    expect_choice(VK_FORMAT_B8G8R8A8_UNORM);
+    assert(query_calls == 2 && fill_calls == 2);
+    reset(99); available = 1;                /* list shrank; only written items valid */
+    expect_choice(VK_FORMAT_R8G8B8A8_SRGB);
+
+    reset(0); expect_failure();
+    assert(fill_calls == 0 && allocations == 0);
+    reset(4); available = 0; expect_failure();
+    reset(4); query_result = VK_ERROR_SURFACE_LOST_KHR; expect_failure();
+    assert(fill_calls == 0);
+    reset(4); fill_result = VK_ERROR_SURFACE_LOST_KHR; expect_failure();
+    reset(4); fail_allocation = 1; expect_failure();
+    assert(fill_calls == 0);
+    reset(4); grow_always = 1; expect_failure();
+    assert(query_calls == 4 && fill_calls == 4 && allocations == 4);
+    puts("vulkan surface formats: OK (>64, preferences, growth/shrink, errors, allocation, bounded retry)");
+    return 0;
+}
diff --git a/libs/video/tests/test_vulkan_surface_formats.py b/libs/video/tests/test_vulkan_surface_formats.py
new file mode 100644
index 0000000..a6f8eb2
--- /dev/null
+++ b/libs/video/tests/test_vulkan_surface_formats.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Test production Vulkan surface-format selection without a GPU or display."""
+import argparse
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sanitize", action="store_true")
+    args = parser.parse_args()
+    source = Path(__file__).resolve().with_suffix(".c")
+    backend = (source.parent.parent / "rsx_vulkan_backend.c").read_text()
+    # Extract the production helper verbatim. The fallback also exercises the
+    # pre-fix inline implementation, to prove the >64 regression fails there.
+    marker = "static int vk_choose_surface_format("
+    if marker in backend:
+        start = backend.index(marker)
+        end = backend.index("\n}\n", start) + 3
+        implementation = backend[start:end]
+    else:
+        start = backend.index("    u32 nf = 0;", backend.index("static int vk_create_swapchain("))
+        end = backend.index("    VkFormatProperties fp;", start)
+        implementation = ("static int vk_choose_surface_format(VkSurfaceFormatKHR* chosen)\n{\n"
+                          + backend[start:end] + "    *chosen = fmt;\n    return 0;\n}\n")
+    with tempfile.TemporaryDirectory(prefix="vk-surface-formats-") as tmp:
+        (Path(tmp) / "formats_under_test.inc").write_text(implementation)
+        binary = str(Path(tmp) / "fixture")
+        cmd = shlex.split(os.environ.get("CC", "cc"))
+        cmd += ["-std=c17", "-O1", "-g", "-Wall", "-Wextra", "-Werror", "-I", tmp]
+        if args.sanitize:
+            cmd += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
+        subprocess.run(cmd + [str(source), "-o", binary], check=True)
+        subprocess.run([binary], check=True)
+
+
+if __name__ == "__main__":
+    main()
