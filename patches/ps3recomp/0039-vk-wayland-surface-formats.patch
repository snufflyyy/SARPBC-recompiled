 .../video/tests/test_vulkan_surface_formats.c | 127 ++++++++++++++++++
 .../tests/test_vulkan_surface_formats.py      |  41 ++++++
 3 files changed, 208 insertions(+), 19 deletions(-)
 create mode 100644 libs/video/tests/test_vulkan_surface_formats.c
