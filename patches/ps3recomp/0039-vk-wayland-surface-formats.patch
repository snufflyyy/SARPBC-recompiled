diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index e60d892..95d462e 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -1883,6 +1883,44 @@ static void vk_window_open(const char* title)
            SDL_GetCurrentVideoDriver(), n);
 }
 
+static int vk_choose_surface_format(VkSurfaceFormatKHR* chosen)
+{
+    /* Wayland can expose more than 64 format/colorspace pairs. Enumerate the
+     * complete list, and retry if it grows between the count and fill calls.
+     * Bound retries so an unstable surface cannot hang initialization/rebuild. */
+    for (u32 attempt = 0; attempt < 4; attempt++) {
+        u32 nf = 0;
+        VK_CHECK(pvkGetPhysicalDeviceSurfaceFormatsKHR(s_vk.phys, s_vk.surface, &nf, NULL),
+                 "vkGetPhysicalDeviceSurfaceFormatsKHR");
+        if (nf == 0) { VK_LOG("surface reports no formats\n"); return -1; }
+        VkSurfaceFormatKHR* fmts = calloc(nf, sizeof *fmts);
+        if (!fmts) { VK_LOG("cannot allocate %u surface formats\n", nf); return -1; }
+        VkResult r = pvkGetPhysicalDeviceSurfaceFormatsKHR(s_vk.phys, s_vk.surface, &nf, fmts);
+        if (r == VK_INCOMPLETE) { free(fmts); continue; }
+        if (r != VK_SUCCESS || nf == 0) {
+            free(fmts);
+            VK_LOG("surface format enumeration failed (VkResult %d, count %u)\n", (int)r, nf);
+            return -1;
+        }
+        /* UNORM, not SRGB: the offscreen target holds the guest's values as-is. */
+        VkSurfaceFormatKHR fmt = fmts[0];
+        if (nf == 1 && fmts[0].format == VK_FORMAT_UNDEFINED) {
+            fmt.format = VK_FORMAT_B8G8R8A8_UNORM;
+        } else {
+            static const VkFormat pref[] = { VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_R8G8B8A8_UNORM };
+            int found = 0;
+            for (size_t k = 0; k < 2 && !found; k++)
+                for (u32 i = 0; i < nf; i++)
+                    if (fmts[i].format == pref[k]) { fmt = fmts[i]; found = 1; break; }
+        }
+        free(fmts);
+        *chosen = fmt;
+        return 0;
+    }
+    VK_LOG("surface format list kept changing after 4 attempts\n");
+    return -1;
+}
+
 static int vk_create_swapchain(void)
 {
     VkSurfaceCapabilitiesKHR caps;
@@ -1892,25 +1930,8 @@ static int vk_create_swapchain(void)
         VK_LOG("swapchain images cannot be blit destinations\n"); return -1;
     }
 
