From 7a604f8725e0cdcf562d37aff9d91605932b316c Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Sun, 18 Oct 2026 23:31:02 -0500
Subject: [PATCH] cellGame: take the game type from PARAM.SFO CATEGORY, not
 always DISC

cellGame_init_from_paramsfo already reads TITLE_ID, but s_game_type stayed
CELL_GAME_GAMETYPE_DISC for every title, so an HDD/PSN game ("HG") was
told by cellGameBootCheck/ContentPermit that it runs from
/dev_bdvd/PS3_GAME. Supersonic Acrobatic Rocket-Powered Battle-Cars 1.09
(NPUB30035) builds every data path from that answer and found nothing.
"HG" now reports CELL_GAME_GAMETYPE_HDD and "DG" DISC; other categories
keep the previous default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/system/cellGame.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/libs/system/cellGame.c b/libs/system/cellGame.c
index 071b9ec..bb169da 100644
--- a/libs/system/cellGame.c
+++ b/libs/system/cellGame.c
@@ -308,6 +308,16 @@ void cellGame_init_from_paramsfo(const char* sfo_path)
     if (sfo_read_string(sfo_path, "APP_VER", tmp, sizeof(tmp)) == 0 && tmp[0]) {
         strncpy(s_app_ver, tmp, sizeof(s_app_ver) - 1); s_app_ver[sizeof(s_app_ver) - 1] = '\0';
     }
+    /* CATEGORY decides what cellGameBootCheck reports, and the title builds its
+     * paths from that: a disc game ("DG") is told /dev_bdvd/PS3_GAME, an HDD /
+     * PSN game ("HG") /dev_hdd0/game/<TITLE_ID>. Leaving every title on DISC
+     * sent Supersonic Acrobatic Rocket-Powered Battle-Cars 1.09 (NPUB30035, HG)
+     * to look for its data on a disc it does not have. */
+    if (sfo_read_string(sfo_path, "CATEGORY", tmp, sizeof(tmp)) == 0 && tmp[0]) {
+        if (strcmp(tmp, "HG") == 0)      s_game_type = CELL_GAME_GAMETYPE_HDD;
+        else if (strcmp(tmp, "DG") == 0) s_game_type = CELL_GAME_GAMETYPE_DISC;
+        printf("[cellGame] category from PARAM.SFO: '%s' -> game type %u\n", tmp, s_game_type);
+    }
 }
 
 /* Central title-id accessor so other modules (cellSysutil etc.) don't hardcode it. */
