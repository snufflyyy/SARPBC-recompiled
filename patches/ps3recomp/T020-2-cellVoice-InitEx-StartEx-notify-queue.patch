From 90b792d3a51befbead8b2db474d461c1cde51870 Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Mon, 19 Oct 2026 00:00:25 -0500
Subject: [PATCH] cellVoice: InitEx, StartEx and a real notify event queue

cellVoiceInitEx, cellVoiceStartEx, cellVoiceCreateNotifyEventQueue and
cellVoiceSetNotifyEventQueue had no handlers. Faked as CELL_OK they left
libvoice uninitialized (every later call answered NOT_INITIALIZED) and
the queue id unwritten, so a title's voice thread received on queue 0
forever.

- InitEx/Init read CellVoiceInitParam (eventMask @0, version @4,
  appType @8); StartEx takes CellVoiceStartParam (container @0).
- CreateNotifyEventQueue creates an lv2 queue with its own key and writes
  the 32-bit id and 64-bit key; SetNotifyEventQueue(key, source) routes
  events to it, RemoveNotifyEventQueue unroutes.
- Start/StartEx push SERVICE_ATTACHED (data1 = 8), Stop/End push
  SERVICE_DETACHED (0x10); a queue registered while running hears
  ATTACHED at once. The values are what NPUB30035's voice thread
  (01.09, 0x00BEFB2C) compares data1 against.
- GetPortInfo writes CellVoiceBasePortInfo (portType, state, ...) instead
  of copying the 36-byte port param back: the title read the param's
  threshold halfword as `state`, and the copy overran its 24-byte block.
  Mic ports are IDLE (no headset); other ports RUN while started.

NIDs computed from the SDK names: InitEx 0xB1A2C38F, StartEx 0x94D51F92,
CreateNotifyEventQueue 0x2A01013E, SetNotifyEventQueue 0x35D84910 (all
imported by Supersonic Acrobatic Rocket-Powered Battle-Cars 01.09).
Drakengard 3's fork (soyjxck/ps3recomp) has upstream's cellVoice
unchanged, so there was nothing to port.

Test: libs/audio/tests/test_voice_notify.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/audio/cellVoice.c               | 232 ++++++++++++++++++++++++---
 libs/audio/cellVoice.h               |  35 +++-
 libs/audio/tests/test_voice_notify.c | 120 ++++++++++++++
 3 files changed, 363 insertions(+), 24 deletions(-)
 create mode 100644 libs/audio/tests/test_voice_notify.c

diff --git a/libs/audio/cellVoice.c b/libs/audio/cellVoice.c
index 8a2d6e5..e3197a3 100644
--- a/libs/audio/cellVoice.c
+++ b/libs/audio/cellVoice.c
@@ -1,59 +1,134 @@
 /*
  * ps3recomp - cellVoice HLE implementation
  *
- * Stub. Init/end work, port creation succeeds but no voice
- * data is captured or played. Games handle gracefully.
+ * No voice data is captured or played: ports are created and connected, reads
+ * return no data and writes are discarded. What IS real is the service's
+ * event channel -- the lv2 event queue a title creates through
+ * cellVoiceCreateNotifyEventQueue and registers with
+ * cellVoiceSetNotifyEventQueue -- because a title polls or blocks on it, and a
+ * queue id that was never written is a queue that does not exist.
  */
 
 #include "cellVoice.h"
 #include <stdio.h>
 #include <string.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* GUEST_PTR, vm_write*: guest EA -> host */
+#include "../../runtime/ppu/ppu_memory.h"   /* GUEST_PTR, vm_read/vm_write: guest EA -> host */
+
+/* Event-queue push/lookup/create (runtime/syscalls/sys_event.c). Forward-
+ * declared rather than including sys_event.h, which pulls in the PPU context
+ * and the syscall table -- same as cellAudio.c. */
+extern int      sys_event_queue_push_by_id(uint32_t queue_id,
+                                           uint64_t source, uint64_t data1,
+                                           uint64_t data2,  uint64_t data3);
+extern uint32_t sys_event_find_queue_by_key(uint64_t key);
+extern uint32_t sys_event_queue_create_direct(uint64_t key, int32_t size);
 
 /* Internal state */
 
 static int s_initialized = 0;
 static int s_started = 0;
+static u32 s_event_mask = 0;
 
 typedef struct {
     int in_use;
-    CellVoicePortParam param;
+    u32 port_type;              /* CellVoicePortParam.portType, host order */
+    CellVoicePortParam param;   /* raw guest bytes, returned as they came */
 } VoicePort;
 
 static VoicePort s_ports[CELL_VOICE_PORT_MAX];
 
-/* API */
+/* Queues registered with cellVoiceSetNotifyEventQueue: (key, source) pairs.
+ * The same key may be registered more than once with different sources. */
+#define CELL_VOICE_MAX_NOTIFY_QUEUES 8
+typedef struct {
+    int in_use;
+    u64 key;
+    u64 source;
+} VoiceNotifyQueue;
 
-s32 cellVoiceInit(const CellVoiceInitParam* param)
+static VoiceNotifyQueue s_notify[CELL_VOICE_MAX_NOTIFY_QUEUES];
+
+/* Push one service event to every registered queue.
+ *
+ * The event's data1 is the event type: a shipping title's voice thread
+ * (NPUB30035 01.09, 0x00BEFB2C) receives on its queue and compares the
+ * returned data1 against 8 (SERVICE_ATTACHED, sets its "voice running" flag)
+ * and 0x10 (SERVICE_DETACHED, clears it). The source is whatever the title
+ * registered the queue with. */
+static void voice_notify(u32 event)
+{
+    /* An eventMask of 0 is what titles pass to InitEx (NPUB30035 does) and
+     * cannot mean "no events" for a title that then registers a queue for
+     * them, so only a non-zero mask filters. A guess, marked as one. */
+    if (s_event_mask && !(s_event_mask & event))
+        return;
+    for (int i = 0; i < CELL_VOICE_MAX_NOTIFY_QUEUES; i++) {
+        if (!s_notify[i].in_use) continue;
+        uint32_t qid = sys_event_find_queue_by_key(s_notify[i].key);
+        if (!qid) continue;
+        sys_event_queue_push_by_id(qid, s_notify[i].source, event, 0, 0);
+    }
+}
+
+static s32 voice_init(u32 param_ea, int ex)
 {
-    (void)param;
-    printf("[cellVoice] Init()\n");
     if (s_initialized)
         return (s32)CELL_VOICE_ERROR_ALREADY_INITIALIZED;
+    if (!param_ea)
+        return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
+
+    /* CellVoiceInitParam: eventMask @0, version @4, appType @8 (NPUB30035
+     * fills 0, 100 = CELLVOICE_VERSION_100, 0x20000000 = APPTYPE_GAME_1MB). */
+    s_event_mask = vm_read32(param_ea + 0);
+    printf("[cellVoice] Init%s(eventMask=0x%X, version=%u, appType=0x%X)\n",
+           ex ? "Ex" : "", s_event_mask, vm_read32(param_ea + 4),
+           vm_read32(param_ea + 8));
+
     memset(s_ports, 0, sizeof(s_ports));
     s_initialized = 1;
     s_started = 0;
     return CELL_OK;
 }
 
+/* API */
+
+s32 cellVoiceInit(u32 param_ea)
+{
+    return voice_init(param_ea, 0);
+}
+
+/* cellVoiceInitEx(CellVoiceInitParam*) -- Init for SDK 1.6+ titles; same
+ * parameter block. Missing, it faked CELL_OK, which happens to read as
+ * success, but left the library uninitialized, so every later call (ports,
+ * Start) answered NOT_INITIALIZED. */
+s32 cellVoiceInitEx(u32 param_ea)
+{
+    return voice_init(param_ea, 1);
+}
+
 s32 cellVoiceEnd(void)
 {
     printf("[cellVoice] End()\n");
+    if (s_initialized && s_started)
+        voice_notify(CELL_VOICE_EVENT_SERVICE_DETACHED);
     s_initialized = 0;
     s_started = 0;
+    s_event_mask = 0;
+    memset(s_notify, 0, sizeof(s_notify));
     return CELL_OK;
 }
 
-s32 cellVoiceCreatePort(const CellVoicePortParam* param, CellVoicePortId* portId)
+s32 cellVoiceCreatePort(u32 param_ea, u32 portId_ea)
 {
     if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
-    if (!param || !portId) return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
+    if (!param_ea || !portId_ea) return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
 
     for (int i = 0; i < CELL_VOICE_PORT_MAX; i++) {
         if (!s_ports[i].in_use) {
             s_ports[i].in_use = 1;
-            s_ports[i].param = *GUEST_PTR(param, const CellVoicePortParam*);
-            vm_write32((u32)(uintptr_t)portId, (u32)i);
+            s_ports[i].port_type = vm_read32(param_ea);
+            s_ports[i].param = *GUEST_PTR(param_ea, const CellVoicePortParam*);
+            vm_write32(portId_ea, (u32)i);
             return CELL_OK;
         }
     }
@@ -83,22 +158,121 @@ s32 cellVoiceDisconnectIPortFromOPort(CellVoicePortId inPortId, CellVoicePortId
     return CELL_OK;
 }
 
-s32 cellVoiceStart(void)
+static s32 voice_start(int ex)
 {
-    printf("[cellVoice] Start()\n");
+    printf("[cellVoice] Start%s()\n", ex ? "Ex" : "");
     if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
-    s_started = 1;
+    if (!s_started) {
+        s_started = 1;
+        voice_notify(CELL_VOICE_EVENT_SERVICE_ATTACHED);
+    }
     return CELL_OK;
 }
 
+s32 cellVoiceStart(void)
+{
+    return voice_start(0);
+}
+
+/* cellVoiceStartEx(CellVoiceStartParam*) -- Start with a memory container
+ * (CellVoiceStartParam.container @0; NPUB30035 creates a 1 MB one). No
+ * buffers are allocated here, so the container is only validated as present. */
+s32 cellVoiceStartEx(u32 param_ea)
+{
+    if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
+    if (!param_ea) return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
+    return voice_start(1);
+}
+
 s32 cellVoiceStop(void)
 {
     printf("[cellVoice] Stop()\n");
     if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
-    s_started = 0;
+    if (s_started) {
+        s_started = 0;
+        voice_notify(CELL_VOICE_EVENT_SERVICE_DETACHED);
+    }
     return CELL_OK;
 }
 
+/* cellVoiceCreateNotifyEventQueue(sys_event_queue_t* id, sys_ipc_key_t* key)
+ *
+ * Creates the lv2 event queue the title will receive voice-service events on
+ * and hands back its id (32-bit) and ipc key (64-bit), both big-endian
+ * out-values at guest addresses. It does NOT register the queue; the title
+ * does that with cellVoiceSetNotifyEventQueue(key, source).
+ *
+ * Unimplemented, the import faked CELL_OK and left *id unwritten: NPUB30035's
+ * voice thread then polled sys_event_queue_receive on queue 0 forever. */
+s32 cellVoiceCreateNotifyEventQueue(u32 id_ea, u32 key_ea)
+{
+    printf("[cellVoice] CreateNotifyEventQueue(id_ea=0x%08X key_ea=0x%08X)\n",
+           id_ea, key_ea);
+    if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
+    if (!id_ea || !key_ea) return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
+
+    /* A key of its own: queues are looked up BY KEY, and titles create their
+     * other queues with key 0 (cellAudio uses 0x80000000_00000001+, so this
+     * range stays clear of it). */
+    static uint64_t s_next_key = 0x8000564F00000001ull;   /* "VO" */
+    uint64_t k = s_next_key++;
+
+    uint32_t qid = sys_event_queue_create_direct(k, 32);
+    if (!qid)
+        return (s32)CELL_VOICE_ERROR_EVENT_QUEUE;
+
+    vm_write32(id_ea, qid);
+    vm_write64(key_ea, k);
+    printf("[cellVoice] CreateNotifyEventQueue -> id=%u key=0x%llX\n",
+           qid, (unsigned long long)k);
+    return CELL_OK;
+}
+
+/* cellVoiceSetNotifyEventQueue(sys_ipc_key_t key, uint64_t source) -- route
+ * voice-service events to the queue with that key, tagged with `source`. If
+ * the service is already running the new queue hears SERVICE_ATTACHED at
+ * once, so a title that registers after Start still learns it is up. */
+s32 cellVoiceSetNotifyEventQueue(u64 key, u64 source)
+{
+    printf("[cellVoice] SetNotifyEventQueue(key=0x%llX source=0x%llX)\n",
+           (unsigned long long)key, (unsigned long long)source);
+    if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
+    if (!sys_event_find_queue_by_key(key))
+        return (s32)CELL_VOICE_ERROR_EVENT_QUEUE;
+
+    for (int i = 0; i < CELL_VOICE_MAX_NOTIFY_QUEUES; i++) {
+        if (!s_notify[i].in_use) {
+            s_notify[i].in_use = 1;
+            s_notify[i].key = key;
+            /* Source 0 asks for the library's default; the default's value is
+             * not known here, so the key stands in for it (a guess). */
+            s_notify[i].source = source ? source : key;
+            if (s_started && !(s_event_mask &&
+                               !(s_event_mask & CELL_VOICE_EVENT_SERVICE_ATTACHED)))
+                sys_event_queue_push_by_id(sys_event_find_queue_by_key(key),
+                                           s_notify[i].source,
+                                           CELL_VOICE_EVENT_SERVICE_ATTACHED, 0, 0);
+            return CELL_OK;
+        }
+    }
+    return (s32)CELL_VOICE_ERROR_OUT_OF_MEMORY;
+}
+
+s32 cellVoiceRemoveNotifyEventQueue(u64 key)
+{
+    printf("[cellVoice] RemoveNotifyEventQueue(key=0x%llX)\n",
+           (unsigned long long)key);
+    if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
+    int found = 0;
+    for (int i = 0; i < CELL_VOICE_MAX_NOTIFY_QUEUES; i++) {
+        if (s_notify[i].in_use && s_notify[i].key == key) {
+            s_notify[i].in_use = 0;
+            found = 1;
+        }
+    }
+    return found ? CELL_OK : (s32)CELL_VOICE_ERROR_EVENT_QUEUE;
+}
+
 s32 cellVoiceSetNotifyEventType(u32 eventType, u32 enableFlag)
 {
     (void)eventType; (void)enableFlag;
@@ -124,13 +298,33 @@ s32 cellVoiceSetVolume(CellVoicePortId portId, float volume)
     return CELL_OK;
 }
 
-s32 cellVoiceGetPortInfo(CellVoicePortId portId, CellVoicePortParam* param)
+/* cellVoiceGetPortInfo(portId, CellVoiceBasePortInfo* info) -- the port's
+ * type and STATE, not its creation parameters. This used to copy the 36-byte
+ * CellVoicePortParam back, which put the param's threshold/mute halfwords
+ * where the title reads `state` (+4): NPUB30035 tests state > 0 ("a device is
+ * attached") and state == 3 (running) and got 0x00640000 for both. It also
+ * wrote 12 bytes past a 24-byte info block on the title's stack.
+ *
+ * No voice device exists, so a microphone port is IDLE (nothing attached);
+ * other ports run while the service does. */
+s32 cellVoiceGetPortInfo(CellVoicePortId portId, u32 info_ea)
 {
     if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
     if (portId >= CELL_VOICE_PORT_MAX || !s_ports[portId].in_use)
         return (s32)CELL_VOICE_ERROR_PORT_NOT_FOUND;
-    if (!param) return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
-    *GUEST_PTR(param, CellVoicePortParam*) = s_ports[portId].param;
+    if (!info_ea) return (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT;
+
+    u32 type = s_ports[portId].port_type;
+    u32 state = (type == CELL_VOICE_PORT_IN_MIC || !s_started)
+                    ? CELL_VOICE_PORTSTATE_IDLE : CELL_VOICE_PORTSTATE_RUNNING;
+    /* CellVoiceBasePortInfo: portType @0, state @4, pEdge @8, numEdge @0xC,
+     * numByte @0x10, frameSize @0x14. No edges, no buffered bytes. */
+    vm_write32(info_ea + 0x00, type);
+    vm_write32(info_ea + 0x04, state);
+    vm_write32(info_ea + 0x08, 0);
+    vm_write32(info_ea + 0x0C, 0);
+    vm_write32(info_ea + 0x10, 0);
+    vm_write32(info_ea + 0x14, 0);
     return CELL_OK;
 }
 
diff --git a/libs/audio/cellVoice.h b/libs/audio/cellVoice.h
index 3edafca..b8c3636 100644
--- a/libs/audio/cellVoice.h
+++ b/libs/audio/cellVoice.h
@@ -2,7 +2,7 @@
  * ps3recomp - cellVoice HLE
  *
  * Voice chat system: voice capture, encoding, and playback.
- * Stub — init/term work, no voice ports are available.
+ * No voice data flows; the service's event queue is real (see cellVoice.c).
  */
 
 #ifndef PS3RECOMP_CELL_VOICE_H
@@ -22,6 +22,24 @@ extern "C" {
 #define CELL_VOICE_ERROR_PORT_NOT_FOUND      0x80310804
 #define CELL_VOICE_ERROR_OUT_OF_MEMORY       0x80310805
 #define CELL_VOICE_ERROR_SERVICE_DETACHED    0x80310806
+#define CELL_VOICE_ERROR_EVENT_QUEUE         0x8031080F   /* SDK name/value */
+
+/* Voice-service events, delivered as data1 of an lv2 event on the queue
+ * registered with cellVoiceSetNotifyEventQueue. */
+#define CELL_VOICE_EVENT_DATA_ERROR          (1u << 0)
+#define CELL_VOICE_EVENT_PORT_ATTACHED       (1u << 1)
+#define CELL_VOICE_EVENT_PORT_DETACHED       (1u << 2)
+#define CELL_VOICE_EVENT_SERVICE_ATTACHED    (1u << 3)
+#define CELL_VOICE_EVENT_SERVICE_DETACHED    (1u << 4)
+#define CELL_VOICE_EVENT_PORT_WEAK_ATTACHED  (1u << 5)
+#define CELL_VOICE_EVENT_PORT_WEAK_DETACHED  (1u << 6)
+
+/* CellVoiceBasePortInfo.state */
+#define CELL_VOICE_PORTSTATE_NULL      0xFFFFFFFFu
+#define CELL_VOICE_PORTSTATE_IDLE      0
+#define CELL_VOICE_PORTSTATE_READY     1
+#define CELL_VOICE_PORTSTATE_BUFFERING 2
+#define CELL_VOICE_PORTSTATE_RUNNING   3
 
 /* Constants */
 #define CELL_VOICE_PORT_MAX          16
@@ -58,24 +76,31 @@ typedef struct CellVoicePortParam {
 
 typedef void (*CellVoiceEventCallback)(s32 event, void* arg);
 
-/* Functions */
-s32 cellVoiceInit(const CellVoiceInitParam* param);
+/* Functions. Pointer parameters spelt u32 are GUEST addresses (the generic
+ * HLE adapter passes r3..r10 through unchanged). */
+s32 cellVoiceInit(u32 param_ea);
+s32 cellVoiceInitEx(u32 param_ea);
 s32 cellVoiceEnd(void);
 
-s32 cellVoiceCreatePort(const CellVoicePortParam* param, CellVoicePortId* portId);
+s32 cellVoiceCreatePort(u32 param_ea, u32 portId_ea);
 s32 cellVoiceDeletePort(CellVoicePortId portId);
 
 s32 cellVoiceConnectIPortToOPort(CellVoicePortId inPortId, CellVoicePortId outPortId);
 s32 cellVoiceDisconnectIPortFromOPort(CellVoicePortId inPortId, CellVoicePortId outPortId);
 
 s32 cellVoiceStart(void);
+s32 cellVoiceStartEx(u32 param_ea);
 s32 cellVoiceStop(void);
 
+s32 cellVoiceCreateNotifyEventQueue(u32 id_ea, u32 key_ea);
+s32 cellVoiceSetNotifyEventQueue(u64 key, u64 source);
+s32 cellVoiceRemoveNotifyEventQueue(u64 key);
+
 s32 cellVoiceSetNotifyEventType(u32 eventType, u32 enableFlag);
 s32 cellVoiceSetMuteFlag(CellVoicePortId portId, u32 muteFlag);
 s32 cellVoiceSetVolume(CellVoicePortId portId, float volume);
 
-s32 cellVoiceGetPortInfo(CellVoicePortId portId, CellVoicePortParam* param);
+s32 cellVoiceGetPortInfo(CellVoicePortId portId, u32 info_ea);
 s32 cellVoiceWriteToIPort(CellVoicePortId portId, const void* data, u32* size);
 s32 cellVoiceReadFromOPort(CellVoicePortId portId, void* data, u32* size);
 
diff --git a/libs/audio/tests/test_voice_notify.c b/libs/audio/tests/test_voice_notify.c
new file mode 100644
index 0000000..e92f092
--- /dev/null
+++ b/libs/audio/tests/test_voice_notify.c
@@ -0,0 +1,120 @@
+/* clang -std=gnu17 -I include libs/audio/tests/test_voice_notify.c
+ *   -Wl,-dead_strip -o /tmp/test_voice_notify && /tmp/test_voice_notify
+ * Linux: replace -Wl,-dead_strip with -ffunction-sections -fdata-sections -Wl,--gc-sections
+ *
+ * The voice service's notify queue: CreateNotifyEventQueue must create a real
+ * queue and write its id and key; SetNotifyEventQueue routes service events to
+ * it, data1 = event type, source = the title's. The call sequence and values
+ * are the ones NPUB30035 (01.09, 0x00BEF8FC) uses. */
+#include "../cellVoice.c"
+#include <assert.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+/* A two-queue stand-in for runtime/syscalls/sys_event.c. */
+static uint64_t q_key[3];
+static unsigned n_queues;
+static struct { uint32_t q; uint64_t src, d1, d2, d3; } pushed[16];
+static unsigned n_pushed;
+uint32_t sys_event_queue_create_direct(uint64_t key, int32_t size)
+{
+    assert(size > 0 && n_queues < 2);
+    q_key[++n_queues] = key;
+    return n_queues;
+}
+uint32_t sys_event_find_queue_by_key(uint64_t key)
+{
+    for (unsigned i = 1; i <= n_queues; i++) if (key && q_key[i] == key) return i;
+    return 0;
+}
+int sys_event_queue_push_by_id(uint32_t q, uint64_t src, uint64_t d1, uint64_t d2, uint64_t d3)
+{
+    assert(q >= 1 && q <= n_queues && n_pushed < 16);
+    pushed[n_pushed].q = q; pushed[n_pushed].src = src;
+    pushed[n_pushed].d1 = d1; pushed[n_pushed].d2 = d2; pushed[n_pushed].d3 = d3;
+    n_pushed++;
+    return 0;
+}
+
+int main(void)
+{
+    vm_base = calloc(1, 65536); assert(vm_base);
+    const u32 init = 0x100, ids = 0x200, start = 0x300, info = 0x400;
+
+    /* Nothing works before init. */
+    assert(cellVoiceCreateNotifyEventQueue(ids + 8, ids + 0x20) == (s32)CELL_VOICE_ERROR_NOT_INITIALIZED);
+
+    /* InitEx {eventMask 0, version 100, appType GAME_1MB}, as the title passes. */
+    vm_write32(init + 0, 0); vm_write32(init + 4, 100); vm_write32(init + 8, 0x20000000);
+    assert(cellVoiceInitEx(0) == (s32)CELL_VOICE_ERROR_INVALID_ARGUMENT);
+    assert(cellVoiceInitEx(init) == CELL_OK);
+    assert(cellVoiceInitEx(init) == (s32)CELL_VOICE_ERROR_ALREADY_INITIALIZED);
+
+    /* The queue exists and its id (32-bit) and key (64-bit) are written. */
+    memset(vm_base + ids, 0xEE, 0x40);
+    assert(cellVoiceCreateNotifyEventQueue(ids + 8, ids + 0x20) == CELL_OK);
+    assert(vm_read32(ids + 8) == 1);
+    u64 key = vm_read64(ids + 0x20);
+    assert(key && sys_event_find_queue_by_key(key) == 1);
+    assert(vm_read32(ids + 0xC) == 0xEEEEEEEE);   /* nothing past the id */
+
+    /* Registering an unknown key fails; the real one succeeds silently while
+     * the service is not running. */
+    assert(cellVoiceSetNotifyEventQueue(0x1234, 0x3039) == (s32)CELL_VOICE_ERROR_EVENT_QUEUE);
+    assert(cellVoiceSetNotifyEventQueue(key, 0x3039) == CELL_OK);
+    assert(n_pushed == 0);
+
+    /* A mic port: IDLE (no headset), type read back from the guest param. */
+    vm_write32(0x500, CELL_VOICE_PORT_IN_MIC);
+    assert(cellVoiceCreatePort(0x500, 0x504) == CELL_OK);
+    u32 mic = vm_read32(0x504);
+    vm_write32(0x510, 4);
+    assert(cellVoiceCreatePort(0x510, 0x514) == CELL_OK);
+    u32 pcm = vm_read32(0x514);
+    memset(vm_base + info, 0xEE, 0x40);
+    assert(cellVoiceGetPortInfo(mic, info) == CELL_OK);
+    assert(vm_read32(info) == CELL_VOICE_PORT_IN_MIC && vm_read32(info + 4) == CELL_VOICE_PORTSTATE_IDLE);
+    assert(vm_read32(info + 0x18) == 0xEEEEEEEE);  /* stays inside the 24-byte info */
+
+    /* StartEx {container}: SERVICE_ATTACHED reaches the queue, data1 = 8. */
+    vm_write32(start, 0x11);
+    assert(cellVoiceStartEx(start) == CELL_OK);
+    assert(n_pushed == 1 && pushed[0].q == 1 && pushed[0].src == 0x3039 &&
+           pushed[0].d1 == CELL_VOICE_EVENT_SERVICE_ATTACHED && pushed[0].d1 == 8 &&
+           !pushed[0].d2 && !pushed[0].d3);
+    assert(cellVoiceStartEx(start) == CELL_OK && n_pushed == 1);   /* once */
+    assert(cellVoiceGetPortInfo(pcm, info) == CELL_OK &&
+           vm_read32(info + 4) == CELL_VOICE_PORTSTATE_RUNNING);
+    assert(cellVoiceGetPortInfo(mic, info) == CELL_OK &&
+           vm_read32(info + 4) == CELL_VOICE_PORTSTATE_IDLE);
+
+    /* A queue registered after Start hears ATTACHED at once. */
+    assert(cellVoiceCreateNotifyEventQueue(ids + 0x30, ids + 0x38) == CELL_OK);
+    u64 key2 = vm_read64(ids + 0x38);
+    assert(key2 != key && vm_read32(ids + 0x30) == 2);
+    assert(cellVoiceSetNotifyEventQueue(key2, 0) == CELL_OK);
+    assert(n_pushed == 2 && pushed[1].q == 2 && pushed[1].src == key2 && pushed[1].d1 == 8);
+
+    /* Stop: SERVICE_DETACHED (0x10) to both. */
+    assert(cellVoiceStop() == CELL_OK);
+    assert(n_pushed == 4 && pushed[2].d1 == 0x10 && pushed[3].d1 == 0x10);
+
+    /* Removed queues hear nothing more; End resets for a fresh InitEx. */
+    assert(cellVoiceRemoveNotifyEventQueue(key2) == CELL_OK);
+    assert(cellVoiceRemoveNotifyEventQueue(key2) == (s32)CELL_VOICE_ERROR_EVENT_QUEUE);
+    assert(cellVoiceStart() == CELL_OK && n_pushed == 5 && pushed[4].q == 1);
+    assert(cellVoiceEnd() == CELL_OK && n_pushed == 6 && pushed[5].d1 == 0x10);
+    assert(cellVoiceInitEx(init) == CELL_OK);
+
+    free(vm_base);
+    puts("cellVoice notify queue: created, id+key written, service events delivered");
+}
