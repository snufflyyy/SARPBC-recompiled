 int  rsx_vulkan_backend_present_ready(void);
 
+/* A short text (digits, letters, . : - / %) drawn in the top left corner of the window by every
+ * present from now on, on a black box; NULL or "" removes it. It is copied into the presented
+ * image only, never into the guest's surfaces or the frame dumps (PS3RECOMP_VK_OVERLAY_DUMP=1
+ * adds it to the dumps). Safe from any thread; at most 48 characters. */
+void rsx_vulkan_backend_set_overlay_text(const char* text);
+
 /* Centre pixel of the last frame a present copied out, as 0xFFRRGGBB, or 0
  * before the first. Unlike _readback_center(), which on the draw engine path
  * reads the surface as it is now, this is what was shown. */
diff --git a/libs/video/tests/test_rsx_overlay.c b/libs/video/tests/test_rsx_overlay.c
new file mode 100644
index 0000000..ec14808
--- /dev/null
+++ b/libs/video/tests/test_rsx_overlay.c
@@ -0,0 +1,31 @@
+/* rsx_overlay.h: the built-in font draws known glyphs, sizes the bitmap and refuses what does not fit. */
+#include <stdio.h>
+#include "../rsx_overlay.h"
+
+static int fails;
+#define CHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); fails++; } } while (0)
+
+static int lit(const uint8_t* px, int w, int x, int y) { return px[((size_t)y * w + x) * 4] == 0xFF; }
+
+int main(void)
+{
+    static uint8_t px[400 * 40 * 4];
+    int w, h;
+    CHECK(rsx_overlay_render("60 FPS", 2, px, sizeof px / 4, &w, &h) == 0);
+    int ew, eh;
+    rsx_overlay_size(6, 2, &ew, &eh);
+    CHECK(w == ew && h == eh && w == 6 * 12 + 14 && h == 30);
+    /* '6' at scale 2: row 0 is 0x06 = 00110: columns 2 and 3 lit, 0 and 4 dark (the margin is 8 px) */
+    CHECK(!lit(px, w, 8 + 0, 8) && !lit(px, w, 8 + 2, 8) && lit(px, w, 8 + 4, 8) && lit(px, w, 8 + 6, 8) && !lit(px, w, 8 + 8, 8));
+    /* the margin and the gap between cells stay black; every pixel is opaque */
+    CHECK(!lit(px, w, 0, 0) && !lit(px, w, 8 + 5 * 2, 8 + 6 * 2));
+    CHECK(px[3] == 0xFF && px[(size_t)(w * h - 1) * 4 + 3] == 0xFF);
+    /* lower case draws as upper case; an unknown character is blank */
+    static uint8_t a[400 * 40 * 4], b[400 * 40 * 4];
+    int w2, h2;
+    CHECK(rsx_overlay_render("fps", 1, a, sizeof a / 4, &w2, &h2) == 0 && rsx_overlay_render("FPS", 1, b, sizeof b / 4, &w2, &h2) == 0);
+    CHECK(memcmp(a, b, (size_t)w2 * h2 * 4) == 0);
+    CHECK(rsx_overlay_render("FPS", 1, a, 10, &w2, &h2) == -1);   /* does not fit */
+    printf(fails ? "test_rsx_overlay: %d failure(s)\n" : "test_rsx_overlay: ok\n", fails);
+    return fails != 0;
+}
