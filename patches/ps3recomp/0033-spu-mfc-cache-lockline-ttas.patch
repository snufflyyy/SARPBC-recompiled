From b60b1bf36c9ad5bfae14383945d3c0866b02200f Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Mon, 19 Oct 2026 11:17:34 -0500
Subject: [PATCH] spu: mfc_for caches its engine, staging channels skip it;
 POSIX lock-line lock waits with TTAS+pause+yield

mfc_for took the registry read lock on every MFC channel access. Only
MFC_Cmd, WrTagUpdate and WrListStallAck use the engine, so the staging
writes and all MFC reads now skip the lookup, and the lookup itself is
served from a per-context cache validated by a registry generation that
every free bumps (plus an owner check for struct copies).

The POSIX spu_lockline_lock was a bare exchange loop; it now matches the
MSVC test-and-test-and-set with pause and a yield every 256 spins.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/spu/spu_channels.c  | 48 +++++++++++++++++++++++++++++++++++--
 runtime/spu/spu_coherency.c | 32 ++++++++++++++++++++++---
 runtime/spu/spu_context.h   |  9 +++++++
 3 files changed, 84 insertions(+), 5 deletions(-)

diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index c928292..79c5bef 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -292,11 +292,38 @@ typedef struct spu_mfc_slot {
 static spu_mfc_slot* s_mfc_slots;
 static SRWLOCK s_mfc_claim_lock = SRWLOCK_INIT;
 
+/* Registry generation, bumped under the writer lock before any node is freed.
+ * A context caches its node together with the generation it saw, and the
+ * cache is trusted only while nothing has been freed since, so it can never
+ * lead to a freed node, whatever later happens at the address of the context
+ * that cached it. Starts at 1 so a zeroed context (gen 0) never matches. */
+static volatile LONG s_mfc_gen = 1;
+
+/* Remember `slot` as ctx's engine. Runs with the registry lock held in either
+ * mode, so the generation cannot move between the lookup and this read. */
+static void mfc_cache_store(spu_context* ctx, spu_mfc_slot* slot)
+{
+    ctx->mfc_cache = slot;
+    ctx->mfc_cache_gen = (uint32_t)s_mfc_gen;
+}
+
 static mfc_engine* mfc_for(spu_context* ctx)
 {
+    /* Hot path, no lock. Every MFC command used to take the registry's read
+     * lock, and 50+ SPU task threads polling one lock line kept it so busy
+     * that a job needing the writer side starved (glibc's reader preference)
+     * or queued behind dozens of readers. A node is stable while its context
+     * is in use (release is legal only after the owner stops), so past the
+     * generation check the one question left is whether the cache belongs to
+     * this address: a struct copy of a context carries its original's cache. */
+    spu_mfc_slot* cached = (spu_mfc_slot*)ctx->mfc_cache;
+    if (cached && ctx->mfc_cache_gen == (uint32_t)s_mfc_gen && cached->ctx == ctx)
+        return &cached->mfc;
+
     AcquireSRWLockShared(&s_mfc_claim_lock);
     for (spu_mfc_slot* slot = s_mfc_slots; slot; slot = slot->next) {
         if (slot->ctx == ctx) {
+            mfc_cache_store(ctx, slot);
             ReleaseSRWLockShared(&s_mfc_claim_lock);
             return &slot->mfc;
         }
@@ -308,6 +335,7 @@ static mfc_engine* mfc_for(spu_context* ctx)
     AcquireSRWLockExclusive(&s_mfc_claim_lock);
     for (spu_mfc_slot* slot = s_mfc_slots; slot; slot = slot->next) {
         if (slot->ctx == ctx) {
+            mfc_cache_store(ctx, slot);
             ReleaseSRWLockExclusive(&s_mfc_claim_lock);
             return &slot->mfc;
         }
@@ -322,6 +350,7 @@ static mfc_engine* mfc_for(spu_context* ctx)
     mfc_engine_init(&slot->mfc);
     slot->next = s_mfc_slots;
     s_mfc_slots = slot;
+    mfc_cache_store(ctx, slot);
     ReleaseSRWLockExclusive(&s_mfc_claim_lock);
     return &slot->mfc;
 }
@@ -334,6 +363,7 @@ void spu_mfc_release(spu_context* ctx)
         if ((*link)->ctx != ctx) continue;
         spu_mfc_slot* slot = *link;
         *link = slot->next;
+        InterlockedIncrement(&s_mfc_gen);   /* before the free: no cache outlives it */
         free(slot);
         break;
     }
@@ -350,6 +380,7 @@ void spu_mfc_forget_range(uintptr_t lo, uintptr_t hi)
         uintptr_t owner = (uintptr_t)slot->ctx;
         if (owner >= lo && owner < hi) {
             *link = slot->next;
+            InterlockedIncrement(&s_mfc_gen);
             free(slot);
         } else {
             link = &slot->next;
@@ -782,6 +813,13 @@ static int channel_is_mfc(uint32_t ch)
     }
 }
 
+/* MFC channel writes that reach the engine in spu_dma.h's mfc_channel_write;
+ * the others only store into the context's staging registers. */
+static int channel_uses_engine(uint32_t ch)
+{
+    return ch == MFC_Cmd || ch == MFC_WrTagUpdate || ch == MFC_WrListStallAck;
+}
+
 /* ===========================================================================
  * Channel write
  * ===========================================================================*/
@@ -804,7 +842,11 @@ void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
          * not the plain GET/PUT the DMA engine would do. */
         if (channel == MFC_Cmd && spu_mfc_atomic(ctx, v))
             return;
-        mfc_channel_write(mfc_for(ctx), ctx, channel, v);
+        /* The staging registers (LSA, EAH, EAL, Size, TagID, WrTagMask) live
+         * in the context. Only a command, a tag-status update and a stall ack
+         * reach the engine, so only those look it up. */
+        mfc_channel_write(channel_uses_engine(channel) ? mfc_for(ctx) : NULL,
+                          ctx, channel, v);
         /* MFC tag-status-update EVENT producer (channel-stall milestone). Our
          * DMA completes synchronously, so the instant the program arms tag
          * notification (MFC_WrTagUpdate with a non-zero mode = any/all), the
@@ -1028,7 +1070,9 @@ u128 spu_rdch(spu_context* ctx, uint32_t channel)
             (unsigned long long)s_c[8],(unsigned long long)s_c[9]); } }
 
     if (channel_is_mfc(channel)) {
-        v = mfc_channel_read(mfc_for(ctx), ctx, channel);
+        /* Every MFC read (RdTagStat, RdTagMask, RdListStallStat, RdAtomicStat)
+         * is context state, so no engine lookup. */
+        v = mfc_channel_read(NULL, ctx, channel);
         return spu_make_preferred_u32(v);
     }
 
diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
index 923d8bd..7aa441d 100644
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -51,9 +51,35 @@ void spu_lockline_lock(void)
 void spu_lockline_unlock(void) { _InterlockedExchange(&g_lockline, 0); }
 #else
 #include <stdatomic.h>
-static atomic_flag g_lockline = ATOMIC_FLAG_INIT;
-void spu_lockline_lock(void)   { while (atomic_flag_test_and_set_explicit(&g_lockline, memory_order_acquire)) { } }
-void spu_lockline_unlock(void) { atomic_flag_clear_explicit(&g_lockline, memory_order_release); }
+#include <sched.h>     /* sched_yield */
+#if defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#define SPU_LOCKLINE_PAUSE() _mm_pause()
+#elif defined(__aarch64__) || defined(__arm__)
+#define SPU_LOCKLINE_PAUSE() __asm__ __volatile__("yield" ::: "memory")
+#else
+#define SPU_LOCKLINE_PAUSE() ((void)0)
+#endif
+/* The same test-and-test-and-set as the MSVC path. This side used to be a bare
+ * exchange loop, and on Linux that is what a 01.09 SARPBC boot spent its cores
+ * on: 90+ PhysX task threads re-reserving one line (GETLLAR at LS 0x32B44) all
+ * hammered the lock word with locked writes, so the holder's own unlock queued
+ * behind them and every SPU atomic in the process slowed down with it. Spinning
+ * on a plain load keeps the line shared until it is released, and the yield
+ * lets a preempted holder run on a host that has more SPU threads than cores.
+ * Same lock, same critical sections: only the waiting changed. */
+static atomic_int g_lockline = 0;
+void spu_lockline_lock(void)
+{
+    unsigned spins = 0;
+    while (atomic_exchange_explicit(&g_lockline, 1, memory_order_acquire)) {
+        do {
+            SPU_LOCKLINE_PAUSE();
+            if (++spins >= 256) { spins = 0; sched_yield(); }
+        } while (atomic_load_explicit(&g_lockline, memory_order_relaxed));
+    }
+}
+void spu_lockline_unlock(void) { atomic_store_explicit(&g_lockline, 0, memory_order_release); }
 #endif
 
 /* ===========================================================================
diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index fa88c3f..53c63a2 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -260,6 +260,15 @@ typedef struct spu_context {
     uint32_t mfc_tag_mask;
     uint32_t mfc_tag_status;
 
+    /* This context's private MFC engine, cached by mfc_for (spu_channels.c)
+     * so the hot channel path does not take the registry lock. Only a hint:
+     * it is used while mfc_cache_gen still equals the registry generation,
+     * which every engine release bumps, and while the cached node still
+     * names this context (a struct copy of a context keeps the pointer but
+     * not the address). Zero, as spu_context_init leaves it, means none. */
+    void*    mfc_cache;
+    uint32_t mfc_cache_gen;
+
     /* Atomic reservation state (GETLLAR/PUTLLC lock-line semantics). Multiple
      * SPU kernel threads share a lock-free queue in main memory; PUTLLC must
      * FAIL if the reserved 128-byte line changed since GETLLAR, or concurrent
-- 
2.55.0

