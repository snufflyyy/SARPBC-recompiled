-        /* Stop at the drain's return point too: it sits mid-function, so it is
-         * no lifted entry, and a job's return would otherwise run on through
-         * the caller's code (GH3's song-freeze; see drain_ret_pc). */
+        /* Stop at the drain's return point too: it sits mid-function, so it is
+         * no lifted entry, and a job's return would otherwise run on through
+         * the caller's code (GH3's song-freeze; see drain_ret_pc). */
         const uint32_t return_pc = ctx->drain_ret_pc;
         uint32_t result = spu_interp_run_until(ctx, pc, return_pc);
         /* A live interpreter rejoin is a transfer, not a host return. Nested
diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
index 923d8bd..7aa441d 100644
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -51,9 +51,35 @@ void spu_lockline_lock(void)
 void spu_lockline_unlock(void) { _InterlockedExchange(&g_lockline, 0); }
 #else
 #include <stdatomic.h>
-static atomic_flag g_lockline = ATOMIC_FLAG_INIT;
-void spu_lockline_lock(void)   { while (atomic_flag_test_and_set_explicit(&g_lockline, memory_order_acquire)) { } }
-void spu_lockline_unlock(void) { atomic_flag_clear_explicit(&g_lockline, memory_order_release); }
+#include <sched.h>     /* sched_yield */
+#if defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#define SPU_LOCKLINE_PAUSE() _mm_pause()
+#elif defined(__aarch64__) || defined(__arm__)
+#define SPU_LOCKLINE_PAUSE() __asm__ __volatile__("yield" ::: "memory")
+#else
+#define SPU_LOCKLINE_PAUSE() ((void)0)
+#endif
+/* The same test-and-test-and-set as the MSVC path. This side used to be a bare
+ * exchange loop, and on Linux that is what a 01.09 SARPBC boot spent its cores
+ * on: 90+ PhysX task threads re-reserving one line (GETLLAR at LS 0x32B44) all
+ * hammered the lock word with locked writes, so the holder's own unlock queued
+ * behind them and every SPU atomic in the process slowed down with it. Spinning
+ * on a plain load keeps the line shared until it is released, and the yield
+ * lets a preempted holder run on a host that has more SPU threads than cores.
+ * Same lock, same critical sections: only the waiting changed. */
+static atomic_int g_lockline = 0;
+void spu_lockline_lock(void)
+{
+    unsigned spins = 0;
+    while (atomic_exchange_explicit(&g_lockline, 1, memory_order_acquire)) {
+        do {
+            SPU_LOCKLINE_PAUSE();
+            if (++spins >= 256) { spins = 0; sched_yield(); }
+        } while (atomic_load_explicit(&g_lockline, memory_order_relaxed));
+    }
+}
+void spu_lockline_unlock(void) { atomic_store_explicit(&g_lockline, 0, memory_order_release); }
 #endif
 
