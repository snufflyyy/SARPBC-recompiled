+    spu__ff_tally_lanes(op, m, x, y, z, negp, negc);
 }
 SPU__NV_SLOW uint32x4_t spu__fa_fix(uint32x4_t r, uint32x4_t ok, uint32x4_t a, uint32x4_t b, uint32_t negb) {
     if (spu__ff_enabled()) spu__ff_tally(0, ok, a, veorq_u32(b, vdupq_n_u32(negb)), b, 0, 0);
@@ -837,6 +851,7 @@ SPU__NV_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__nv_fma(a, b,
  * product of two 24-bit significands is exact in double, so a compiler contracting a multiply
  * and an add into an FMA cannot change any rounding here. */
 #include <immintrin.h>
+#define SPU_FLOAT_SIMD "avx2"
 #define SPU__X8_INLINE static inline __attribute__((always_inline))
 #define SPU__X8_SLOW   static __attribute__((noinline, cold, unused))
 SPU__X8_INLINE __m128i spu__x8_bexp(__m128i x) { return _mm_srli_epi32(_mm_slli_epi32(x, 1), 24); }
@@ -925,6 +940,124 @@ SPU__X8_INLINE u128 spu__x8_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t
 SPU__X8_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__x8_fma(a, b, c, 0, 0); }            /* a*b + c */
 SPU__X8_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__x8_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
 SPU__X8_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__x8_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
+#elif (defined(__SSE2__) || defined(_M_X64) || defined(_M_AMD64)) && !defined(SPU_SCALAR_HELPERS)
+/* x86: the NEON fast path above, in SSE2 (baseline x86-64, so no build flag is needed). Same
+ * method and same lane rules: widen to two f64x2 halves (exact), operate, clear the 29 low
+ * significand bits, narrow (exact); a lane that is not an ordinary single or a true zero, or
+ * whose result leaves the normal range, or (fma) that rounded onto a 24-bit boundary, is redone
+ * by the scalar path. SSE2 has no 64-bit compares, so the double results are judged on their
+ * high and low 32-bit halves, gathered four lanes to a vector (_mm_shuffle_ps). The double
+ * arithmetic is IEEE round-to-nearest from MXCSR, as the scalar fast path assumes; the narrowing
+ * is exact, so its rounding mode does not matter. The product is exact (24 x 24 bits < 53), so
+ * a compiler that fuses the mul and add into an FMA (-mfma, -ffp-contract=fast) cannot change a result.
+ * tests/test_spu_float_sse.c checks it bit for bit against the exact path; on a Ryzen 7 5700X
+ * (clang -O2) an fma+fm pair takes 12 ns, against 33 ns for the per-lane scalar fast path. */
+#include <emmintrin.h>
+#define SPU_FLOAT_SIMD "sse2"
+SPU__NV_INLINE __m128i spu__xv_ld(u128 a) { return _mm_loadu_si128((const __m128i*)(const void*)a._u32); }
+SPU__NV_INLINE u128 spu__xv_u128(__m128i v) { u128 r; _mm_storeu_si128((__m128i*)(void*)r._u32, v); return r; }
+#define SPU__XV_LANES(v, m) uint32_t m[4]; _mm_storeu_si128((__m128i*)(void*)m, v)
+SPU__NV_INLINE __m128i spu__xv_bexp(__m128i x) { return _mm_srli_epi32(_mm_slli_epi32(x, 1), 24); }
+SPU__NV_INLINE __m128i spu__xv_iszero(__m128i x) { return _mm_cmpeq_epi32(_mm_slli_epi32(x, 1), _mm_setzero_si128()); }   /* +-0 */
+/* An ordinary single (biased exponent 1..254) or a true zero; exponent-0 words with a nonzero
+ * fraction are zero on the SPU but not in double, so they go to the fix-up. */
+SPU__NV_INLINE __m128i spu__xv_plain0(__m128i x) {
+    const __m128i be = spu__xv_bexp(x);
+    return _mm_or_si128(_mm_and_si128(_mm_cmpgt_epi32(be, _mm_setzero_si128()), _mm_cmplt_epi32(be, _mm_set1_epi32(255))),
+                        spu__xv_iszero(x));
+}
+SPU__NV_INLINE __m128d spu__xv_lo(__m128i x) { return _mm_cvtps_pd(_mm_castsi128_ps(x)); }
+SPU__NV_INLINE __m128d spu__xv_hi(__m128i x) { return _mm_cvtps_pd(_mm_castsi128_ps(_mm_unpackhi_epi64(x, x))); }
+SPU__NV_INLINE __m128i spu__xv_dw_hi(__m128d lo, __m128d hi) {   /* high halves of the four doubles */
+    return _mm_castps_si128(_mm_shuffle_ps(_mm_castpd_ps(lo), _mm_castpd_ps(hi), _MM_SHUFFLE(3, 1, 3, 1)));
+}
+SPU__NV_INLINE __m128i spu__xv_dw_lo(__m128d lo, __m128d hi) {   /* low halves */
+    return _mm_castps_si128(_mm_shuffle_ps(_mm_castpd_ps(lo), _mm_castpd_ps(hi), _MM_SHUFFLE(2, 0, 2, 0)));
+}
+/* The four doubles truncated to singles, as spu__nv_trunc0: *ok marks the lanes whose result is
+ * a normal single (and, given the exact rounding errors elo/ehi, was not both rounded and on a
+ * 24-bit boundary) or an exact zero; the sign of a zero result is cleared (the SPU never gives -0). */
+SPU__NV_INLINE __m128i spu__xv_trunc0(__m128d lo, __m128d hi, __m128i* ok, const __m128d* elo, const __m128d* ehi) {
+    const __m128i H = spu__xv_dw_hi(lo, hi), L = spu__xv_dw_lo(lo, hi), z = _mm_setzero_si128();
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(H, 20), _mm_set1_epi32(0x7FF));              /* biased, 1023 */
+    __m128i good = _mm_and_si128(_mm_cmpgt_epi32(e, _mm_set1_epi32(1023 - 127)), _mm_cmplt_epi32(e, _mm_set1_epi32(1023 + 128)));
+    if (elo) {
+        const __m128i exact = spu__xv_dw_lo(_mm_cmpeq_pd(*elo, _mm_setzero_pd()), _mm_cmpeq_pd(*ehi, _mm_setzero_pd()));
+        const __m128i onb = _mm_cmpeq_epi32(_mm_and_si128(L, _mm_set1_epi32(0x1FFFFFFF)), z);   /* on a boundary */
+        good = _mm_and_si128(good, _mm_or_si128(_mm_andnot_si128(onb, _mm_set1_epi32(-1)), exact));
+    }
+    const __m128i az = _mm_and_si128(_mm_cmpeq_epi32(_mm_slli_epi32(H, 1), z), _mm_cmpeq_epi32(L, z));   /* +-0 */
+    *ok = _mm_or_si128(good, az);
+    const __m128d m = _mm_castsi128_pd(_mm_set_epi32(-1, (int)0xE0000000u, -1, (int)0xE0000000u));
+    const __m128 f = _mm_movelh_ps(_mm_cvtpd_ps(_mm_and_pd(lo, m)), _mm_cvtpd_ps(_mm_and_pd(hi, m)));
+    return _mm_andnot_si128(_mm_and_si128(az, _mm_set1_epi32((int)0x80000000u)), _mm_castps_si128(f));
+}
+SPU__NV_INLINE int spu__xv_all4(__m128i m) { return _mm_movemask_ps(_mm_castsi128_ps(m)) == 0xF; }
+/* The lanes of r not marked in ok, recomputed one by one (scalar fast path, else exact). */
+SPU__NV_SLOW __m128i spu__xv_fa_fix(__m128i r, __m128i ok, __m128i a, __m128i b, uint32_t negb) {
+    SPU__XV_LANES(r, o); SPU__XV_LANES(ok, m); SPU__XV_LANES(a, x); SPU__XV_LANES(b, y);
+    if (spu__ff_enabled()) { uint32_t ys[4]; for (int i = 0; i < 4; i++) ys[i] = y[i] ^ negb;
+                             spu__ff_tally_lanes(0, m, x, ys, ys, 0, 0); }
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fa_any(x[i], y[i] ^ negb);
+    return _mm_loadu_si128((const __m128i*)(const void*)o);
+}
+SPU__NV_SLOW __m128i spu__xv_fm_fix(__m128i r, __m128i ok, __m128i a, __m128i b) {
+    SPU__XV_LANES(r, o); SPU__XV_LANES(ok, m); SPU__XV_LANES(a, x); SPU__XV_LANES(b, y);
+    if (spu__ff_enabled()) spu__ff_tally_lanes(1, m, x, y, y, 0, 0);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fm_any(x[i], y[i]);
+    return _mm_loadu_si128((const __m128i*)(const void*)o);
+}
+SPU__NV_SLOW __m128i spu__xv_fma_fix(__m128i r, __m128i ok, __m128i a, __m128i b, __m128i c, uint32_t negp, uint32_t negc) {
+    SPU__XV_LANES(r, o); SPU__XV_LANES(ok, m); SPU__XV_LANES(a, x); SPU__XV_LANES(b, y); SPU__XV_LANES(c, z);
+    if (spu__ff_enabled()) spu__ff_tally_lanes(2, m, x, y, z, negp, negc);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fma_any(x[i], y[i], z[i], negp, negc);
+    return _mm_loadu_si128((const __m128i*)(const void*)o);
+}
+SPU__NV_INLINE u128 spu__xv_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i xa = spu__xv_ld(a), yb = spu__xv_ld(b);
+    const __m128i x = xa, y = _mm_xor_si128(yb, _mm_set1_epi32((int)negb));
+    /* the exponent-gap limit (|ex - ey| <= 29) applies only between two nonzero terms */
+    const __m128i d = _mm_sub_epi32(spu__xv_bexp(x), spu__xv_bexp(y));
+    const __m128i near = _mm_and_si128(_mm_cmplt_epi32(d, _mm_set1_epi32(30)), _mm_cmpgt_epi32(d, _mm_set1_epi32(-30)));
+    const __m128i pre = _mm_and_si128(_mm_and_si128(spu__xv_plain0(x), spu__xv_plain0(y)),
+                                      _mm_or_si128(near, _mm_or_si128(spu__xv_iszero(x), spu__xv_iszero(y))));
+    __m128i ok;
+    __m128i r = spu__xv_trunc0(_mm_add_pd(spu__xv_lo(x), spu__xv_lo(y)), _mm_add_pd(spu__xv_hi(x), spu__xv_hi(y)), &ok, NULL, NULL);
+    ok = _mm_and_si128(ok, pre);
+    if (!spu__xv_all4(ok)) r = spu__xv_fa_fix(r, ok, xa, yb, negb);
+    return spu__xv_u128(r);
+}
+SPU__NV_INLINE u128 spu_fa(u128 a, u128 b) { return spu__xv_fa(a, b, 0); }
+SPU__NV_INLINE u128 spu_fs(u128 a, u128 b) { return spu__xv_fa(a, b, 0x80000000u); }
+SPU__NV_INLINE u128 spu_fm(u128 a, u128 b) {
+    const __m128i x = spu__xv_ld(a), y = spu__xv_ld(b);
+    __m128i ok;
+    __m128i r = spu__xv_trunc0(_mm_mul_pd(spu__xv_lo(x), spu__xv_lo(y)), _mm_mul_pd(spu__xv_hi(x), spu__xv_hi(y)), &ok, NULL, NULL);
+    ok = _mm_and_si128(ok, _mm_and_si128(spu__xv_plain0(x), spu__xv_plain0(y)));
+    if (!spu__xv_all4(ok)) r = spu__xv_fm_fix(r, ok, x, y);
+    return spu__xv_u128(r);
+}
+/* p + z with its exact rounding error (TwoSum, as spu__nv_twosum). */
+SPU__NV_INLINE __m128d spu__xv_twosum(__m128d p, __m128d z, __m128d* err) {
+    const __m128d s = _mm_add_pd(p, z), bb = _mm_sub_pd(s, p);
+    *err = _mm_add_pd(_mm_sub_pd(p, _mm_sub_pd(s, bb)), _mm_sub_pd(z, bb));
+    return s;
+}
+SPU__NV_INLINE u128 spu__xv_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i xa = spu__xv_ld(a), y = spu__xv_ld(b), zc = spu__xv_ld(c);
+    const __m128i x = _mm_xor_si128(xa, _mm_set1_epi32((int)negp)), z = _mm_xor_si128(zc, _mm_set1_epi32((int)negc));
+    __m128d elo, ehi;
+    const __m128d slo = spu__xv_twosum(_mm_mul_pd(spu__xv_lo(x), spu__xv_lo(y)), spu__xv_lo(z), &elo);
+    const __m128d shi = spu__xv_twosum(_mm_mul_pd(spu__xv_hi(x), spu__xv_hi(y)), spu__xv_hi(z), &ehi);
+    __m128i ok;
+    __m128i r = spu__xv_trunc0(slo, shi, &ok, &elo, &ehi);
+    ok = _mm_and_si128(ok, _mm_and_si128(_mm_and_si128(spu__xv_plain0(x), spu__xv_plain0(y)), spu__xv_plain0(z)));
+    if (!spu__xv_all4(ok)) r = spu__xv_fma_fix(r, ok, xa, y, zc, negp, negc);
+    return spu__xv_u128(r);
+}
+SPU__NV_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__xv_fma(a, b, c, 0, 0); }            /* a*b + c */
+SPU__NV_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__xv_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
+SPU__NV_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__xv_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
 #else
 static inline u128 spu_fa(u128 a, u128 b) { return spu__fa_s(a, b); }
 static inline u128 spu_fs(u128 a, u128 b) { return spu__fs_s(a, b); }
diff --git a/runtime/spu/tests/test_spu_float_sse.c b/runtime/spu/tests/test_spu_float_sse.c
new file mode 100644
index 0000000..e999d2d
--- /dev/null
+++ b/runtime/spu/tests/test_spu_float_sse.c
@@ -0,0 +1,204 @@
+/* The x86 (SSE2) spu_fa/fs/fm/fma/fms/fnms must be bit-identical to the scalar
+ * references (spu_*_ref) for every input: random words, ordinary floats, the
+ * normal/extended-range boundaries, zeros and denormals, mixed per lane. The
+ * same cases as test_spu_float_neon.c, run on whichever vector path the build
+ * has (SPU_FLOAT_SIMD). Prints a rough speed comparison too. On x86-64:
+ *   cc -O2 -I.. -I../.. -I../../.. test_spu_float_sse.c -o t -lm && ./t
+ * (also with -march=x86-64-v2 / -mavx2 -mfma, so a compiler that contracts
+ * mul+add into fma is covered). */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (uint32_t)(s_rng >> 16);
+}
+
+static uint32_t rnd_float(void)
+{
+    uint32_t sign = (rnd32() & 1u) << 31, man = rnd32() & 0x7FFFFFu, e;
+    switch (rnd32() % 10) {
+    case 0: e = 0; break;                              /* zero / denormal */
+    case 1: e = 1 + rnd32() % 4; break;                /* bottom of normal range */
+    case 2: e = 248 + rnd32() % 8; break;              /* top, into extended range */
+    case 3: return rnd32();                            /* anything */
+    case 4: return sign;                               /* +-0 */
+    default: e = 110 + rnd32() % 36; break;            /* ordinary */
+    }
+    return sign | (e << 23) | man;
+}
+
+int main(void)
+{
+#if !defined(SPU_FLOAT_SIMD)
+    puts("test_spu_float_sse: no SIMD float path, nothing to compare");
+    return 0;
+#else
+    long bad = 0;
+    const long N = 4000000;
+    for (long it = 0; it < N; it++) {
+        u128 a, b, c, got, ref;
+        for (int i = 0; i < 4; i++) { a._u32[i] = rnd_float(); b._u32[i] = rnd_float(); c._u32[i] = rnd_float(); }
+        /* close magnitudes stress cancellation in fa/fs and fma */
+        if (it % 7 == 0) for (int i = 0; i < 4; i++) b._u32[i] = (a._u32[i] ^ 0x80000000u) + (rnd32() & 0xFF);
+        const int op = (int)(it % 6);
+        switch (op) {
+        case 0: got = spu_fa(a, b);      ref = spu_fa_ref(a, b); break;
+        case 1: got = spu_fs(a, b);      ref = spu_fs_ref(a, b); break;
+        case 2: got = spu_fm(a, b);      ref = spu_fm_ref(a, b); break;
+        case 3: got = spu_fma(a, b, c);  ref = spu_fma_ref(a, b, c); break;
+        case 4: got = spu_fms(a, b, c);  ref = spu_fms_ref(a, b, c); break;
+        default: got = spu_fnms(a, b, c); ref = spu_fnms_ref(a, b, c); break;
+        }
+        if (memcmp(&got, &ref, 16)) {
+            if (bad++ < 10)
+                printf("MISMATCH op=%d a=%08X %08X %08X %08X b=%08X %08X %08X %08X c=%08X %08X %08X %08X\n"
+                       "  got=%08X %08X %08X %08X ref=%08X %08X %08X %08X\n", op,
+                       a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3],
+                       c._u32[0], c._u32[1], c._u32[2], c._u32[3],
+                       got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+                       ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+        }
+    }
+    if (bad) { printf("test_spu_float_sse: %ld mismatches in %ld cases\n", bad, N); return 1; }
+    printf("test_spu_float_sse: ok (%ld random cases)\n", N);
+
+    /* fma's fast path trusts a double sum unless it was rounded (TwoSum error != 0) AND landed
+     * on a 24-bit boundary. Random operands almost never reach either side of that test, so aim
+     * at it: products of short (dyadic) significands, plus an addend that is either dyadic too
+     * (exact sums: must stay correct on the fast path) or a lone power of two far below the
+     * product (the sum rounds back onto the product -- a boundary -- and must go exact:
+     * 1*1 - 2^-60 truncates to 0x3F7FFFFF, not 1.0). */
+    {
+        long hits = 0, exact_sums = 0;
+        const long M = 2000000;
+        for (long it = 0; it < M; it++) {
+            u128 a, b, c, got, ref;
+            for (int i = 0; i < 4; i++) {
+                const uint32_t ea = 115 + rnd32() % 24, eb = 115 + rnd32() % 24;
+                a._u32[i] = ((rnd32() & 1u) << 31) | (ea << 23) | ((rnd32() & 7u) << 20);
+                b._u32[i] = ((rnd32() & 1u) << 31) | (eb << 23) | ((rnd32() & 7u) << 20);
+                const int ep = (int)ea + (int)eb - 127;                /* product's biased exponent */
+                int ec;
+                if (rnd32() & 1) { ec = ep - (int)(rnd32() % 24); c._u32[i] = (rnd32() & 7u) << 20; }
+                else             { ec = ep - 25 - (int)(rnd32() % 70); c._u32[i] = 0; }
+                if (ec < 1) ec = 1;
+                if (ec > 254) ec = 254;
+                c._u32[i] |= ((rnd32() & 1u) << 31) | ((uint32_t)ec << 23);
+                const double pd = (double)spu__sf_f(a._u32[i]) * (double)spu__sf_f(b._u32[i]);
+                const double zd = (double)spu__sf_f(c._u32[i]), sd = pd + zd, bb = sd - pd;
+                const double er = (pd - (sd - bb)) + (zd - bb);
+                uint64_t su; memcpy(&su, &sd, 8);
+                hits += er != 0.0 && !(su & 0x1FFFFFFFull);
+                exact_sums += er == 0.0;
+            }
+            const int op = (int)(it % 3);
+            if (op == 0)      { got = spu_fma(a, b, c);  ref = spu_fma_ref(a, b, c); }
+            else if (op == 1) { got = spu_fms(a, b, c);  ref = spu_fms_ref(a, b, c); }
+            else              { got = spu_fnms(a, b, c); ref = spu_fnms_ref(a, b, c); }
+            if (memcmp(&got, &ref, 16)) {
+                if (bad++ < 10)
+                    printf("MISMATCH (boundary) op=%d a=%08X b=%08X c=%08X got=%08X ref=%08X\n", op,
+                           a._u32[0], b._u32[0], c._u32[0], got._u32[0], ref._u32[0]);
+            }
+        }
+        u128 one, tiny; memset(&one, 0, 16); memset(&tiny, 0, 16);
+        one._u32[0] = 0x3F800000u; tiny._u32[0] = 0x80000000u | ((127u - 60u) << 23);   /* -2^-60 */
+        const u128 r = spu_fma(one, one, tiny);
+        if (r._u32[0] != 0x3F7FFFFFu) { printf("fma(1, 1, -2^-60) = %08X, want 3F7FFFFF\n", r._u32[0]); bad++; }
+        if (bad || !hits || !exact_sums) {
+            printf("test_spu_float_sse: boundary pass: %ld mismatches, %ld rounded-onto-boundary lanes, "
+                   "%ld exact sums\n", bad, hits, exact_sums);
+            return 1;
+        }
+        printf("test_spu_float_sse: ok (%ld boundary cases: %ld rounded onto a boundary, %ld exact sums)\n",
+               M, hits, exact_sums);
+    }
+
+    /* Zero lanes are handled on the vector path (T-0014), so aim at them: every operand lane is
+     * drawn from zeros of every kind (+0, -0, and exponent-0 words with a nonzero fraction, which
+     * the SPU reads as zero), extended-range values, and ordinary values, so all mixes of zero
+     * operand position, sign and neighbour occur. */
+    {
+        static const uint32_t zeros[] = { 0x00000000u, 0x80000000u, 0x00000001u, 0x007FFFFFu, 0x807FFFFFu, 0x80400000u };
+        long zcases = 0;
+        const long M = 2000000;
+        for (long it = 0; it < M; it++) {
+            u128 a, b, c, got, ref;
+            for (int i = 0; i < 4; i++) {
+                uint32_t* w[3] = { &a._u32[i], &b._u32[i], &c._u32[i] };
+                for (int k = 0; k < 3; k++) {
+                    const uint32_t r = rnd32() % 8;
+                    *w[k] = r < 3 ? zeros[rnd32() % 6]
+                          : r == 3 ? ((rnd32() & 1u) << 31) | (255u << 23) | (rnd32() & 0x7FFFFFu)
+                          : rnd_float();
+                }
+                zcases += !((a._u32[i] >> 23) & 0xFF) || !((b._u32[i] >> 23) & 0xFF) || !((c._u32[i] >> 23) & 0xFF);
+            }
+            const int op = (int)(it % 6);
+            switch (op) {
+            case 0: got = spu_fa(a, b);      ref = spu_fa_ref(a, b); break;
+            case 1: got = spu_fs(a, b);      ref = spu_fs_ref(a, b); break;
+            case 2: got = spu_fm(a, b);      ref = spu_fm_ref(a, b); break;
+            case 3: got = spu_fma(a, b, c);  ref = spu_fma_ref(a, b, c); break;
+            case 4: got = spu_fms(a, b, c);  ref = spu_fms_ref(a, b, c); break;
+            default: got = spu_fnms(a, b, c); ref = spu_fnms_ref(a, b, c); break;
+            }
+            if (memcmp(&got, &ref, 16)) {
+                if (bad++ < 10)
+                    printf("MISMATCH (zero) op=%d a=%08X %08X %08X %08X b=%08X %08X %08X %08X c=%08X %08X %08X %08X\n"
+                           "  got=%08X %08X %08X %08X ref=%08X %08X %08X %08X\n", op,
+                           a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3],
+                           c._u32[0], c._u32[1], c._u32[2], c._u32[3],
+                           got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+                           ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+            }
+        }
+        if (bad) { printf("test_spu_float_sse: %ld mismatches in the zero-lane pass\n", bad); return 1; }
+        printf("test_spu_float_sse: ok (%ld zero-lane cases, %ld lanes with a zero operand)\n", M, zcases);
+    }
+
+    /* The vector paths must not leave the thread in another rounding mode; double
+     * precision must still round to nearest: 1 + (2^-53 + 2^-60) -> 1 + 2^-52. */
+    {
+        u128 x, y; memset(&x, 0, 16); memset(&y, 0, 16);
+        x._u32[0] = 0x3FF00000u; y._u32[0] = 0x3CA02000u;          /* 1.0, 2^-53 + 2^-60 */
+        (void)spu_fa(x, y);                                          /* sets RZ */
+        u128 d = spu_dfa(x, y);
+        if (d._u32[0] != 0x3FF00000u || d._u32[1] != 1u) {
+            printf("test_spu_float_sse: dfa under RZ gave %08X%08X, want 3FF0000000000001\n", d._u32[0], d._u32[1]);
+            return 1;
+        }
+    }
+
+    /* speed on ordinary operands that stay ordinary */
+    static u128 in[256][3];
+    for (int k = 0; k < 256; k++)
+        for (int i = 0; i < 4; i++) {
+            in[k][0]._u32[i] = (rnd32() & 0x807FFFFFu) | ((120u + rnd32() % 16) << 23);
+            in[k][1]._u32[i] = (rnd32() & 0x807FFFFFu) | ((120u + rnd32() % 16) << 23);
+            in[k][2]._u32[i] = (rnd32() & 0x807FFFFFu) | ((120u + rnd32() % 16) << 23);
+        }
+    const int R = 20000000;
+    uint32_t acc = 0;
+    clock_t t0 = clock();
+    for (int i = 0; i < R; i++) { const u128* q = in[i & 255];
+        u128 r1 = spu_fma(q[0], q[1], q[2]), r2 = spu_fm(q[0], q[1]); acc += r1._u32[i & 3] ^ r2._u32[(i + 1) & 3]; }
+    clock_t t1 = clock();
+    for (int i = 0; i < R; i++) { const u128* q = in[i & 255];
+        u128 r1 = spu_fma_ref(q[0], q[1], q[2]), r2 = spu_fm_ref(q[0], q[1]); acc += r1._u32[i & 3] ^ r2._u32[(i + 1) & 3]; }
+    clock_t t2 = clock();
+    /* the per-lane scalar fast path: what x86 builds used before the SSE2 path */
+    for (int i = 0; i < R; i++) { const u128* q = in[i & 255];
+        u128 r1 = spu__fma_s(q[0], q[1], q[2]), r2 = spu__fm_s(q[0], q[1]); acc += r1._u32[i & 3] ^ r2._u32[(i + 1) & 3]; }
+    clock_t t3 = clock();
+    printf("fma+fm pair: " SPU_FLOAT_SIMD " %.1f ns, scalar fast path %.1f ns, exact %.1f ns (acc %u)\n",
+           (t1 - t0) * 1e9 / CLOCKS_PER_SEC / R, (t3 - t2) * 1e9 / CLOCKS_PER_SEC / R,
+           (t2 - t1) * 1e9 / CLOCKS_PER_SEC / R, acc);
+    return 0;
+#endif
+}
-- 
2.47.3

