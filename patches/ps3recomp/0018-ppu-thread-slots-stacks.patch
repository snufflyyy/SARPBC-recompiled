From 59dc05bb2c9d0c5f234ae9cef20814146cbcd1a7 Mon Sep 17 00:00:00 2001
From: soyjxck <soyjxck@users.noreply.github.com>
Date: Sun, 11 Oct 2026 21:05:26 +0100
Subject: [PATCH 1/2] sys_ppu_thread: a thread that has ended gives its slot
 and its stack back

A port stopped dead a quarter of an hour into play, on Windows, at the
end of a level: black screen, the game thread waiting for a physics
step that no thread would ever finish. The thread table has 64 slots
and the run had used the sixty-fourth. sys_ppu_thread_create returned
EAGAIN without a word, the title did not look, and waited for a thread
that was never started. Three things kept slots from coming back:

- Windows, every joined thread. A thread that ends in
  sys_ppu_thread_exit signals its joiner from inside that call and then
  unwinds to the thread procedure, whose epilogue stamped the slot
  FINISHED again. The joiner did not wait for it: it freed the slot, and
  the epilogue then wrote FINISHED over FREE for good. (POSIX joins the
  host thread first and never saw it.) The epilogue now only stamps a
  thread that returned from its entry, and the joiner waits for the
  host thread to be out before the slot is anyone else's.

- Every thread made without SYS_PPU_THREAD_CREATE_JOINABLE. The flags
  were ignored and every thread made joinable, so one that nobody joins
  kept its slot when it ended. Such a thread now cannot be joined and
  frees itself, as on the console. Drakengard 3 makes its SaveData,
  LoadData, DLCCheck and PreLoadMovie threads that way.

- A detached thread that called sys_ppu_thread_exit was freed there and
  stamped FINISHED by the epilogue afterwards. It is now freed by the
  epilogue, once it is out of its guest code.

Guest stacks went the same way, more slowly: vm_stack_allocate only
moves forward through its 256 MB, and that title makes seven megabytes
of thread stacks in a quarter of an hour. A thread that has ended hands
its stack to the next one of the same size, zeroed.

sys_ppu_thread_create now says so when no slot is free, and logs the
flags. PPU_THREAD_SLOTS=<n> uses the first n slots only, to try a
title's thread turnover against a small table.

Measured in Drakengard 3, hands-off from boot into chapter 1 and four
minutes of play: 31 threads made in each case; before, the highest
thread id was 31 or 32 (no slot ever used twice); now 23, the PhysX
pair using the same two slots at every level change and the four
unjoined kinds sharing one, and the run completes with
PPU_THREAD_SLOTS=24.

The smoke title makes 300 more threads than it did, half joined and
half without the joinable flag, and checks that each can be made and
that the second kind cannot be joined; with the old thread code it
fails. Its own thread, and the host's --threads test, asked for a
thread they join without the joinable flag: they pass it now.
---
 runtime/host/host_posix.c              |   2 +-
 runtime/ppu/tests/smoke/smoke_recomp.c |  58 ++++++++++-
 runtime/syscalls/sys_ppu_thread.c      | 132 +++++++++++++++++++++----
 3 files changed, 171 insertions(+), 21 deletions(-)

diff --git a/runtime/host/host_posix.c b/runtime/host/host_posix.c
index 1afc516..66643b9 100644
--- a/runtime/host/host_posix.c
+++ b/runtime/host/host_posix.c
@@ -1098,7 +1098,7 @@ static int run_thread_check(void)
     ctx.gpr[5] = 0;            /* arg */
     ctx.gpr[6] = 1000;         /* priority */
     ctx.gpr[7] = 0x10000;      /* guest stack size */
-    ctx.gpr[8] = 0;            /* flags */
+    ctx.gpr[8] = 1;            /* flags: joinable (it is joined below) */
     ctx.gpr[9] = 0;            /* name */
     int64_t crc = sys_ppu_thread_create(&ctx);
     if (crc != 0) {
diff --git a/runtime/ppu/tests/smoke/smoke_recomp.c b/runtime/ppu/tests/smoke/smoke_recomp.c
index f4996d8..bb76447 100644
--- a/runtime/ppu/tests/smoke/smoke_recomp.c
+++ b/runtime/ppu/tests/smoke/smoke_recomp.c
@@ -190,6 +190,8 @@ static atomic_uint   g_mark_n;
  * busy host and the strict marker order below is not the scaffold's to
  * guarantee. The body waits on it before it marks anything. */
 static atomic_uint   g_create_marked;
+/* The threads of the churn (see _start) that have run. */
+static atomic_uint   g_churn_ran;
 
 /* Failures the guest found while running. Reported by smoke_verify, which is
  * the only thing that reads them. */
@@ -418,6 +420,15 @@ static void smoke_verify(void)
  * -----------------------------------------------------------------------*/
 void func_00010100(ppu_context* ctx)
 {
+    /* One of the churn's threads (see _start): out again at once, with its
+     * argument as its status. */
+    if ((uint32_t)ctx->gpr[3] != SMOKE_THREAD_ARG) {
+        const uint64_t status = ctx->gpr[3];
+        atomic_fetch_add(&g_churn_ran, 1u);
+        ctx->gpr[11] = SC_PPU_THREAD_EXIT;
+        ctx->gpr[3]  = status;
+        lv2_syscall(ctx);   /* does not return */
+    }
     g_body_host_tid = (unsigned long)GetCurrentThreadId();
     g_body_arg      = (uint32_t)ctx->gpr[3];
     /* Let the creator mark first (see g_create_marked); a sleep through the
@@ -498,7 +509,7 @@ void func_00010000(ppu_context* ctx)
     ctx->gpr[5]  = SMOKE_THREAD_ARG;      /* the new thread's r3 */
     ctx->gpr[6]  = 1000;                  /* priority            */
     ctx->gpr[7]  = 0x10000;               /* stack size          */
-    ctx->gpr[8]  = 0;                     /* flags               */
+    ctx->gpr[8]  = 1;                     /* flags: joinable     */
     ctx->gpr[9]  = SMOKE_THREAD_NAME;
     lv2_syscall(ctx);
     smoke_check((int32_t)ctx->gpr[3] == 0, "sys_ppu_thread_create failed");
@@ -516,6 +527,51 @@ void func_00010000(ppu_context* ctx)
                 "sys_ppu_thread_join handed back the wrong exit status");
     smoke_mark(ctx, SMOKE_STEP_THREAD_JOIN);
 
+    /* Thread slots come back. A title makes threads all through its run -- a
+     * pair for every level, a few for every movie and every save -- and the
+     * table has PPU_THREAD_MAX (64) slots: 300 here, one at a time, half of
+     * them joined and half made without the joinable flag, which nobody can
+     * join and which must give their slot back by themselves. (Both kinds
+     * once kept theirs: a port stopped dead a quarter of an hour in, at the
+     * sixty-fourth thread.) */
+    for (uint32_t i = 0; i < 300; i++) {
+        const int joinable = (i & 1u) == 0;
+        const uint32_t ran = atomic_load(&g_churn_ran);
+        ctx->gpr[11] = SC_PPU_THREAD_CREATE;
+        ctx->gpr[3]  = SMOKE_SC_TID;
+        ctx->gpr[4]  = SMOKE_OPD_THREAD;
+        ctx->gpr[5]  = 0x7000u + i;           /* not SMOKE_THREAD_ARG: a churn thread */
+        ctx->gpr[6]  = 1000;
+        ctx->gpr[7]  = 0x10000;
+        ctx->gpr[8]  = joinable ? 1 : 0;
+        ctx->gpr[9]  = SMOKE_THREAD_NAME;
+        lv2_syscall(ctx);
+        if ((int32_t)ctx->gpr[3] != 0) {
+            smoke_check(0, "a thread could not be made in the churn: a slot was not given back");
+            break;
+        }
+        if (joinable) {
+            ctx->gpr[11] = SC_PPU_THREAD_JOIN;
+            ctx->gpr[3]  = vm_read64(SMOKE_SC_TID);
+            ctx->gpr[4]  = SMOKE_SC_EXITSTAT;
+            lv2_syscall(ctx);
+            smoke_check((int32_t)ctx->gpr[3] == 0, "a churn thread could not be joined");
+            smoke_check((uint64_t)vm_read64(SMOKE_SC_EXITSTAT) == 0x7000u + i,
+                        "a churn thread's join handed back the wrong exit status");
+        } else {
+            /* Nobody can join it: wait for it to have run, and a moment more
+             * for it to be out, so that the slots in use stay few. */
+            for (int w = 0; w < 20000 && atomic_load(&g_churn_ran) == ran; w++) smoke_usleep(ctx, 100);
+            smoke_usleep(ctx, 500);
+            ctx->gpr[11] = SC_PPU_THREAD_JOIN;
+            ctx->gpr[3]  = vm_read64(SMOKE_SC_TID);
+            ctx->gpr[4]  = SMOKE_SC_EXITSTAT;
+            lv2_syscall(ctx);
+            smoke_check((int32_t)ctx->gpr[3] != 0, "a thread made without the joinable flag was joined");
+        }
+    }
+    smoke_check(atomic_load(&g_churn_ran) == 300u || atomic_load(&g_fail_n) != 0, "not every churn thread ran");
+
     /* Give the flip a display buffer to land on, then take the control
      * register's guest address: put and get live there, and writing put is how
      * a title tells the RSX there is work.
diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index 583d30f..7b951b0 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -78,16 +78,55 @@ static void table_unlock(void)
 #endif
 }
 
-/* Find a free slot. Returns index or -1. Must be called under lock. */
+/* Find a free slot. Returns index or -1. Must be called under lock.
+ * PPU_THREAD_SLOTS=<n> uses the first n only: a title's thread turnover
+ * against a table it would fill in minutes if slots were not given back. */
 static int find_free_slot(void)
 {
-    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+    static int slots = 0;
+    if (!slots) {
+        const char* e = getenv("PPU_THREAD_SLOTS");
+        slots = e ? atoi(e) : 0;
+        if (slots < 1 || slots > PPU_THREAD_MAX) slots = PPU_THREAD_MAX;
+    }
+    for (int i = 0; i < slots; i++) {
         if (g_ppu_threads[i].state == PPU_THREAD_STATE_FREE)
             return i;
     }
     return -1;
 }
 
+/* The guest stacks of threads that have ended, for the next thread that asks
+ * for one of the same size. vm_stack_allocate only moves forward through its
+ * 256 MB, and a title that starts threads for every level and movie (seven
+ * megabytes of them in a quarter of an hour of Drakengard 3) would come to
+ * the end of it in a long session. Under the table lock. */
+#define PPU_STACK_POOL 128
+static struct { uint32_t addr, size; } s_stack_pool[PPU_STACK_POOL];
+static int s_stack_pool_n;
+
+static uint32_t stack_take(uint32_t size)
+{
+    for (int i = 0; i < s_stack_pool_n; i++) {
+        if (s_stack_pool[i].size != size) continue;
+        const uint32_t addr = s_stack_pool[i].addr;
+        s_stack_pool[i] = s_stack_pool[--s_stack_pool_n];
+        memset(vm_to_host(addr), 0, size);   /* as a new one is */
+        return addr;
+    }
+    return vm_stack_allocate(&g_vm_stack_alloc, size);
+}
+
+/* Once the thread is out of its guest code for good. */
+static void stack_give(ppu_thread_info* t)
+{
+    if (!t->stack_addr || s_stack_pool_n >= PPU_STACK_POOL) return;
+    s_stack_pool[s_stack_pool_n].addr = t->stack_addr;
+    s_stack_pool[s_stack_pool_n].size = t->stack_size;
+    s_stack_pool_n++;
+    t->stack_addr = 0;
+}
+
 /* Find thread by ID. The ID is the index + 1 (0 is invalid). */
 static ppu_thread_info* find_thread(uint64_t thread_id)
 {
@@ -164,21 +203,34 @@ static void* ppu_host_thread_proc(void* param)
                 (unsigned long long)info->ctx.thread_id);
     }
 
-    /* Mark as finished */
+    /* Mark as finished -- where that is still this code's to do. A thread
+     * that ended in sys_ppu_thread_exit was stamped FINISHED there, with the
+     * status it gave, and has signalled its joiner; stamping it again here
+     * is what used to lose the slot. On Windows the joiner did not wait for
+     * this epilogue: it freed the slot, and the line that stood here then
+     * wrote FINISHED over FREE, for good. Every joined thread cost one of
+     * the PPU_THREAD_MAX slots, and a title that makes a pair of threads
+     * for each level and each movie (Drakengard 3's PhysX and Bink threads)
+     * had none left after a quarter of an hour: sys_ppu_thread_create
+     * failed, and the game waited on a thread that was never started. */
     table_lock();
-    info->exit_status = (int64_t)info->ctx.gpr[3];
-
+#ifdef _WIN32
+    HANDLE done = info->finish_event;     /* read before the slot can be anyone else's */
+#endif
     if (info->state == PPU_THREAD_STATE_DETACHED) {
         /* Detached threads self-clean */
+        stack_give(info);
         info->state = PPU_THREAD_STATE_FREE;
-    } else {
+    } else if (info->state == PPU_THREAD_STATE_RUNNING) {
+        /* It returned from its entry. */
+        info->exit_status = (int64_t)info->ctx.gpr[3];
         info->state = PPU_THREAD_STATE_FINISHED;
     }
     table_unlock();
 
     /* Signal anyone waiting for join */
 #ifdef _WIN32
-    SetEvent(info->finish_event);
+    if (done) SetEvent(done);
     return 0;
 #else
     pthread_mutex_lock(&info->finish_mutex);
@@ -332,7 +384,7 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
     uint64_t arg          = LV2_ARG_U64(ctx, 2);
     int32_t  priority     = LV2_ARG_S32(ctx, 3);
     uint32_t stack_size   = LV2_ARG_U32(ctx, 4);
-    /* uint64_t flags     = LV2_ARG_U64(ctx, 5); */
+    uint64_t flags        = LV2_ARG_U64(ctx, 5);
     uint32_t name_addr    = LV2_ARG_PTR(ctx, 6);
 
     if (stack_size == 0) stack_size = VM_PPU_STACK_SIZE;
@@ -343,6 +395,14 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
     int slot = find_free_slot();
     if (slot < 0) {
         table_unlock();
+        { int used = 0, zombies = 0;
+          for (int i = 0; i < PPU_THREAD_MAX; i++) {
+              used += g_ppu_threads[i].state != PPU_THREAD_STATE_FREE;
+              zombies += g_ppu_threads[i].state == PPU_THREAD_STATE_FINISHED;
+          }
+          fprintf(stderr, "[SYS] sys_ppu_thread_create: no thread slot is free -- EAGAIN (entry=0x%08llX; %d of %d in use, "
+                          "%d of them ended and waiting for a join)\n",
+                  (unsigned long long)entry, used, PPU_THREAD_MAX, zombies); }
         return (int64_t)(int32_t)CELL_EAGAIN;
     }
 
@@ -350,7 +410,7 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
     memset(t, 0, sizeof(*t));
 
     /* Allocate guest stack */
-    uint32_t stack_addr = vm_stack_allocate(&g_vm_stack_alloc, stack_size);
+    uint32_t stack_addr = stack_take(stack_size);
     if (stack_addr == 0) {
         table_unlock();
         return (int64_t)(int32_t)CELL_ENOMEM;
@@ -367,9 +427,15 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
     uint64_t thread_id = (uint64_t)(slot + 1);
     t->ctx.thread_id = thread_id;
 
-    t->state      = PPU_THREAD_STATE_RUNNING;
+    /* A thread made without SYS_PPU_THREAD_CREATE_JOINABLE (bit 0 of flags)
+     * cannot be joined and gives back what it holds when it ends: that is
+     * the rule on the console. Every thread used to be made joinable here,
+     * and one that nobody joins then kept its slot for the rest of the run:
+     * Drakengard 3 makes its SaveData, LoadData, DLCCheck and PreLoadMovie
+     * threads that way, one more slot gone with every save and every movie. */
+    t->joinable   = (flags & 1u) != 0;
+    t->state      = t->joinable ? PPU_THREAD_STATE_RUNNING : PPU_THREAD_STATE_DETACHED;
     t->priority   = priority;
-    t->joinable   = 1;
     t->stack_addr = stack_addr;
     t->stack_size = stack_size;
     t->entry_addr = entry;
@@ -409,9 +475,9 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
         *out = be_id;
     }
 
-    fprintf(stderr, "[SYS] sys_ppu_thread_create tid=%llu name=\"%s\" entry=0x%08llX arg=0x%llX stack=0x%X prio=%d\n",
+    fprintf(stderr, "[SYS] sys_ppu_thread_create tid=%llu name=\"%s\" entry=0x%08llX arg=0x%llX stack=0x%X prio=%d flags=0x%llX\n",
             (unsigned long long)thread_id, t->name, (unsigned long long)entry, (unsigned long long)arg,
-            stack_size, priority);
+            stack_size, priority, (unsigned long long)flags);
     /* YDKJ: dump the worker arg-object: func_000750A8 (thread body) does
      * this=[arg+0x8], vtable=[arg+0xC], method=[vtable+0]. If this(+0x8) is null
      * the worker dispatches its job on a null object -> construction never runs. */
@@ -450,6 +516,7 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
                                   (unsigned (__stdcall*)(void*))ppu_host_thread_proc, t,
                                   _initflag, (unsigned*)&t->host_tid);
     if (t->host_thread == NULL) {
+        stack_give(t);
         t->state = PPU_THREAD_STATE_FREE;
         CloseHandle(t->finish_event);
         table_unlock();
@@ -495,6 +562,7 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
         }
     }
     if (rc != 0) {
+        stack_give(t);
         t->state = PPU_THREAD_STATE_FREE;
         pthread_mutex_destroy(&t->finish_mutex);
         pthread_cond_destroy(&t->finish_cond);
@@ -519,12 +587,20 @@ int64_t sys_ppu_thread_exit(ppu_context* ctx)
     fprintf(stderr, "[SYS] sys_ppu_thread_exit(tid=%llu status=%llu)\n",
             (unsigned long long)tid, (unsigned long long)status);
 
+    /* Whether this call unwinds to the thread procedure (below). */
+    static int allow = -1;
+    if (allow < 0) allow = getenv("PS3_NO_THREAD_EXIT_UNWIND") ? 0 : 1;
+    const int unwind = allow && s_exit_armed;
+
     table_lock();
     ppu_thread_info* t = find_thread(tid);
     if (t) {
         t->exit_status = (int64_t)status;
         if (t->state == PPU_THREAD_STATE_DETACHED) {
-            t->state = PPU_THREAD_STATE_FREE;
+            /* The thread procedure's epilogue frees the slot once the thread
+             * is out of it; freed here, another thread could be given the
+             * slot while this one is still on its way there. */
+            if (!unwind) t->state = PPU_THREAD_STATE_FREE;
         } else {
             t->state = PPU_THREAD_STATE_FINISHED;
         }
@@ -542,11 +618,7 @@ int64_t sys_ppu_thread_exit(ppu_context* ctx)
 
     /* Hardware never returns from this. Unwind to the thread proc so the guest
      * cannot keep running past its own exit. */
-    {
-        static int allow = -1;
-        if (allow < 0) allow = getenv("PS3_NO_THREAD_EXIT_UNWIND") ? 0 : 1;
-        if (allow && s_exit_armed) { s_exit_armed = 0; longjmp(s_exit_jmp, 1); }
-    }
+    if (unwind) { s_exit_armed = 0; longjmp(s_exit_jmp, 1); }
     return CELL_OK;
 }
 
@@ -607,6 +679,16 @@ int64_t sys_ppu_thread_join(ppu_context* ctx)
 
     /* Clean up */
 #ifdef _WIN32
+    /* The thread signalled from inside sys_ppu_thread_exit and is still on
+     * its way out through the thread procedure, which takes the table lock
+     * and reads this slot. Wait for the host thread itself, with the lock
+     * released, as the pthread_join below does. (Not for ever: a thread
+     * whose exit did not unwind would never end, and the epilogue no longer
+     * needs the slot left alone to get its state right.) */
+    const int out = WaitForSingleObject(t->host_thread, 10000) == WAIT_OBJECT_0;
+    if (!out)
+        fprintf(stderr, "[SYS] sys_ppu_thread_join(tid=%llu): the host thread has not ended 10 s after it signalled\n",
+                (unsigned long long)tid);
     table_lock();
     CloseHandle(t->host_thread);
     CloseHandle(t->finish_event);
@@ -633,7 +715,9 @@ int64_t sys_ppu_thread_join(ppu_context* ctx)
     table_lock();
     pthread_mutex_destroy(&t->finish_mutex);
     pthread_cond_destroy(&t->finish_cond);
+    const int out = 1;
 #endif
+    if (out) stack_give(t);   /* a thread still in its guest code keeps its stack */
     t->state = PPU_THREAD_STATE_FREE;
     table_unlock();
 
@@ -659,8 +743,18 @@ int64_t sys_ppu_thread_detach(ppu_context* ctx)
     if (t->state == PPU_THREAD_STATE_FINISHED) {
         /* Already finished, free it */
 #ifdef _WIN32
+        if (WaitForSingleObject(t->host_thread, 0) != WAIT_OBJECT_0) {
+            /* Not out of the thread procedure yet: its epilogue frees the slot. */
+            t->state = PPU_THREAD_STATE_DETACHED;
+            t->joinable = 0;
+            table_unlock();
+            return CELL_OK;
+        }
         CloseHandle(t->host_thread);
         CloseHandle(t->finish_event);
+        t->host_thread = NULL;
+        t->finish_event = NULL;
+        stack_give(t);
 #else
         pthread_detach(t->host_thread);
         pthread_mutex_destroy(&t->finish_mutex);
