@@ -1124,6 +1293,7 @@ static int run_thread_check(void)
         fprintf(stderr, "[host] the guest thread never ran\n");
         return 1;
     }
+    if (run_thread_churn(&ctx, tid_out) != 0) return 7;
     if (g_reported_stack == 0) {
