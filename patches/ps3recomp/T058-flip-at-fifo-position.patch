             }
@@ -2886,6 +2939,25 @@ u32 cellGcm_display_buffer_count(void)
     return n;
 }
 
+/* Shared request bookkeeping, with no guest callback. FIFO preparation uses
+ * it at execution; ordinary HLE requests use it before their legacy callback. */
+static void gcm_record_flip_request(u32 bufferId, int in_fifo)
+{
+    if (!in_fifo) {
+        gcm_set_current_display_buffer(bufferId);
+        s_flip_pending = 1;   /* ticker: present BEFORE the next drain */
+        s_flip_request_count++;
+        s_flip_direct_pending = 1;
+    }
+    FLIP_LOCK();
+    s_flip_status = CELL_GCM_FLIP_STATUS_WAITING;
+    s_flip_req_seq++;
+    FLIP_UNLOCK();
+    s_last_flip_time = get_timestamp_ns();
+    if (PS3_FT_ON()) { const uint64_t t = ps3_ft_now();
+                       ps3_ft_span(PS3_FT_FLIP_REQ, 0, bufferId, (uint32_t)in_fifo, t, t); }
+}
