+/* FIFO execution, shared by a real marker and the ring-end position event.
+ * Existing present gating stops before the next drain, so no backend policy
+ * change is needed. Guest callbacks remain on the PPU ack/completion paths. */
+static void gcm_prepare_executed(u32 id)
+{
+    if (id >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM || !s_display_buffer_set[id]) return;
+    gcm_record_flip_request(id, 0);
+    atomic_store_explicit(&s_prepare_used, 1, memory_order_release);
+    atomic_fetch_add_explicit(&s_prepared_ready[id], 1, memory_order_release);
+}
+static int gcm_fire_pos_prepare(void)
+{
+    u64 event = atomic_load_explicit(&s_pos_prepare, memory_order_acquire);
+    if (event == GCM_NO_POS_PREPARE || (u32)event != s_fifo_getoff) return 0;
+    if (!atomic_compare_exchange_strong_explicit(&s_pos_prepare, &event,
+            GCM_NO_POS_PREPARE, memory_order_acq_rel, memory_order_acquire)) return 0;
+    gcm_prepare_executed((u32)(event >> 32));
+    return 1;
+}
