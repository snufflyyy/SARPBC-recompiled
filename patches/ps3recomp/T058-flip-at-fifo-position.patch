+    if (!ctx) return 0;
+    const u32 begin = vm_read32(ctx), end = vm_read32(ctx + 4), cur = vm_read32(ctx + 8);
     /* Never near the end: those bytes are the title's reserve before its
      * ring wraps, and the recycle above keys on them. */
-    if (cur + 8 + GCM_RECYCLE_SLACK > end || gcm_ea2io(cur) == 0xFFFFFFFFu) return 0;
-    vm_write32(cur, GCM_FLIP_MARKER | bufferId);
-    s_fifo_flips_queued++;
+    if (cur < begin || (u64)cur + 8 + GCM_RECYCLE_SLACK > end ||
+        gcm_ea2io(cur) == 0xFFFFFFFFu) return 0;
+    if ((word & 0xFFFFFF00u) == GCM_PREPARE_MARKER)
+        atomic_store_explicit(&s_prepare_used, 1, memory_order_release);
+    vm_write32(cur, word);
