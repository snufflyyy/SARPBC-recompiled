@@ -3879,6 +3925,7 @@ void cellGcmTerminate(void)
     printf("[cellGcmSys] Terminate\n");
 
     s_gcm_initialized = 0;
+    gcm_reset_prepared_flips();
     s_flip_mode   = CELL_GCM_DISPLAY_VSYNC;
