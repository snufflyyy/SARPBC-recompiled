--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -116,6 +116,22 @@ static u32 s_current_display_buffer_id = 0;
 static volatile int s_flip_pending = 0;
 /* A flip _cellGcmSetFlipCommand queued in the FIFO: | bufferId, bit 8 = ours. */
 #define GCM_FLIP_MARKER 0xFEAD0100u
+#define GCM_PREPARE_MARKER 0xFEAD0200u
+/* Ready preparations await a PPU acknowledgement, possibly on another thread.
+ * Track each buffer independently: a delayed callback for 0 must survive 1. */
+static atomic_uint s_prepare_used;
+static atomic_uint s_prepared_ready[CELL_GCM_MAX_DISPLAY_BUFFER_NUM];
+#define GCM_NO_POS_PREPARE UINT64_MAX
+/* No marker room: {buffer id, IO cursor}, published as one atomic event. */
+static _Atomic(u64) s_pos_prepare = GCM_NO_POS_PREPARE;
+static void gcm_record_flip_request(u32 bufferId, int in_fifo);
+static void gcm_reset_prepared_flips(void)
