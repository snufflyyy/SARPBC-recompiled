     s_debug_level = CELL_GCM_DEBUG_LEVEL0;
@@ -4062,6 +4109,19 @@ u32 cellGcmGetDefaultSegmentWordSize(void)
 /* Immediate flip — perform flip right now */
 s32 cellGcmSetFlipImmediate(u32 bufferId)
 {
+    if (bufferId >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM || !s_display_buffer_set[bufferId])
+        return CELL_GCM_ERROR_INVALID_VALUE;
+    if (atomic_load_explicit(&s_prepare_used, memory_order_acquire)) {
+        u32 ready = atomic_load_explicit(&s_prepared_ready[bufferId], memory_order_acquire);
+        while (ready && !atomic_compare_exchange_weak_explicit(&s_prepared_ready[bufferId],
+                &ready, ready - 1, memory_order_acq_rel, memory_order_acquire)) {}
+        if (!ready) return CELL_GCM_ERROR_FAILURE;
+        printf("[cellGcmSys] SetFlipImmediate(bufferId=%u) (prepared ack)\n", bufferId);
+        /* Preserve the existing optional early park-release edge on the PPU,
+         * without creating another flip or entering the guest from the drain. */
+        gcm_early_flip_callback();
+        return CELL_OK;
+    }
     printf("[cellGcmSys] SetFlipImmediate(bufferId=%u)\n", bufferId);
     return cellGcmSetFlipCommand(bufferId);
 }
