diff --git a/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp b/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp
new file mode 100644
index 0000000..41be8f2
--- /dev/null
+++ b/runtime/ppu/tests/test_ppu_guest_call_stacks.cpp
@@ -0,0 +1,207 @@
+// ppu_guest_call runs every callback on a stack of its own.
+//
+// The runtime delivers guest callbacks (cellSysutil events, GCM vblank/flip/
+// user handlers, PRX start_module, ...) through ppu_guest_call. Each call gets
+// a fresh ppu_context, and its r1 used to be the fixed address 0xCFFE0000 on
+// every host thread and at every nesting depth -- inside RSX local memory, too.
+// Two callbacks running at once on different host threads (a GCM handler on
+// the interrupt thread while a guest thread pumps the same handler from an HLE
+// call), or a callback that makes an HLE call which delivers another callback,
+// then built their frames on the same bytes.
+//
+// The guest functions below do what a lifted prologue does: drop r1 by a frame
+// and fill the frame. Then they wait (for the other thread, or for a nested
+// callback) and check that their frame still holds what they wrote.
+//
+//   1. two host threads, each inside a callback at the same time;
+//   2. a callback that calls ppu_guest_call again from inside itself;
+//   3. the stacks come from the PPU stack region, above what the thread-stack
+//      allocator may still hand out, and not from RSX local memory;
+//   4. host threads that end give their stacks back (no growth over 64 threads).
+//
+// Built by tools/test_ppu_guest_call_stacks.py against the real ppu_loader.cpp.
+#include "ppu_recomp.h"
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <thread>
+#include "win32_compat.h"
+#include "../../memory/vm.h"
+
+extern "C" {
+uint8_t* vm_base;
+// No SPUs, RSX or guest threads in this fixture: using any of them fails it.
+uint32_t ppu_hle_inject_base = 0x20000000;
+int spu_coh_is_reserved(uint32_t) { return 0; }
+void spu_coh_notify_write(uint32_t) { std::abort(); }
+void spu_lockline_lock(void) { std::abort(); }
+void spu_lockline_unlock(void) { std::abort(); }
+int spu_raw_reg_load(uint32_t, uint32_t*) { std::abort(); }
+void spu_raw_reg_store(uint32_t, uint32_t, unsigned) { std::abort(); }
+void cellGcm_ref_on_poll(void) { std::abort(); }
+HANDLE CreateThread(void*, SIZE_T, PS3_THREAD_FN, LPVOID, DWORD, DWORD*) { std::abort(); }
+BOOL CloseHandle(HANDLE) { std::abort(); }
+DWORD GetFileAttributesA(const char*) { return INVALID_FILE_ATTRIBUTES; }
+uint64_t ppu_thread_register_main(void) { return 1; }
+void (*g_ppu_thread_entry_trampoline)(uint32_t, uint64_t, uint32_t, uint64_t);
+vm_stack_alloc g_vm_stack_alloc;   // sys_ppu_thread.c's, the PPU stack region allocator
+void ppu_register_function(uint64_t addr, void (*fn)(ppu_context*));
+uint64_t ppu_guest_call(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t,
+                        uint64_t, uint64_t, uint64_t, uint64_t);
+}
+
+enum : uint32_t {
+    FRAME = 0x400,                       // bytes each fake guest frame fills
+    CODE_PAIR = 0x10000, CODE_OUTER = 0x10100, CODE_INNER = 0x10200, CODE_SP = 0x10300,
+    OPD_PAIR = 0x20000, OPD_OUTER = 0x20010, OPD_INNER = 0x20020, OPD_SP = 0x20030,
+    TOC = 0x80000,
+};
+
+static std::atomic<unsigned> s_fail{0};
+static void check(bool ok, const char* what)
+{
+    if (!ok) { std::fprintf(stderr, "  FAIL: %s\n", what); s_fail++; }
+}
+
+// A lifted prologue: stdu r1,-FRAME(r1), then fill the frame with `tag`.
+static uint32_t push_frame(ppu_context* ctx, uint32_t tag)
+{
+    uint32_t sp = (uint32_t)ctx->gpr[1] - FRAME;
+    ctx->gpr[1] = sp;
+    for (uint32_t off = 0; off < FRAME; off += 4) vm_write32(sp + off, tag ^ off);
+    return sp;
+}
+static bool frame_intact(uint32_t sp, uint32_t tag)
+{
+    for (uint32_t off = 0; off < FRAME; off += 4)
+        if (vm_read32(sp + off) != (tag ^ off)) return false;
+    return true;
+}
+
+static bool sp_in_stack_region(uint32_t sp)
+{
+    return sp >= g_vm_stack_alloc.region_end && sp < VM_STACK_BASE + VM_STACK_REGION;
+}
+
+// ---- 1: two threads inside a callback at once ------------------------------
+static std::atomic<int> s_arrived{0};
+static uint32_t s_pair_sp[2];
+static bool s_pair_ok[2];
+
+static void cb_pair(ppu_context* ctx)
+{
+    const int who = (int)ctx->gpr[3];
+    const uint32_t tag = 0xA0000000u + (uint32_t)who * 0x01000000u;
+    const uint32_t sp = push_frame(ctx, tag);
+    s_pair_sp[who] = sp;
+    // Both callbacks hold a live frame here before either looks at its own.
+    s_arrived++;
+    const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (s_arrived.load() < 2 && std::chrono::steady_clock::now() < until)
+        std::this_thread::yield();
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    s_pair_ok[who] = frame_intact(sp, tag);
+    ctx->gpr[1] += FRAME;
+    ctx->gpr[3] = who;
+}
+
+// ---- 2: a callback that delivers another callback --------------------------
+static uint32_t s_outer_sp, s_inner_sp;
+
+static void cb_inner(ppu_context* ctx)
+{
+    s_inner_sp = push_frame(ctx, 0xBB000000u);
+    ctx->gpr[1] += FRAME;
+    ctx->gpr[3] = 7;
+}
+static void cb_outer(ppu_context* ctx)
+{
+    s_outer_sp = push_frame(ctx, 0xAA000000u);
+    // An HLE import called from here that runs a guest handler (the GCM pump does).
+    const uint64_t r = ppu_guest_call(OPD_INNER, 0, 0, 0, 0, 0, 0, 0, 0);
+    check(r == 7, "nested callback ran and returned r3");
+    check(frame_intact(s_outer_sp, 0xAA000000u), "outer callback's frame survives a nested callback");
+    ctx->gpr[1] += FRAME;
+    ctx->gpr[3] = 1;
+}
+
+// ---- helpers ---------------------------------------------------------------
+static void cb_sp(ppu_context* ctx) { ctx->gpr[3] = ctx->gpr[1]; }
+
+extern "C" const func_entry function_table[1] = {{0, nullptr, nullptr}};   // registered by hand below
+extern "C" const uint64_t function_table_count = 0;
+
+static void opd(uint32_t at, uint32_t code) { vm_write32(at, code); vm_write32(at + 4, TOC); }
+
+int main()
+{
+    if (vm_init() != CELL_OK) { std::fprintf(stderr, "vm_init failed\n"); return 2; }
+    // RSX local memory, mapped as a title's cellGcmInit leaves it, so a callback
+    // stack placed there corrupts instead of faulting.
+    vm_commit(0xC0000000u, 0x10000000u);
+    vm_stack_alloc_init(&g_vm_stack_alloc);
+    ppu_register_function(CODE_PAIR, cb_pair);  ppu_register_function(CODE_OUTER, cb_outer);
+    ppu_register_function(CODE_INNER, cb_inner); ppu_register_function(CODE_SP, cb_sp);
+    opd(OPD_PAIR, CODE_PAIR); opd(OPD_OUTER, CODE_OUTER);
+    opd(OPD_INNER, CODE_INNER); opd(OPD_SP, CODE_SP);
+
+    std::printf("[1] two host threads inside a callback at the same time\n");
+    {
+        std::thread a([] { ppu_guest_call(OPD_PAIR, 0, 0, 0, 0, 0, 0, 0, 0); });
+        std::thread b([] { ppu_guest_call(OPD_PAIR, 1, 0, 0, 0, 0, 0, 0, 0); });
+        a.join(); b.join();
+        std::printf("    frames at 0x%08X and 0x%08X\n", s_pair_sp[0], s_pair_sp[1]);
+        check(s_arrived.load() == 2, "both callbacks reached the rendezvous");
+        check(s_pair_sp[0] + FRAME <= s_pair_sp[1] || s_pair_sp[1] + FRAME <= s_pair_sp[0],
+              "the two threads' frames do not overlap");
+        check(s_pair_ok[0], "thread 0's frame survives thread 1's callback");
+        check(s_pair_ok[1], "thread 1's frame survives thread 0's callback");
+    }
+
+    std::printf("[2] a callback nested in a callback\n");
+    {
+        const uint64_t r = ppu_guest_call(OPD_OUTER, 0, 0, 0, 0, 0, 0, 0, 0);
+        std::printf("    outer frame 0x%08X, inner frame 0x%08X\n", s_outer_sp, s_inner_sp);
+        check(r == 1, "outer callback returned r3");
+        check(s_inner_sp + FRAME <= s_outer_sp || s_outer_sp + FRAME <= s_inner_sp,
+              "outer and inner frames do not overlap");
+    }
+
+    std::printf("[3] where the stacks are\n");
+    {
+        const uint32_t sp0 = (uint32_t)ppu_guest_call(OPD_SP, 0, 0, 0, 0, 0, 0, 0, 0);
+        const uint32_t sp1 = (uint32_t)ppu_guest_call(OPD_SP, 0, 0, 0, 0, 0, 0, 0, 0);
+        std::printf("    depth-0 sp 0x%08X, thread-stack allocator ends at 0x%08X\n",
+                    sp0, g_vm_stack_alloc.region_end);
+        check(sp0 == sp1, "the nesting depth unwinds (same stack for the next call)");
+        check((sp0 & 15) == 0, "callback sp is 16-byte aligned");
+        check(!(sp0 >= 0xC0000000u && sp0 < 0xD0000000u), "callback stack is not in RSX local memory");
+        check(sp_in_stack_region(sp0) && sp_in_stack_region(s_pair_sp[0]) &&
+              sp_in_stack_region(s_pair_sp[1]) && sp_in_stack_region(s_inner_sp),
+              "callback stacks lie in the PPU stack region, above the thread-stack allocator");
+        const uint32_t t = vm_stack_allocate(&g_vm_stack_alloc, 0x10000);
+        check(t && t + 0x10000 <= g_vm_stack_alloc.region_end,
+              "a thread stack allocated afterwards stays below the callback stacks");
+    }
+
+    std::printf("[4] host threads give their callback stacks back\n");
+    {
+        uint32_t end_before = g_vm_stack_alloc.region_end, lowest = 0xFFFFFFFFu;
+        for (int i = 0; i < 64; i++) {
+            uint32_t sp = 0;
+            std::thread th([&] { sp = (uint32_t)ppu_guest_call(OPD_SP, 0, 0, 0, 0, 0, 0, 0, 0); });
+            th.join();
+            if (sp < lowest) lowest = sp;
+        }
+        const uint32_t used = end_before - g_vm_stack_alloc.region_end;
+        std::printf("    64 short-lived threads moved the region end by 0x%X bytes\n", used);
+        check(used <= 0x100000u, "64 short-lived threads reuse a stack instead of carving 64");
+    }
+
+    const unsigned f = s_fail.load();
+    std::printf("%s: %u check(s) failed\n", f ? "FAIL" : "PASS", f);
+    return f ? 1 : 0;
+}
