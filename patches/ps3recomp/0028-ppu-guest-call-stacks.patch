+#include <atomic>
 #ifdef _WIN32
 #  include <windows.h>
 #else
@@ -3668,8 +3670,165 @@ extern "C" void ppu_install_thread_trampoline(void)
     g_ppu_thread_entry_trampoline = ppu_thread_entry_trampoline;
 }
 
-/* Call a guest function by OPD with up to 4 integer args, on a private scratch
- * stack, and return r3. Used by the HLE runtime to deliver callbacks into
+/* ---------------------------------------------------------------------------
+ * Guest-callback stacks
+ *
+ * ppu_guest_call / ppu_guest_call_ct run a callback in a fresh ppu_context, so
+ * it needs an r1 that nothing else is using. That used to be the fixed address
+ * 0xCFFE0000 on every host thread and at every nesting depth, which broke in
+ * three ways:
+ *   - two callbacks running at once on different host threads (a GCM handler
+ *     on the interrupt thread while a guest thread pumps the same handler from
+ *     an HLE call; a sysutil callback while the vblank ticker runs a handler)
+ *     built their frames on the same bytes;
+ *   - a callback that makes an HLE call which delivers another callback (the
+ *     GCM pump runs at HLE calls) restarted r1 at the same address and wrote
+ *     over its caller's live frames;
+ *   - 0xCFFE0000 is RSX local memory (0xC0000000, localSize 256 MB), so the
+ *     frames also landed on whatever the title kept at the top of VRAM.
+ *
+ * Now every (host thread, nesting depth) pair has a stack of its own. They are
+ * carved from the TOP of the PPU stack region, by moving g_vm_stack_alloc's
+ * region_end down, while the thread-stack allocator keeps bumping up from the
+ * bottom (VM_STACK_BASE): the two never meet, and no address is fixed. Each
+ * stack has an inaccessible guard page at its bottom, like a thread stack, so
+ * an overflow faults instead of corrupting the next one. A host thread that
+ * ends returns its stacks to a pool, so short-lived threads do not use up the
+ * region.
+ *
+ * PPU_CB_STACK_SIZE (bytes, decimal or 0x hex, default 256 KB) sets the size of
+ * every callback stack. It is read once, so pooled stacks are interchangeable.
+ *
+ * Carving stores region_end while sys_ppu_thread_create may read it under its
+ * own lock (sys_ppu_thread.c's table lock, not visible here). The store is a
+ * single aligned 32-bit word that only ever moves down, and a carve refuses to
+ * come within PPU_CB_HEADROOM of next_addr, so a thread stack allocated at the
+ * same moment still ends well below the new region_end. */
+#define PPU_CB_STACK_DEFAULT  0x40000u          /* 256 KB */
+#define PPU_CB_MAX_DEPTH      32
+#define PPU_CB_POOL_MAX       512
+#define PPU_CB_HEADROOM       0x01000000u       /* 16 MB kept for thread stacks */
+#define PPU_CB_TOP_PAD        0x100u            /* the callee stores LR/CR/params above r1 */
+
+extern "C" vm_stack_alloc g_vm_stack_alloc;     /* syscalls/sys_ppu_thread.c */
+
+static std::mutex s_cb_mu;
+static uint32_t   s_cb_pool[PPU_CB_POOL_MAX];   /* stack bases (lowest usable byte) */
+static int        s_cb_pool_n;
+static uint32_t   s_cb_floor;                   /* lowest byte carved so far, 0 = none */
+static std::atomic<unsigned> s_cb_assigned{0};  /* (thread, depth) slots filled, for the log */
+
+static uint32_t ppu_cb_stack_size(void)
+{
+    static uint32_t s_size = 0;
+    if (!s_size) {
+        uint32_t v = PPU_CB_STACK_DEFAULT;
+        if (const char* e = getenv("PPU_CB_STACK_SIZE")) {
+            unsigned long x = strtoul(e, nullptr, 0);
+            if (x >= 0x4000u && x <= 0x01000000u) v = (uint32_t)x;
+        }
+        s_size = VM_ALIGN_UP(v, vm_host_page_size());
+    }
+    return s_size;
+}
+
+/* A stack's base, from the pool or freshly carved; 0 when the region is full. */
+static uint32_t ppu_cb_stack_take(void)
+{
+    std::lock_guard<std::mutex> lk(s_cb_mu);
+    if (s_cb_pool_n) return s_cb_pool[--s_cb_pool_n];
+
+    const uint32_t size = ppu_cb_stack_size(), pg = vm_host_page_size();
+    vm_stack_alloc* sa = &g_vm_stack_alloc;
+    if (!sa->region_end) vm_stack_alloc_init(sa);   /* a host that never ran sys_ppu_thread_init */
+    uint32_t end = sa->region_end;
+    /* A second vm_stack_alloc_init() (a host test harness does one) puts
+     * region_end back at the top, over stacks already handed out: carve below. */
+    if (s_cb_floor && end > s_cb_floor) end = s_cb_floor;
+    const uint32_t total = size + pg;
+    if (end < sa->next_addr || end - sa->next_addr < total + PPU_CB_HEADROOM) {
+        fprintf(stderr, "[ppu] guest_call: no room for a %u KB callback stack (thread stacks "
+                        "end 0x%08X, region end 0x%08X)\n", size >> 10, sa->next_addr, end);
+        return 0;
+    }
+    const uint32_t base = end - total;
+    *(volatile uint32_t*)&sa->region_end = base;
+    s_cb_floor = base;
+    vm_protect(base, pg, 0, 0, 0);                   /* guard page at the bottom */
+    return base + pg;
+}
+
+/* This host thread's stacks, one per nesting depth, given back to the pool when
+ * the thread ends. A C++ thread_local for the destructor: PPU_THREAD_LOCAL is a
+ * plain __thread / __declspec(thread), which has none. */
+struct PpuCbStacks {
+    uint32_t base[PPU_CB_MAX_DEPTH] = {};
+    uint32_t code[PPU_CB_MAX_DEPTH] = {};   /* the callback running at each depth (diagnostics) */
+    unsigned depth = 0;
+    ~PpuCbStacks() {
+        std::lock_guard<std::mutex> lk(s_cb_mu);
+        for (unsigned i = 0; i < PPU_CB_MAX_DEPTH; i++)
+            if (base[i] && s_cb_pool_n < PPU_CB_POOL_MAX) s_cb_pool[s_cb_pool_n++] = base[i];
+    }
+};
+static thread_local PpuCbStacks t_cb_stacks;
+
+/* The shared body of ppu_guest_call / ppu_guest_call_ct: run fn on this host
+ * thread's stack for the next nesting depth and return r3. */
+static uint64_t ppu_guest_call_run(ppu_fn fn, uint32_t code, uint32_t toc, const uint64_t a[8])
+{
+    PpuCbStacks& st = t_cb_stacks;
+    const unsigned d = st.depth;
+    if (d >= PPU_CB_MAX_DEPTH) {
+        fprintf(stderr, "[ppu] guest_call: callbacks nested %u deep, refusing code 0x%08X\n", d, code);
+        return 0;
+    }
+    if (!st.base[d]) {
+        if (!(st.base[d] = ppu_cb_stack_take())) return 0;
+        /* The first 32 (thread, depth) slots. A depth > 0 line names a callback
+         * delivered from inside another one: the case a shared stack corrupted. */
+        if (s_cb_assigned.fetch_add(1, std::memory_order_relaxed) < 32)
+            fprintf(stderr, "[ppu] guest_call: tid 0x%llX depth %u -> stack 0x%08X..0x%08X "
+                            "for code 0x%08X (inside 0x%08X)\n",
+                    (unsigned long long)(g_active_ctx ? g_active_ctx->thread_id : 0), d,
+                    st.base[d], st.base[d] + ppu_cb_stack_size(), code, d ? st.code[d - 1] : 0u);
+    }
+    st.code[d] = code;
+
+    ppu_context ctx;
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.gpr[1]  = (st.base[d] + ppu_cb_stack_size() - PPU_CB_TOP_PAD) & ~0xFu;
+    ctx.gpr[2]  = toc;
+    for (int i = 0; i < 8; i++) ctx.gpr[3 + i] = a[i];
+    ctx.gpr[13] = PPU_TLS_TP;
+    ctx.cia     = code;
+    /* Save/restore g_active_ctx: this scratch ctx lives on the stack, so leaving
+     * g_active_ctx pointing at it after we return leaves a DANGLING pointer once the
+     * frame is reused -- corrupting the crash handler / any diagnostic that reads the
+     * current-thread ctx. Restore the caller's. */
+    ppu_context* saved_active = g_active_ctx;
+    /* Thread identity: a zeroed scratch ctx used to run callbacks as thread_id 0
+     * -- aliasing the main thread in every owner-tracking primitive. Inherit the
+     * calling guest thread's id; host-only threads (ticker) get a per-host-thread
+     * sentinel far above the thread table's range. */
+#ifdef _WIN32
+    ctx.thread_id = saved_active ? saved_active->thread_id
+                                 : (0x7FFF0000ull | (GetCurrentThreadId() & 0xFFFFu));
+#else
+    ctx.thread_id = saved_active ? saved_active->thread_id : 0x7FFF0000ull;
+#endif
+    st.depth = d + 1;
+    g_active_ctx = &ctx;
+    fn(&ctx);
+    while (g_trampoline_fn) { void (*tf)(void*) = g_trampoline_fn; g_trampoline_fn = 0; tf(&ctx); }
+    g_active_ctx = saved_active;
+    st.depth = d;
+    return ctx.gpr[3];
+}
+
+/* Call a guest function by OPD with up to 8 integer args, on this host thread's
+ * callback stack for the current nesting depth (see "Guest-callback stacks"
+ * above), and return r3. Used by the HLE runtime to deliver callbacks into
  * recompiled code (cellSysutil events, GCM vblank/flip handlers, ...) -- the
  * mechanism behind g_ps3_guest_caller (ps3emu/guest_call.h). */
 /* OPD fixups: some title OPDs (the GCM flip/vblank handlers at 0x530D70/78/80)
@@ -3712,45 +3871,14 @@ extern "C" uint64_t ppu_guest_call(uint32_t opd_addr,
                 vm_read32(opd_addr + 8), vm_read32(opd_addr + 12));
         return 0; }
 
-    /* Private scratch stack high in the guest stack region, distinct from the
-     * main + ppu_thread stacks. One callback at a time per caller thread. */
-    static PPU_THREAD_LOCAL uint32_t s_cb_sp = 0;
-    if (!s_cb_sp) s_cb_sp = 0xCFFE0000u;
-
-    ppu_context ctx;
-    memset(&ctx, 0, sizeof(ctx));
-    ctx.gpr[1]  = s_cb_sp;
-    ctx.gpr[2]  = toc;
-    ctx.gpr[3]  = a0; ctx.gpr[4] = a1; ctx.gpr[5] = a2; ctx.gpr[6] = a3;
-    ctx.gpr[7]  = a4; ctx.gpr[8] = a5; ctx.gpr[9] = a6; ctx.gpr[10] = a7;
-    ctx.gpr[13] = PPU_TLS_TP;
-    ctx.cia     = code;
-    /* Save/restore g_active_ctx: this scratch ctx lives on the stack, so leaving
-     * g_active_ctx pointing at it after we return leaves a DANGLING pointer once the
-     * frame is reused -- corrupting the crash handler / any diagnostic that reads the
-     * current-thread ctx. Restore the caller's. */
-    ppu_context* saved_active = g_active_ctx;
-    /* Thread identity: a zeroed scratch ctx used to run callbacks as thread_id 0
-     * -- aliasing the main thread in every owner-tracking primitive. Inherit the
-     * calling guest thread's id; host-only threads (ticker) get a per-host-thread
-     * sentinel far above the thread table's range. */
-#ifdef _WIN32
-    ctx.thread_id = saved_active ? saved_active->thread_id
-                                 : (0x7FFF0000ull | (GetCurrentThreadId() & 0xFFFFu));
-#else
-    ctx.thread_id = saved_active ? saved_active->thread_id : 0x7FFF0000ull;
-#endif
-    g_active_ctx = &ctx;
-    fn(&ctx);
-    while (g_trampoline_fn) { void (*tf)(void*) = g_trampoline_fn; g_trampoline_fn = 0; tf(&ctx); }
-    g_active_ctx = saved_active;
-    return ctx.gpr[3];
+    const uint64_t a[8] = {a0, a1, a2, a3, a4, a5, a6, a7};
+    return ppu_guest_call_run(fn, code, toc, a);
 }
 
 /* Call a guest function by an already-resolved {code, toc} pair. Used for
  * callbacks whose OPD is captured at registration time and may later be
  * clobbered in guest memory (e.g. the GCM flip/vblank handler OPDs). Same
- * scratch-stack + trampoline-drain behaviour as ppu_guest_call. */
+ * callback-stack + trampoline-drain behaviour as ppu_guest_call. */
 extern "C" uint64_t ppu_guest_call_ct(uint32_t code, uint32_t toc,
                                       uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
                                       uint64_t a4, uint64_t a5, uint64_t a6, uint64_t a7)
@@ -3759,32 +3887,8 @@ extern "C" uint64_t ppu_guest_call_ct(uint32_t code, uint32_t toc,
     ppu_fn fn = ppu_lookup(code);
     if (!fn) { fprintf(stderr, "[ppu] guest_call_ct: code 0x%08X not registered\n", code); return 0; }
 
-    static PPU_THREAD_LOCAL uint32_t s_cb_sp = 0;
-    if (!s_cb_sp) s_cb_sp = 0xCFFE0000u;
