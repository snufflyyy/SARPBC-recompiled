+#!/usr/bin/env python3
+"""ppu_guest_call gives every host thread and nesting depth its own stack.
+
+Builds the real runtime/ppu/ppu_loader.cpp with
+runtime/ppu/tests/test_ppu_guest_call_stacks.cpp: two host threads sit inside
+a guest callback at the same time, a callback delivers a nested callback, and
+each checks that its frame still holds what it wrote. The stacks must come
+from the PPU stack region (above the thread-stack allocator, not from RSX
+local memory), and threads that end must give theirs back.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from check_ppu_scaffold import stub_header  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: standalone fixture uses the POSIX mmap/toolchain')
+        return
+    with tempfile.TemporaryDirectory(prefix='ppu-guest-call-stacks-') as tmp:
+        tmp = Path(tmp)
+        (tmp / 'ppu_recomp.h').write_text(stub_header())
+        binary = tmp / 'test'
+        flags = ['-Wl,-dead_strip'] if sys.platform == 'darwin' else ['-Wl,--gc-sections', '-pthread', '-ldl']
+        subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++17', '-O1', '-w',
+                        '-ffunction-sections', '-fdata-sections',
+                        '-I' + str(tmp), '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'runtime/platform'),
+                        str(ROOT / 'runtime/ppu/ppu_loader.cpp'),
+                        str(ROOT / 'runtime/ppu/tests/test_ppu_guest_call_stacks.cpp'),
+                        *flags, '-o', str(binary)], check=True)
+        env = {k: v for k, v in os.environ.items() if not k.startswith(('PPU_', 'PS3_', 'PS3RECOMP_', 'SPU_'))}
+        r = subprocess.run([str(binary)], env=env, capture_output=True, text=True, timeout=60)
+        print(r.stdout, end='')
+        sys.stderr.write(r.stderr[-4000:])
+        if r.returncode:
+            raise SystemExit('FAIL: guest callbacks share a stack')
+        print('PASS: guest callbacks run on per-thread, per-depth stacks')
+
+
+if __name__ == '__main__':
+    main()
