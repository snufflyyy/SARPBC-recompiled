index 5c9ffc1..c750f3b 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -749,6 +749,8 @@ static void pad_poll_host_input(void)
     int focused = 1;
 #ifdef _WIN32
     focused = pad_host_window_focused();
+#elif defined(__APPLE__)
+    if (rsx_metal_backend_window_focused) focused = rsx_metal_backend_window_focused();
 #endif
     memset(&in, 0, sizeof in);
