index e646f3d..e701c87 100644
--- a/libs/input/cellPad.h
+++ b/libs/input/cellPad.h
@@ -212,6 +212,21 @@ void cellPad_poll(void);
 #define CELL_PAD_HOST_OTHER   6   /* a pad of no known family */
