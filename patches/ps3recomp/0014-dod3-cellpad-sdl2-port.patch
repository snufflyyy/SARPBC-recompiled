From c2cb41d831ee9bcf08bf0242eb771a7558b2c6e3 Mon Sep 17 00:00:00 2001
From: soyjxck <soyjxck@users.noreply.github.com>
Date: Tue, 13 Oct 2026 22:41:51 +0100
Subject: [PATCH 13/13] cellPad: PAD_NO_HOST=1, a hands-off run that no
 controller on the desk can steer

The host's controllers are read whether or not the title's window is in
front. A run driven by PAD_FILE or PAD_SCRIPT on a machine with a
controller connected is then at the mercy of it: a drifting stick or a
bump moves a menu cursor a step, and the run that was to load a save
starts a new game. On a machine with one connected, benchmark runs of
Drakengard 3 now and then did just that, or started a mission from the
hub, with nothing else about them different.

With PAD_NO_HOST set nothing of the host's reaches the title -- no
controller, no key -- and port 0 is a pad nobody touches, which the
injected presses still go through.

Ported to SARPBC-recomp (T008) from soyjxck/ps3recomp de08397c0a48 (MIT),
libs/input part only; the original author is kept.
---
 libs/input/cellPad.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 1c6e96c..c1e8233 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -800,6 +800,24 @@ static void pad_poll_backend(void)
      * every port. cellPadGetData hands each one out exactly once. */
     for (int _i = 0; _i < PAD_MAX_HOST_PORTS; _i++) s_data_fresh[_i] = 1;
 
+    /* PAD_NO_HOST=1: no controller and no key of the host's reaches the
+     * title, and port 0 is a pad nobody touches.
+     * For a run driven by PAD_FILE or PAD_SCRIPT: the controllers are read
+     * whether or not the title's window is in front, so one lying on the
+     * desk (a drifting stick, a bump) or in someone's hands for another
+     * game steers a run that was meant to be hands-off. */
+    { static int no_host = -1;
+      if (no_host < 0) no_host = getenv("PAD_NO_HOST") ? 1 : 0;
+      if (no_host) {
+          PadHostState* hs = &s_host_state[0];
+          hs->buttons = 0;
+          hs->analog_lx = hs->analog_ly = 128;
+          hs->analog_rx = hs->analog_ry = 128;
+          hs->trigger_l2 = hs->trigger_r2 = 0;
+          hs->connected = 1;
+          return;
+      } }
+
 #if PAD_BACKEND_XINPUT
     pad_poll_xinput();
 #elif PAD_BACKEND_SDL2
