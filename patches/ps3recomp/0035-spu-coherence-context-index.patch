From dc32ca6774ca847c684d72d722ab3cbbdb65c57e Mon Sep 17 00:00:00 2001
From: Pi <pi@localhost>
Date: Mon, 19 Oct 2026 23:28:51 +0000
Subject: [PATCH] perf(spu): index reservation-holder membership

Repeated GETLLAR calls scan all virtual contexts under the global lock-line lock. Add a private pointer hash index with unbounded collision chains. Keep the original notification list and its order, reservation semantics, context ABI, and lock ownership unchanged. Both cleanup paths remove the index link before freeing the node.

Add 300-context collision, repeated registration, self-exclusion, range cleanup, and same-address reuse regressions plus a standalone lookup benchmark. Registry suites pass with clang and GCC; coherence fixture also passes ASan/UBSan. Median locked reserve time at 256 contexts falls from 135.45 ns to 5.94 ns on a Ryzen 7 3700X; six contexts cost an extra 0.28 ns.
---
 runtime/spu/spu_coherency.c               | 34 +++++++++++++-
 runtime/spu/tests/bench_spu_coh_reserve.c | 42 +++++++++++++++++
 runtime/spu/tests/test_spu_coherency.c    | 56 +++++++++++++++++++++++
 3 files changed, 131 insertions(+), 1 deletion(-)
 create mode 100644 runtime/spu/tests/bench_spu_coh_reserve.c

diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
index 7aa441d..29f8ebc 100644
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -113,9 +113,36 @@ static int s_coh_armed;
 typedef struct spu_coh_entry {
     spu_context* ctx;
     struct spu_coh_entry* next;
+    struct spu_coh_entry* hash_next;
 } spu_coh_entry;
 static spu_coh_entry* s_coh_ctxs;
 
+/* GETLLAR may re-reserve an unchanged line millions of times. Membership
+ * lookup must not walk every virtual context while holding the global lock.
+ * Keep a private pointer index, not a fixed-size holder table: collisions chain
+ * without limiting the number of contexts. Notification still walks the same
+ * list in the same order, using the context's current reservation state. */
+#define SPU_COH_CTX_BUCKETS 256u
+static spu_coh_entry* s_coh_index[SPU_COH_CTX_BUCKETS];
+
+static unsigned spu_coh_ctx_hash(const spu_context* ctx)
+{
+    uintptr_t key = (uintptr_t)ctx >> 4;
+    /* Contexts include a large aligned local store. Fold high pointer bits so
+     * an array of contexts does not all land in one bucket. */
+    key ^= key >> 16;
+    key ^= key >> 8;
+    return (unsigned)key & (SPU_COH_CTX_BUCKETS - 1);
+}
+
+/* Called only under the lock-line lock, before removing the list node. */
+static void spu_coh_unindex(spu_coh_entry* entry)
+{
+    spu_coh_entry** link = &s_coh_index[spu_coh_ctx_hash(entry->ctx)];
+    while (*link != entry) link = &(*link)->hash_next;
+    *link = entry->hash_next;
+}
+
 unsigned long g_spu_lr_raise = 0;
 
 void spu_coh_reserve(spu_context* ctx, uint32_t ea)
@@ -125,7 +152,8 @@ void spu_coh_reserve(spu_context* ctx, uint32_t ea)
     s_coh_armed = 1;
 
     if (!ctx) return;
-    for (spu_coh_entry* entry = s_coh_ctxs; entry; entry = entry->next)
+    unsigned bucket = spu_coh_ctx_hash(ctx);
+    for (spu_coh_entry* entry = s_coh_index[bucket]; entry; entry = entry->hash_next)
         if (entry->ctx == ctx) return;
     spu_coh_entry* entry = (spu_coh_entry*)malloc(sizeof(*entry));
     if (!entry) {
@@ -135,6 +163,8 @@ void spu_coh_reserve(spu_context* ctx, uint32_t ea)
     }
     entry->ctx = ctx;
     entry->next = s_coh_ctxs;
+    entry->hash_next = s_coh_index[bucket];
+    s_coh_index[bucket] = entry;
     s_coh_ctxs = entry;
 }
 
@@ -160,6 +190,7 @@ void spu_coh_unregister(spu_context* ctx)
     for (spu_coh_entry** link = &s_coh_ctxs; *link; link = &(*link)->next) {
         if ((*link)->ctx != ctx) continue;
         spu_coh_entry* entry = *link;
+        spu_coh_unindex(entry);
         *link = entry->next;
         free(entry);
         break;
@@ -184,6 +215,7 @@ void spu_coh_forget_range(uintptr_t lo, uintptr_t hi)
             if (_n++ < 16)
                 fprintf(stderr, "[spu-coh] leaked ctx %p (img=%d) dropped at thread exit\n",
                         (void*)c, entry->ctx->image_id);
+            spu_coh_unindex(entry);
             *link = entry->next;
             free(entry);
         } else {
diff --git a/runtime/spu/tests/bench_spu_coh_reserve.c b/runtime/spu/tests/bench_spu_coh_reserve.c
new file mode 100644
index 0000000..1b8f73d
--- /dev/null
+++ b/runtime/spu/tests/bench_spu_coh_reserve.c
@@ -0,0 +1,42 @@
+/*
+ * Standalone reservation-registry microbenchmark (no guest data).
+ * Build from the toolkit root:
+ *   cc -O2 -std=gnu17 -Iinclude -Iruntime/spu \
+ *      runtime/spu/tests/bench_spu_coh_reserve.c -o /tmp/bench_spu_coh_reserve
+ *
+ * Reports CPU ns per real locked reserve call, round-robin across virtual
+ * contexts. No pass/fail timing threshold: run before/after on the same host.
+ * This isolates registry lookup, not game throughput or lock contention.
+ */
+#include "../spu_coherency.c"
+#include <time.h>
+
+void spu_ch_wake(spu_context* ctx) { (void)ctx; }
+
+int main(void)
+{
+    const unsigned sizes[] = {6, 64, 256};
+    const unsigned rounds = 8000;
+    for (unsigned s = 0; s < sizeof(sizes) / sizeof(sizes[0]); ++s) {
+        unsigned n = sizes[s];
+        spu_context* contexts = calloc(n, sizeof(*contexts));
+        if (!contexts) return 1;
+        for (unsigned i = 0; i < n; ++i) {
+            spu_lockline_lock();
+            spu_coh_reserve(&contexts[i], 0x10000);
+            spu_lockline_unlock();
+        }
+        clock_t start = clock();
+        for (unsigned r = 0; r < rounds; ++r)
+            for (unsigned i = 0; i < n; ++i) {
+                spu_lockline_lock();
+                spu_coh_reserve(&contexts[i], 0x10000);
+                spu_lockline_unlock();
+            }
+        double ns = (double)(clock() - start) * 1e9 / CLOCKS_PER_SEC / (rounds * n);
+        printf("contexts=%u reserve_cpu_ns=%.2f\n", n, ns);
+        for (unsigned i = 0; i < n; ++i) spu_coh_unregister(&contexts[i]);
+        free(contexts);
+    }
+    return 0;
+}
diff --git a/runtime/spu/tests/test_spu_coherency.c b/runtime/spu/tests/test_spu_coherency.c
index 5d74703..33b6593 100644
--- a/runtime/spu/tests/test_spu_coherency.c
+++ b/runtime/spu/tests/test_spu_coherency.c
@@ -419,6 +419,61 @@ static void test_many_contexts(void)
     spu_coh_unregister(&g_spu_a);
 }
 
+/* Exercise a registry index beyond its bucket count, then remove/re-register
+ * holders in a different order. Colliding context pointers must remain distinct
+ * and range cleanup must remove every index link before the memory is freed. */
+static void test_registry_churn(void)
+{
+    enum { N = 300 };
+    spu_context* c = calloc(N, sizeof(*c));
+    TEST("allocate virtual contexts for collision and lifetime coverage");
+    CHECK(c != NULL);
+    if (!c) return;
+
+    for (unsigned round = 0; round < 3; ++round) {
+        for (unsigned i = 0; i < N; ++i) {
+            c[i].event_status = 0;
+            /* Repeated registration must not create duplicate holder nodes. */
+            for (unsigned repeat = 0; repeat < 3; ++repeat)
+                spu_getllar(&c[i], (i & 1) ? LINE_A : LINE_B);
+        }
+        g_wakes = 0;
+        spu_lockline_lock();
+        spu_coh_notify_write_except(LINE_B + 16, &c[0]);
+        spu_lockline_unlock();
+        TEST("notify_except excludes self and unrelated lines amid collisions");
+        for (unsigned i = 0; i < N; ++i) {
+            int notified = i && !(i & 1);
+            CHECK(!!(c[i].event_status & SPU_EVENT_LR) == notified);
+            CHECK(!!c[i].resv_valid == !notified);
+        }
+        CHECK(g_wakes == N / 2 - 1);
+
+        /* Remove adjacent entries and re-register those same addresses. */
+        spu_coh_forget_range((uintptr_t)&c[N / 3], (uintptr_t)&c[2 * N / 3]);
+        g_wakes = 0;
+        vm_write32(LINE_A, 0);
+        TEST("range cleanup preserves colliding holders outside the range");
+        for (unsigned i = 1; i < N; i += 2) {
+            int removed = i >= N / 3 && i < 2 * N / 3;
+            CHECK(!!(c[i].event_status & SPU_EVENT_LR) == !removed);
+        }
+        CHECK(g_wakes == N / 3);
+        for (unsigned i = N; i-- > 0;) {
+            spu_coh_unregister(&c[i]);
+            spu_coh_unregister(&c[i]);
+        }
+        TEST("all repeated registrations were removed");
+        CHECK(s_coh_ctxs == NULL);
+    }
+    free(c);
+    g_wakes = 0;
+    vm_write32(LINE_A, 0);
+    vm_write32(LINE_B, 0);
+    TEST("no notifier dereferences holders after final free");
+    CHECK(g_wakes == 0);
+}
+
 /* ===========================================================================
  * main: run all and report
  * ===========================================================================*/
@@ -433,6 +488,7 @@ int main(void)
     spu_coh_unregister(&g_spu_a);
     spu_coh_unregister(&g_spu_b);
     test_many_contexts();
+    test_registry_churn();
 
     printf("\nSPU lock-line coherence tests: %d passed, %d failed\n",
            g_pass, g_fail);
-- 
