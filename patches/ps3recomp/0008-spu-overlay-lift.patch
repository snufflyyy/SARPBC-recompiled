+def is_overlay(segment):
+    """An overlay PT_LOAD has a load address (p_paddr) outside local store: the
+    SPU's overlay manager DMAs it in from main memory when needed (libovis
+    builds that image: cellOvis table + p_paddr). Resident segments carry
+    p_paddr == p_vaddr, or 0 from linkers that leave it unset."""
+    paddr = segment.get('paddr', segment['addr'])
+    return paddr != segment['addr'] and paddr >= LS_SIZE
+
+
+def spans_overlap(spans):
+    spans = sorted(spans)
+    return any(b > c for (_, b), (c, _) in zip(spans, spans[1:]))
+
