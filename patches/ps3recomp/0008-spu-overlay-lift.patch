+    def test_unreachable_extra_executable_segment_is_not_lifted(self):
+        # A second executable PT_LOAD (e.g. a 16-byte .SpuGUID) is scanned
+        # on its own and yields no function unless something branches into it.
+        result = self.run_pipeline(('input.bin', elf(7, multi=True)))
+        self.assertEqual(result.returncode, 0, result.stderr + result.stdout)
+        program = self.manifest()['programs'][0]
+        self.assertEqual(program['status'], 'registered')
+        self.assertEqual(program['diagnostics']['functions'], [[0x100, 0x108]])
+        self.assertNotIn('text_fingerprint', program)
+
+    def test_code_overlay_is_lifted_with_the_resident_text(self):
+        result = self.run_pipeline(('input.bin', overlay_elf()))
+        self.assertEqual(result.returncode, 0, result.stderr + result.stdout)
+        program = self.manifest()['programs'][0]
+        self.assertEqual(program['status'], 'registered')
+        # The overlay entry is a function of the same image; the inline
+        # constant (seeded by the `ila`) is not.
+        self.assertEqual(program['diagnostics']['functions'], [[0x100, 0x10C], [0x200, 0x208]])
+        self.assertEqual(program['executable_ranges'], [[0x100, 0x110], [0x200, 0x210]])
+        source = (self.output / program['name'] / 'spu_recomp.c').read_text()
+        self.assertNotIn('TODO spu', source)
+        # The lifter sees one local-store image with each segment in place.
+        code = (self.output / program['name'] / 'code.bin').read_bytes()
+        self.assertEqual(len(code), 0x110)
+        self.assertEqual(code[0x100:0x104], struct.pack('>I', 0x42010405))
+
+    def test_constant_inside_text_is_not_lifted(self):
+        # `ila $r5, <constant>` seeds the constant's address as a possible
+        # continuation; a word there that decodes as no instruction marks the
+        # range as data, so it is dropped instead of failing the whole image.
+        blob = bytearray(elf(7))
+        code = struct.pack('>IIII', 0x42008405, 0x35000000, 0x01000000, 0)  # ila $r5, 0x108
+        blob[0x100:0x108] = code[:8]
+        blob += code[8:]
+        struct.pack_into('>II', blob, 52 + 16, 16, 16)    # p_filesz, p_memsz
+        result = self.run_pipeline(('input.bin', bytes(blob)))
+        self.assertEqual(result.returncode, 0, result.stderr + result.stdout)
+        program = self.manifest()['programs'][0]
+        self.assertEqual(program['status'], 'registered')
+        self.assertEqual(program['diagnostics']['functions'], [[0x100, 0x108]])
+
+    def test_unsupported_overlay_layouts(self):
+        for blob, reason in [(overlay_elf(data_executable=True), 'overlapping executable PT_LOADs'),
+                             (overlay_elf(over_resident=True), 'overlay PT_LOAD overlaps a resident')]:
+            with self.subTest(reason=reason):
+                result = self.run_pipeline(('input.bin', blob))
+                self.assertNotEqual(result.returncode, 0)
+                program = self.manifest()['programs'][0]
+                self.assertEqual(program['status'], 'unsupported')
+                self.assertIn(reason, program['reason'])
+
