 def code_ranges(info):
     # The loader applies every PT_LOAD in header order, including zero filling.
     # Lifting a segment in isolation is unsafe if another load can replace its
-    # bytes. Treat any overlapping memory layout as unsupported until generation
-    # explicitly models the final deployed local store. Adjacent/empty loads
+    # bytes, so resident segments must not overlap. Overlays are the exception
+    # by design: they share a local-store range and the overlay manager makes
+    # one of them resident before using it. That stays liftable as long as at
+    # most one of the overlays at any address holds code -- the others are
+    # data (e.g. a scratch buffer reusing the code overlay's space), so each
+    # lifted address has exactly one instruction stream. Adjacent/empty loads
