     return bytes(data)
 
 
+def overlay_elf(*, data_executable=False, over_resident=False):
+    """Resident text at 0x100 that calls a code overlay at 0x200, plus a data
+    overlay sharing 0x200 (p_paddr outside LS marks both as overlays). The
+    code overlay keeps a constant inline, addressed by an `ila`, the way a
+    one-section overlay holds its own strings."""
+    text = struct.pack('>IIII', 0x42010405,            # ila  $r5, 0x208 (the constant)
+                       0x33001F80,                     # brsl $r0, 0x200 (into the overlay)
+                       0x35000000, 0)                  # bi   $r0
+    code = struct.pack('>IIII', 0x42010405, 0x35000000,   # ila $r5, 0x208; bi $r0
+                       0x01000000, 0)                  # constant: no valid instruction
+    data = bytearray(0x130)
+    ident = b'\x7fELF\x01\x02\x01' + b'\x00' * 9
+    data[:52] = struct.pack('>16sHHIIIIIHHHHHH', ident, 2, 23, 1, 0x100, 52, 0, 0, 52, 32, 3, 0, 0, 0)
+    vma = 0x100 if over_resident else 0x200
+    struct.pack_into('>IIIIIIII', data, 52, 1, 0x100, 0x100, 0x100, 16, 16, 5, 16)
+    struct.pack_into('>IIIIIIII', data, 84, 1, 0x110, vma, 0x40000, 16, 16, 7, 16)
+    struct.pack_into('>IIIIIIII', data, 116, 1, 0x120, vma, 0x40010, 16, 16,
+                     5 if data_executable else 6, 16)
+    data[0x100:0x110] = text
+    data[0x110:0x120] = code
+    return bytes(data)
+
