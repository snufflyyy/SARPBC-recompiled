     return ranges
 
 
+def detect_program_functions(blob, info, ranges):
+    """Function bounds plus the (code bytes, base) the lifter translates.
+
+    One executable segment: the detector's own view. Several (an overlay
+    image: resident .text plus a code overlay): detect per segment, seeding
+    each with the direct branch targets that other segments' code sections aim
+    into it (the resident code calls straight into the overlay once it has
+    made it resident), and hand the lifter one local-store image spanning
+    every executable segment, each at its own address.
+
+    Either way, a detected range whose executable part holds a word that
+    decodes as no instruction is data, not a function, and is dropped. Code
+    and constants often share one executable section (a one-section code
+    overlay; a .text with its literals linked in), and `ila $rN, <constant>`
+    or a constant that happens to decode as a branch then seeds a "function"
+    in the middle of strings or floats. A real function containing such a
+    word could not be lifted anyway, and a call into a dropped range still
+    fails the lift loudly ("direct branch/call targets lack ...")."""
+    from find_spu_functions import detect_functions, collect_branch_targets
+    from spu_disasm import disassemble_spu
+    executable = info['executable']
+
+    def in_ranges(address):
+        return any(s <= address < e for s, e in ranges)
+    targets, data_words = set(), set()
+    for x in executable:
+        insns = disassemble_spu(blob[x['off']:x['off'] + x['filesz']], base_addr=x['addr'])
+        data_words |= {i.addr for i in insns if i.mnemonic == '.word' and in_ranges(i.addr)}
+        targets |= {t for t in collect_branch_targets([i for i in insns if in_ranges(i.addr)])
+                    if in_ranges(t) and not x['addr'] <= t < x['addr'] + x['filesz']}
+
+    def code_only(found):
+        return [(s, e) for s, e in found if not any(a in data_words for a in range(s, e, 4))]
+    if len(executable) == 1:
+        functions, (offset, base, size) = detect_functions(blob, verbose=False)
+        return code_only(functions), blob[offset:offset + size], base
+    functions = []
+    for x in executable:
+        found, _ = detect_functions(blob, verbose=False, text=(x['off'], x['addr'], x['filesz']),
+                                    extra_seeds=targets,
+                                    fallback_seed=x['addr'] <= info['entry'] < x['addr'] + x['filesz'])
+        functions += code_only(found)
+    lo = min(x['addr'] for x in executable)
+    hi = max(x['addr'] + x['filesz'] for x in executable)
+    image = bytearray(hi - lo)
+    for x in executable:
+        image[x['addr'] - lo:x['addr'] - lo + x['filesz']] = blob[x['off']:x['off'] + x['filesz']]
+    return sorted(functions), bytes(image), lo
+
