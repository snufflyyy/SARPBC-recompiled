From 9e0badfc633e065a289d5984efa36e4c90b41e2e Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Tue, 20 Oct 2026 09:51:11 -0500
Subject: [PATCH] gcm: keep interrupt callbacks on their dedicated worker

With GCM_INTR_THREAD enabled, HLE callers could steal pending callbacks and block waiting for state their own suspended guest frame must publish. Leave work pending for the worker, keep manual delivery when no worker exists, and release failed-start event handles. Regressions cover affinity, FIFO ordering, exact-once delivery and mocked thread-start failure.
---
 libs/video/cellGcmSys.c              | 21 ++++++-
 tools/test_gcm_interrupt_affinity.py | 91 ++++++++++++++++++++++++++++
 2 files changed, 110 insertions(+), 2 deletions(-)
 create mode 100755 tools/test_gcm_interrupt_affinity.py

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index e12ec7f..3a37d33 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -749,6 +749,13 @@ void cellGcm_request_tick(void)
     gcm_intr_kick();
 }
 
+static HANDLE s_gcm_intr_ev = NULL;
+#if defined(_MSC_VER)
+static __declspec(thread) int s_gcm_on_intr_thread;
+#else
+static _Thread_local int s_gcm_on_intr_thread;
+#endif
+
 /* Deliver pending handlers on the calling host thread. Serialize the entire
  * claim-and-deliver sequence across threads: an HLE boundary and a host ticker
  * may both pump, and newer causes must not overtake already claimed callbacks.
@@ -756,6 +763,11 @@ void cellGcm_request_tick(void)
  * pending notifications untouched when another pump is active. */
 void ppu_gcm_pump(void)
 {
+    /* A dedicated interrupt worker owns delivery once started. An application
+     * thread must not steal a callback at an HLE boundary: the callback can
+     * wait for state that its suspended caller has not published yet. Keep
+     * work pending for the worker, or use the legacy path if startup failed. */
+    if (s_gcm_intr_ev && !s_gcm_on_intr_thread) return;
     /* Nothing pending -- the case at nearly every HLE call, from the game
      * thread and the render thread alike: no atomics, no lock. Three
      * interlocked operations and an SRW lock on a line both threads bounce
@@ -812,7 +824,6 @@ void ppu_gcm_pump(void)
  * Guest code then runs concurrently with the game's threads, as it does on the
  * console. Off by default: a title that relies on the handlers running
  * between its own HLE calls keeps the old behaviour. */
-static HANDLE s_gcm_intr_ev = NULL;
 #ifdef _WIN32
 static volatile LONG s_gcm_intr_started = 0;
 #define GCM_INTR_CLAIM() (InterlockedCompareExchange(&s_gcm_intr_started, 1, 0) == 0)
@@ -825,6 +836,7 @@ static int gcm_intr_claim(void) { int z = 0; return atomic_compare_exchange_stro
 static DWORD WINAPI gcm_intr_thread(LPVOID unused)
 {
     (void)unused;
+    s_gcm_on_intr_thread = 1;
     for (;;) {
         /* The timeout is a backstop for a kick that raced the wait. */
         WaitForSingleObject(s_gcm_intr_ev, 2);
@@ -846,10 +858,15 @@ static void gcm_intr_start(void)
 {
     if (!gcm_intr_enabled() || !GCM_INTR_CLAIM()) return;
     s_gcm_intr_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
-    if (!s_gcm_intr_ev || !CreateThread(NULL, 1u << 20, gcm_intr_thread, NULL, 0, NULL)) {
+    HANDLE thread = s_gcm_intr_ev
+        ? CreateThread(NULL, 1u << 20, gcm_intr_thread, NULL, 0, NULL) : NULL;
+    if (!thread) {
+        if (s_gcm_intr_ev) CloseHandle(s_gcm_intr_ev);
+        s_gcm_intr_ev = NULL; /* HLE-boundary delivery remains available. */
         fprintf(stderr, "[cellGcmSys] GCM_INTR_THREAD: could not start the interrupt thread\n");
         return;
     }
+    CloseHandle(thread); /* the process-lifetime worker does not need a join handle */
     fprintf(stderr, "[cellGcmSys] GCM_INTR_THREAD: handlers are delivered on an interrupt thread\n");
 }
 
diff --git a/tools/test_gcm_interrupt_affinity.py b/tools/test_gcm_interrupt_affinity.py
new file mode 100755
index 0000000..683ff46
--- /dev/null
+++ b/tools/test_gcm_interrupt_affinity.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""A live GCM interrupt worker owns handler delivery; HLE callers cannot steal it."""
+import os
+from pathlib import Path
+import platform
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+if os.name == 'nt':
+    print('SKIP: standalone fixture requires POSIX linking')
+    raise SystemExit(0)
+
+FIXTURE = r'''
+#include "libs/video/cellGcmSys.c"
+uint8_t* vm_base;
+uint32_t g_ww_lo, g_ww_hi;
+int g_resv_store_active;
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+ps3_guest_caller_fn g_ps3_guest_caller;
+BOOL SetEvent(HANDLE h) { (void)h; return TRUE; }
+static unsigned closed;
+HANDLE CreateEventA(void* sa,BOOL manual,BOOL initial,LPCSTR name) {
+    (void)sa;(void)manual;(void)initial;(void)name; return (HANDLE)(uintptr_t)1;
+}
+HANDLE CreateThread(void* sa,SIZE_T stack,PS3_THREAD_FN fn,LPVOID arg,DWORD flags,DWORD* tid) {
+    (void)sa;(void)stack;(void)fn;(void)arg;(void)flags;(void)tid; return NULL;
+}
+DWORD WaitForSingleObject(HANDLE h,DWORD ms) {(void)h;(void)ms;return WAIT_TIMEOUT;}
+BOOL CloseHandle(HANDLE h) {(void)h;closed++;return TRUE;}
+void ps3_ww_report_inline(uint32_t a,uint64_t v,int w) {(void)a;(void)v;(void)w;abort();}
+void ppu_resv_break_store(uint64_t a) {(void)a;abort();}
+int spu_coh_is_reserved(uint32_t a) {(void)a;return 0;}
+void spu_coh_notify_write(uint32_t a) {(void)a;abort();}
+void spu_lockline_lock(void) {abort();}
+void spu_lockline_unlock(void) {abort();}
+static unsigned calls;
+static uint64_t values[4];
+static void caller(uint32_t opd,uint64_t a,uint64_t b,uint64_t c,uint64_t d,
+                       uint64_t e,uint64_t f,uint64_t g,uint64_t h) {
+    (void)b;(void)c;(void)d;(void)e;(void)f;(void)g;(void)h;
+    if (opd!=0x100 || calls>=4) abort();
+    values[calls++]=a;
+}
+static void check(int ok,const char* msg) {
+    if (!ok) { fprintf(stderr,"FAIL: %s\n",msg); exit(1); }
+}
+int main(void) {
+    vm_base=calloc(1,0x1000); check(vm_base!=NULL,"allocate synthetic VM");
+    g_ps3_guest_caller=caller; s_user_handler_opd=0x100;
+    // Model a worker that has been published but has not run yet.
+    s_gcm_intr_ev=(HANDLE)(uintptr_t)1;
+    cellGcmQueueUserCommand(11); cellGcmQueueUserCommand(12);
+    GCM_PENDING_SET(3); s_flip_status=CELL_GCM_FLIP_STATUS_WAITING;
+    ppu_gcm_pump();
+    check(calls==0,"render-thread HLE boundary must not run interrupt callbacks");
+    check(GCM_PENDING_PEEK(),"foreign pump leaves tick pending");
+    check(s_flip_status==CELL_GCM_FLIP_STATUS_WAITING,"foreign pump cannot complete a flip");
+    check(s_user_qhead!=s_user_qtail,"foreign pump leaves FIFO user commands pending");
+    s_gcm_on_intr_thread=1;
+    ppu_gcm_pump();
+    check(calls==2 && values[0]==11 && values[1]==12,"worker preserves command FIFO order");
+    check(!GCM_PENDING_PEEK(),"worker consumes tick");
+    check(s_flip_status==CELL_GCM_FLIP_STATUS_DONE,"worker completes requested flip");
+    s_gcm_on_intr_thread=0;
+    cellGcmQueueUserCommand(13); ppu_gcm_pump();
+    check(calls==2,"foreign caller still cannot steal next command");
+    // With no worker, keep the legacy/manual path, including failed startup.
+    s_gcm_intr_ev=NULL;
+    ppu_gcm_pump(); check(calls==3 && values[2]==13,"fallback drains pending command");
+    ppu_gcm_pump(); check(calls==3,"callbacks delivered exactly once");
+    cellGcmQueueUserCommand(14);
+    gcm_intr_start(); // mocked CreateThread fails after event creation
+    check(s_gcm_intr_ev==NULL && closed==1,"failed startup clears and closes worker event");
+    ppu_gcm_pump(); check(calls==4 && values[3]==14,"failed startup retains manual delivery");
+    free(vm_base);
+    puts("PASS: GCM interrupt affinity, pending work retention, manual/startup-failure fallback");
+}
+'''
+
+with tempfile.TemporaryDirectory(prefix='gcm-interrupt-affinity-') as name:
+    root = Path(name)
+    src = root / 'fixture.c'
+    src.write_text(FIXTURE)
+    exe = root / 'fixture'
+    linker = ['-Wl,-dead_strip'] if platform.system() == 'Darwin' else ['-Wl,--gc-sections']
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-D_GNU_SOURCE', '-O1', '-UNDEBUG',
+                    '-ffunction-sections', '-fdata-sections', '-I' + str(ROOT),
+                    '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'runtime/spu'),
+                    str(src), *linker, '-pthread', '-lm', '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True, timeout=10, env=dict(os.environ, GCM_INTR_THREAD='1'))
-- 
2.55.0

