From 71fec18a9e05b2a3d2b2b0b22fb3120e65ea4933 Mon Sep 17 00:00:00 2001
From: pi <pi@localhost>
Date: Wed, 21 Oct 2026 02:53:56 +0000
Subject: [PATCH] fix(spurs): serialize taskset bitset lifecycle updates

Prevent stale SPU reservations and PPU read/modify/write publication from restoring completed task bits and generating duplicate task completions. Reserve pending work under the shared lock, invalidate peers, then dispatch outside the guest lock.

Preserve BE layout, write-watch and PPU reservation hooks. Extend the synthetic tagged-ELF fixture with real reservation tracking and deterministic publication interleavings across all 128 task bits: 419 checks pass, including ASan/UBSan.
---
 libs/spurs/spurs_taskset.h                    |  31 +++--
 runtime/spu/spu_workload.c                    |  26 +++-
 .../spu/tests/test_spu_taskset_elf_flags.c    | 118 +++++++++++++++++-
 tools/test_spu_taskset_elf_flags.py           |   8 +-
 4 files changed, 162 insertions(+), 21 deletions(-)

diff --git a/libs/spurs/spurs_taskset.h b/libs/spurs/spurs_taskset.h
index 144245d..a40615c 100644
--- a/libs/spurs/spurs_taskset.h
+++ b/libs/spurs/spurs_taskset.h
@@ -9,10 +9,10 @@
  * exactly why our prior HLE (which memset/native-wrote simplified structs) left the
  * SPU reading zeros/garbage (docs/12 root cause).
  *
- * RULE: access taskset/context fields ONLY via the BE accessors vm_read32/vm_read64/
- * vm_write32/vm_write64 (ppu_loader.cpp -- they byte-swap), at guest_EA + the offset
- * constants below. The offsets are the source of truth (reimplemented clean from the
- * public SDK / RPCS3 cellSpurs.h contracts; no GPL code copied).
+ * RULE: access taskset/context fields via the BE accessors vm_read32/vm_read64/
+ * vm_write32/vm_write64 or the lock-protected BE bitset updater below, at guest_EA
+ * + the offset constants below. The offsets are the source of truth (reimplemented
+ * clean from the public SDK / RPCS3 cellSpurs.h contracts; no GPL code copied).
  * ===========================================================================
  */
 #ifndef SPURS_TASKSET_H
@@ -76,18 +76,27 @@ static inline uint32_t spurs_taskset_taskinfo_ea(uint32_t taskset_ea, uint32_t t
 
 /* set/clear/test a task bit in a 128-bit bitset (bit 0 = MSB of word 0, per RPCS3
  * atomic_tasks_bitset::get_bit). bitset_ea = taskset_ea + CSTS_READY etc. */
-static inline void spurs_bitset_set(uint32_t bitset_ea, uint32_t taskId)
+static inline void spurs_bitset_update(uint32_t bitset_ea, uint32_t taskId, int set)
 {
     uint32_t word_ea = bitset_ea + (taskId / 32) * 4;
     uint32_t mask = (1u << 31) >> (taskId % 32);
-    vm_write32(word_ea, vm_read32(word_ea) | mask);
+    /* Lock the read AND write: a separately coherent vm_write32 can still
+     * restore a peer's completed bit from the earlier, stale vm_read32. */
+    spu_lockline_lock();
+    uint32_t value = vm_read32(word_ea);
+    value = set ? value | mask : value & ~mask;
+    uint32_t raw = ps3_bswap32(value);
+    /* vm_write32 would acquire the same non-recursive lock a second time. */
+    memcpy(vm_ptr8(word_ea), &raw, sizeof(raw));
+    spu_coh_notify_write(word_ea);
+    spu_lockline_unlock();
+    PS3_WW_CHECK(word_ea, value, 4);
+    if (g_resv_store_active > 0) ppu_resv_break_store(word_ea);
 }
+static inline void spurs_bitset_set(uint32_t bitset_ea, uint32_t taskId)
+{ spurs_bitset_update(bitset_ea, taskId, 1); }
 static inline void spurs_bitset_clear(uint32_t bitset_ea, uint32_t taskId)
-{
-    uint32_t word_ea = bitset_ea + (taskId / 32) * 4;
-    uint32_t mask = (1u << 31) >> (taskId % 32);
-    vm_write32(word_ea, vm_read32(word_ea) & ~mask);
-}
+{ spurs_bitset_update(bitset_ea, taskId, 0); }
 static inline int spurs_bitset_test(uint32_t bitset_ea, uint32_t taskId)
 {
     uint32_t word_ea = bitset_ea + (taskId / 32) * 4;
diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index 4db2436..69c2c6b 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -12,6 +12,7 @@
 #define _GNU_SOURCE 1
 #endif
 #include "spu_workload.h"
+#include "spu_coherency.h"
 #include "spu_lifted_job.h"   /* spu_run_lifted_job */
 #include "../ps3_log.h"      /* ps3_log_verbose */
 #include <stdio.h>
@@ -403,7 +404,14 @@ static void spu_taskset_task_exited(uint32_t taskset_ea, uint32_t done_task)
 {
     extern uint8_t* vm_base;
     extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    struct queued_task { uint32_t task, elf, context, size; } queued[128];
+    unsigned nqueued = 0;
     ts_lock();
+    /* The host running bitmap alone cannot protect guest bitsets: a peer's
+     * GETLLAR snapshot can otherwise PUTLLC the old ready/enabled bits back
+     * after exit and make this scheduler execute the completed task twice.
+     * Publish lifecycle changes as one coherent transaction, like the SPU. */
+    spu_lockline_lock();
     uint8_t* ts = vm_base + taskset_ea;
     uint8_t* run = ts_running(taskset_ea);
     if (done_task < 128) {
@@ -430,12 +438,20 @@ static void spu_taskset_task_exited(uint32_t taskset_ea, uint32_t done_task)
         if (!sz) continue;
         ts[0x20 + t / 8] &= (uint8_t)~m;                 /* pending -> started */
         run[t / 8] |= m;
+        queued[nqueued++] = (struct queued_task){ t, elf, ctx, (uint32_t)sz };
+    }
+    spu_coh_notify_write(taskset_ea);
+    spu_lockline_unlock();
+    /* Dispatch may allocate/build contexts and acquire the lock-line lock.
+     * Keep host slot ownership, but never hold the guest lock across it. */
+    for (unsigned i = 0; i < nqueued; i++) {
+        const struct queued_task* q = &queued[i];
         fprintf(stderr, "[taskset] start task %u of taskset 0x%08X elf=0x%08X "
-                        "(after task %u exited)\n", t, taskset_ea, elf, done_task);
-        g_ydkj_real_taskset_ea = taskset_ea; g_ydkj_real_taskid = t;
-        if (!spu_workload_dispatch_task_async(vm_base + elf, (uint32_t)sz, ctx,
-                                              taskset_ea, t))
-            run[t / 8] &= (uint8_t)~m;                   /* nothing runs it */
+                        "(after task %u exited)\n", q->task, taskset_ea, q->elf, done_task);
+        g_ydkj_real_taskset_ea = taskset_ea; g_ydkj_real_taskid = q->task;
+        if (!spu_workload_dispatch_task_async(vm_base + q->elf, q->size, q->context,
+                                              taskset_ea, q->task))
+            run[q->task / 8] &= (uint8_t)~(0x80u >> (q->task & 7));
     }
     ts_unlock();
 }
diff --git a/runtime/spu/tests/test_spu_taskset_elf_flags.c b/runtime/spu/tests/test_spu_taskset_elf_flags.c
index b50bc6a..e36f4f5 100644
--- a/runtime/spu/tests/test_spu_taskset_elf_flags.c
+++ b/runtime/spu/tests/test_spu_taskset_elf_flags.c
@@ -1,11 +1,58 @@
 /* Synthetic taskset requeue boundary. The driver inserts the unchanged production
- * ELF parser and scheduler functions; only host dispatch is intercepted so no
- * SPU thread or original title image is required. */
+ * ELF parser and scheduler functions and links real reservation tracking. Host
+ * dispatch and deterministic interleaving hooks replace physical threads; no
+ * original title image is required. */
 #include <stdint.h>
 #include <stddef.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include "spu_context.h"
+#include "spu_coherency.h"
+#include "../ppu/ppu_memory.h"
+/* Observe the ordinary PPU store hooks without running a PPU thread. */
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+static unsigned reservation_breaks, write_watches;
+static uint64_t broken_ea, watched_value;
+static uint32_t watched_ea;
+static int watched_width;
+void ppu_resv_break_store(uint64_t ea) { reservation_breaks++; broken_ea = ea; }
+void ps3_ww_report_inline(uint32_t ea, uint64_t value, int width)
+{ write_watches++; watched_ea = ea; watched_value = value; watched_width = width; }
+/* Schedule a peer exit precisely between a publisher's load and store when
+ * the production bitset helper does not hold the common lock-line lock. */
+static uint32_t probe_word, peer_mask;
+static int probe_armed, peer_applied, publication_locked;
+static unsigned unlocked_notifications;
+static void peer_exit(void)
+{
+    vm_write32(probe_word, vm_read32(probe_word) & ~peer_mask);
+    peer_applied = 1;
+}
+static uint32_t observed_read32(uint32_t addr)
+{
+    uint32_t value = vm_read32(addr);
+    if (probe_armed && addr == probe_word && !publication_locked) peer_exit();
+    return value;
+}
+static void publication_lock(void) { spu_lockline_lock(); publication_locked = 1; }
+static void publication_unlock(void) { publication_locked = 0; spu_lockline_unlock(); }
+static void publication_notify(uint32_t addr)
+{
+    if (!publication_locked) unlocked_notifications++;
+    spu_coh_notify_write(addr);
+}
+#define vm_read32 observed_read32
+#define spu_lockline_lock publication_lock
+#define spu_lockline_unlock publication_unlock
+#define spu_coh_notify_write publication_notify
+#include "spurs_taskset.h"
+#undef vm_read32
+#undef spu_lockline_lock
+#undef spu_lockline_unlock
+#undef spu_coh_notify_write
+void spu_ch_wake(spu_context* ctx) { (void)ctx; }
 typedef int32_t LONG;
 static LONG InterlockedExchange(volatile LONG* value, LONG replacement)
 { LONG old = *value; *value = replacement; return old; }
@@ -18,6 +65,10 @@ static uint32_t dispatched_size, dispatched_context, dispatched_taskset, dispatc
 static int spu_workload_dispatch_task_async(const uint8_t* image, uint32_t size, uint32_t context,
                                             uint32_t taskset_ea, uint32_t taskid)
 {
+    /* Dispatch can allocate/build a context which uses the lock-line lock.
+     * Taking it here proves the scheduler releases it before dispatching. */
+    spu_lockline_lock();
+    spu_lockline_unlock();
     dispatches++; dispatched_image = image; dispatched_size = size;
     dispatched_context = context; dispatched_taskset = taskset_ea; dispatched_task = taskid;
     return 1;
@@ -95,7 +146,68 @@ int main(void)
     CHECK(vm_base[TASKSET + 0x10] == 0 && vm_base[TASKSET + 0x20] == 0 &&
           vm_base[TASKSET + 0x30] == 0 && s_ts_run[0].running[0] == 0,
           "real exiting task ready/pending/enabled/run state is cleared");
+    /* A peer took GETLLAR before this task exited. Its later PUTLLC must
+     * fail, rather than restore the old ready/enabled bits and run it twice. */
+    setup(1, 0); ts_running(TASKSET)[0] = 0x80;
+    spu_context peer = {0};
+    uint8_t snapshot[128];
+    peer.resv_ea = TASKSET; peer.resv_valid = 1;
+    spu_lockline_lock();
+    spu_coh_reserve(&peer, TASKSET);
+    memcpy(snapshot, vm_base + TASKSET, sizeof(snapshot));
+    spu_lockline_unlock();
+    spu_taskset_task_exited(TASKSET, 0);
+    CHECK(!peer.resv_valid, "task exit invalidates the peer's pre-exit reservation");
+    /* Model PUTLLC's reservation gate, using the real coherence registry. */
+    if (peer.resv_valid) memcpy(vm_base + TASKSET, snapshot, sizeof(snapshot));
+    spu_taskset_task_exited(TASKSET, 127);
+    CHECK(dispatches == 0, "a stale peer snapshot cannot resurrect the completed task");
+    spu_coh_unregister(&peer);
+
+    setup(1, 1);
+    peer.resv_ea = TASKSET; peer.resv_valid = 1;
+    spu_lockline_lock(); spu_coh_reserve(&peer, TASKSET); spu_lockline_unlock();
+    spu_taskset_task_exited(TASKSET, 127);
+    CHECK(!peer.resv_valid, "pending-to-started publication invalidates a peer snapshot");
+    CHECK(dispatches == 1, "coherent publication still dispatches enabled pending work");
+    spu_coh_unregister(&peer);
+
+    setup(1, 0); ts_running(TASKSET)[0] = 0x80;
+    peer.resv_ea = TASKSET + 128; peer.resv_valid = 1;
+    spu_lockline_lock(); spu_coh_reserve(&peer, TASKSET + 128); spu_lockline_unlock();
+    spu_taskset_task_exited(TASKSET, 0);
+    CHECK(peer.resv_valid, "exit preserves reservations on unrelated lines");
+    spu_coh_unregister(&peer);
+    for (uint32_t task = 0; task < 128; task++) for (int set = 0; set < 2; set++) {
+        setup(1, 0);
+        probe_word = TASKSET + CSTS_ENABLED + (task / 32) * 4;
+        uint32_t own_mask = 0x80000000u >> (task % 32);
+        peer_mask = 0x80000000u >> ((task + 1) % 32);
+        vm_write32(probe_word, peer_mask | (set ? 0 : own_mask));
+        probe_armed = 1; peer_applied = 0;
+        if (set) spurs_bitset_set(TASKSET + CSTS_ENABLED, task);
+        else spurs_bitset_clear(TASKSET + CSTS_ENABLED, task);
+        probe_armed = 0;
+        /* A locked publisher precedes exit; an unlocked one was interrupted. */
+        if (!peer_applied) peer_exit();
+        CHECK(vm_read32(probe_word) == (set ? own_mask : 0),
+              "bitset RMW cannot restore a completed peer's bit");
+    }
+    CHECK(unlocked_notifications == 0, "bitset invalidations occur inside the shared lock");
+    setup(1, 0);
+    g_resv_store_active = 1;
+    g_ww_lo = TASKSET + CSTS_ENABLED + 12; g_ww_hi = g_ww_lo + 4;
+    spurs_bitset_set(TASKSET + CSTS_ENABLED, 127);
+    CHECK(reservation_breaks == 1 && broken_ea == g_ww_lo,
+          "locked set preserves the ordinary PPU reservation-break hook");
+    CHECK(write_watches == 1 && watched_ea == g_ww_lo &&
+          watched_value == 1 && watched_width == 4,
+          "locked set preserves the write-watch address, value and width");
+    spurs_bitset_clear(TASKSET + CSTS_ENABLED, 127);
+    CHECK(reservation_breaks == 2 && write_watches == 2 && watched_value == 0,
+          "locked clear preserves both ordinary PPU store hooks");
+    g_resv_store_active = 0; g_ww_lo = g_ww_hi = 0;
     free(vm_base);
-    printf("taskset ELF address flags: %u passed, %u failed\n", passed, failed);
+    printf("taskset ELF flags and coherent exit: %u passed, %u failed\n", passed, failed);
     return failed ? 1 : 0;
 }
