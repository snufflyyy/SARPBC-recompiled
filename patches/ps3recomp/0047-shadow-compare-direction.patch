From d52438f590d2f631841cd9467f2c01621e4a5981 Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Tue, 20 Oct 2026 17:24:10 +0000
Subject: [PATCH] fp decompiler: depth texture compares are 'depth OP
 reference'

RSX compares the stored depth against the reference, the reverse of
ARB_shadow's 'reference OP depth' that 4033da8 used. Supersonic Acrobatic
Rocket-Powered Battle-Cars draws its car shadow map normal-Z (cleared to
1.0, LEQUAL) and projects it with zfunc GEQUAL. Read the ARB_shadow way,
every fragment in front of the far plane failed, so the whole shadow
frustum came out as a dark square on the floor; read this way only what
the car occludes is shadowed, and the square is gone (checked A/B in the
same scene).

The helper's comparisons, SHADOW_COMPARISON.md and the Metal GPU test's
expected values change direction; test_shadow_metadata and
test_shadow_engine pass unchanged (they check helper emission, not
direction). The Metal test was not run (Linux).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/SHADOW_COMPARISON.md                    |  8 ++++++--
 libs/video/rsx_fp_decompiler.c               | 12 +++++++++---
 libs/video/tests/test_shadow_compare_metal.m |  2 +-
 3 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/docs/SHADOW_COMPARISON.md b/docs/SHADOW_COMPARISON.md
index df98ec6..f28e303 100644
--- a/docs/SHADOW_COMPARISON.md
+++ b/docs/SHADOW_COMPARISON.md
@@ -7,8 +7,12 @@ non-depth textures and alpha-kill keep the existing raw sampling behavior.
 
 TEX compares source z with stored red-channel depth. TXP divides xyz by w
 before comparison. The reference is clamped to [0,1], and the scalar comparison
-is replicated into all four lanes. Comparisons are reference <, ==, <=, >, !=,
-and >= stored depth in control order. Linear sampling compares four texel
+is replicated into all four lanes. Comparisons are stored depth <, ==, <=, >,
+!=, and >= the reference in control order: RSX compares the texel against the
+reference, the reverse of ARB_shadow. A title's normal-Z shadow map (cleared to
+1.0, drawn LEQUAL) projected with zfunc GEQUAL must leave unoccluded fragments
+lit; the ARB_shadow reading shadowed the whole shadow frustum instead
+(Supersonic Acrobatic Rocket-Powered Battle-Cars' car shadow, 2026-10-20). Linear sampling compares four texel
 centers separately before interpolating visibility; it does not compare a
 filtered depth value. The existing sampler supplies address/border behavior.
 
diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index d137820..cebd2a1 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -482,9 +482,15 @@ static void fp_shadow_helper(Out* p, u32 unit, u32 cube_mask,
 {
     char tex[32], text[4096];
     snprintf(tex, sizeof tex, cube_mask ? "rsx_tex%u" : "rsx_tex[%u]", unit);
-    const char* cmp[] = { "0.0", "reference < depth", "reference == depth",
-        "reference <= depth", "reference > depth", "reference != depth",
-        "reference >= depth", "1.0" };
+    /* RSX compares the stored depth against the reference -- "depth OP
+     * reference", the reverse of ARB_shadow's "reference OP depth". SARPBC's
+     * car shadow settles it: its map is cleared to 1.0 and drawn LEQUAL, and
+     * the projection uses GEQUAL; read the ARB_shadow way, every floor
+     * fragment in front of the far plane (reference < 1.0) came out
+     * shadowed, a dark square the size of the shadow frustum. */
+    const char* cmp[] = { "0.0", "depth < reference", "depth == reference",
+        "depth <= reference", "depth > reference", "depth != reference",
+        "depth >= reference", "1.0" };
     snprintf(text, sizeof text,
         "float _rsx_shadow_cmp%u(float reference, float depth) { return (float)(%s); }\n"
         "float4 _rsx_shadow%u(float3 coordinate) {\n"
diff --git a/libs/video/tests/test_shadow_compare_metal.m b/libs/video/tests/test_shadow_compare_metal.m
index 8844a8a..d4d2a64 100644
--- a/libs/video/tests/test_shadow_compare_metal.m
+++ b/libs/video/tests/test_shadow_compare_metal.m
@@ -7,7 +7,7 @@ u8* vm_base;
 u32 cellGcmResolveLocated(int local,u32 off){(void)local;return off;}
 static int checks,failures;
 #define CHECK(c,n) do{checks++;if(!(c)){failures++;fprintf(stderr,"FAIL %s\n",n);}}while(0)
-static float expected(unsigned mode,float ref,float d){switch(mode){case 1:return ref<d;case 2:return ref==d;case 3:return ref<=d;case 4:return ref>d;case 5:return ref!=d;case 6:return ref>=d;default:return d;}}
+static float expected(unsigned mode,float ref,float d){switch(mode){case 1:return d<ref;case 2:return d==ref;case 3:return d<=ref;case 4:return d>ref;case 5:return d!=ref;case 6:return d>=ref;default:return d;}}
 int main(void){@autoreleasepool{
  s_dev=MTLCreateSystemDefaultDevice();if(!s_dev)return 2;s_queue=[s_dev newCommandQueue];vm_base=calloc(1,4096);
  rsx_test_fp_instr(vm_base+256,RSX_TEST_FP_OPC(0x18)|RSX_TEST_FP_MASK_XYZW|RSX_TEST_FP_INSRC_TC0|RSX_TEST_FP_END,RSX_TEST_FP_SRC_INPUT|RSX_TEST_FP_SWZ_IDENT);
