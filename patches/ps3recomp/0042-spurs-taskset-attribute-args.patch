From 98acda142b8db34f3626b6274b1dce7f4817619b Mon Sep 17 00:00:00 2001
From: Braden <snufflyy@proton.me>
Date: Tue, 20 Oct 2026 09:14:22 -0500
Subject: [PATCH] spurs: keep the taskset argument from the taskset attribute

_cellSpursTasksetAttributeInitialize dropped argTaskset (and the priority
table) and cellSpursCreateTasksetWithAttribute created the taskset with
args = 0. The policy hands the taskset argument to every task in r4, so
a title that builds its taskset from an attribute ran all of its tasks
with a zero argument. SARPBC's PhysX collision tasks use its low word as
their shared work-pool EA: they spun on GETLLAR of EA 0 forever and the
PPU physics thread waited on their SPURS queue when an arena loaded.

Store the argument and priorities in the attribute, pass them through,
log the argument at creation, and extend the taskset fixture test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/spurs/cellSpurs.c           | 13 ++++++++++---
 tools/test_spurs_taskset_size.py | 12 +++++++++++-
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index f3696bb..d67c594 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -915,7 +915,8 @@ static s32 spurs_create_taskset(CellSpurs* spurs, CellSpursTaskset* taskset,
     g_ydkj_real_taskset_ea = taskset_ea;
 
     g_ydkj_real_spurs_ea = spurs_ea;   /* capture for the taskset-policy handoff (LS[0x1C0]) */
-    printf("[cellSpurs] CreateTaskset() ea=0x%08X spurs=0x%08X (real BE layout)\n", taskset_ea, spurs_ea);
+    printf("[cellSpurs] CreateTaskset() ea=0x%08X spurs=0x%08X args=0x%llX (real BE layout)\n",
+           taskset_ea, spurs_ea, (unsigned long long)args);
     return CELL_OK;
 }
 
@@ -937,7 +938,7 @@ s32 cellSpursCreateTasksetWithAttribute(CellSpurs* spurs,
     const CellSpursTasksetAttribute* attr_h = GUEST_PTR(attr, const CellSpursTasksetAttribute*);
     u32 size = attr_h->tasksetSize;
     if (size != 0x1900u && size != 0x2900u) return (s32)0x80410902u;
-    return spurs_create_taskset(spurs, taskset, 0, NULL, 0, size);
+    return spurs_create_taskset(spurs, taskset, attr_h->args, attr_h->priority, 0, size);
 }
 
 s32 cellSpursDestroyTaskset(CellSpursTaskset* taskset)
@@ -1301,12 +1302,18 @@ s32 _cellSpursTasksetAttributeInitialize(CellSpursTasksetAttribute* attr,
                                          u32 revision, u32 sdkVersion, u64 argTaskset,
                                          u64 priority, u32 maxContention)
 {
-    (void)sdkVersion; (void)argTaskset; (void)priority; (void)maxContention;
+    (void)sdkVersion; (void)maxContention;
     if (!attr) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
     attr = GUEST_PTR(attr, CellSpursTasksetAttribute*);
     memset(attr, 0, sizeof(CellSpursTasksetAttribute));
     attr->revision = revision ? revision : 1;
     attr->tasksetSize = CSTS_STRUCT_END;
+    /* The policy passes the taskset argument to each task in r4. Preserve it
+     * until CreateTasksetWithAttribute so tasks receive their shared context.
+     * priority is the u8[8] per-SPU table packed big-endian in a u64. */
+    attr->args = argTaskset;
+    for (int i = 0; i < CELL_SPURS_MAX_SPU; i++)
+        attr->priority[i] = (u8)(priority >> (56 - 8 * i));
     printf("[cellSpurs] _TasksetAttributeInitialize(rev=%u)\n", revision);
     return CELL_OK;
 }
diff --git a/tools/test_spurs_taskset_size.py b/tools/test_spurs_taskset_size.py
index d7f11d6..aab2b0b 100644
--- a/tools/test_spurs_taskset_size.py
+++ b/tools/test_spurs_taskset_size.py
@@ -68,7 +68,17 @@ int main(void) {
     expect(cellSpursCreateTaskset(spurs,ts,0,NULL,0)==0,"plain creation");
     expect(vm_read32(0x4000+CSTS_SIZE_FIELD)==0x1900,"plain creation uses full default guest size");
     clean(0x1900);
-    puts("PASS: real taskset requested-size retention and initialization");
+    expect(_cellSpursTasksetAttributeInitialize(attr,1,0,0x1234567841D09780ull,0x0102030405060708ull,8)==0,"attribute init with argument");
+    const CellSpursTasksetAttribute* host_attr = (const CellSpursTasksetAttribute*)(memory+0x2000);
+    for (unsigned i=0;i<CELL_SPURS_MAX_SPU;i++)
+        expect(host_attr->priority[i]==i+1,"attribute retains priority byte order");
+    expect(cellSpursCreateTasksetWithAttribute(spurs,ts,attr)==0,"creation with argument");
+    expect(vm_read32(0x4000+CSTS_ARGS)==0x12345678u && vm_read32(0x4000+CSTS_ARGS+4)==0x41D09780u,
+           "attribute's taskset argument reaches the guest header");
+    expect(cellSpursCreateTaskset(spurs,ts,0x123456789ull,NULL,0)==0 &&
+           vm_read32(0x4000+CSTS_ARGS)==1 && vm_read32(0x4000+CSTS_ARGS+4)==0x23456789u,
+           "plain creation stores its argument");
+    puts("PASS: real taskset requested-size retention, argument and initialization");
 }
 '''
 with tempfile.TemporaryDirectory(prefix='spurs-taskset-size-') as name:
-- 
