diff --git a/runtime/platform/win32_compat.h b/runtime/platform/win32_compat.h
index 30538f1..f6e7d90 100644
--- a/runtime/platform/win32_compat.h
+++ b/runtime/platform/win32_compat.h
@@ -459,7 +459,15 @@ typedef void*  SRWLOCK;
 typedef SRWLOCK* PSRWLOCK;
 #define SRWLOCK_INIT NULL
 
-static inline void ps3__rwl_init(void* p) { pthread_rwlock_init((pthread_rwlock_t*)p, NULL); }
+static inline void ps3__rwl_init(void* p) {
+#ifdef __GLIBC__
+    pthread_rwlockattr_t a; pthread_rwlockattr_init(&a);
+    pthread_rwlockattr_setkind_np(&a, PTHREAD_RWLOCK_PREFER_WRITER_NONRECURSIVE_NP);
+    pthread_rwlock_init((pthread_rwlock_t*)p, &a); pthread_rwlockattr_destroy(&a);
+#else
+    pthread_rwlock_init((pthread_rwlock_t*)p, NULL);
+#endif
+}
 static inline pthread_rwlock_t* ps3_srw(SRWLOCK* l)
 { return (pthread_rwlock_t*)ps3_lazy_obj((void**)l, sizeof(pthread_rwlock_t), ps3__rwl_init); }
 
